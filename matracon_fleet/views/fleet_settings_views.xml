<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── x.fleet.mppl.prefix list view ─────────────────────────────────── -->
    <record id="view_fleet_mppl_prefix_list" model="ir.ui.view">
        <field name="name">x.fleet.mppl.prefix.list</field>
        <field name="model">x.fleet.mppl.prefix</field>
        <field name="arch" type="xml">
            <list string="MPPL Prefix Codes" editable="top">
                <field name="name"/>
                <field name="prefix_code"/>
                <field name="next_sequence" string="Next Seq #"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_fleet_mppl_prefix" model="ir.actions.act_window">
        <field name="name">MPPL Prefix Codes</field>
        <field name="res_model">x.fleet.mppl.prefix</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── x.fleet.settings form view ───────────────────────────────────── -->
    <record id="view_fleet_settings_form" model="ir.ui.view">
        <field name="name">x.fleet.settings.form</field>
        <field name="model">x.fleet.settings</field>
        <field name="arch" type="xml">
            <form string="Fleet Settings" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Fleet Configuration</h1>
                        <p class="text-muted">
                            Configure GL expense accounts, payment methods, and MPPL prefix
                            codes for fleet operations. All log entries will use these settings.
                        </p>
                    </div>

                    <group string="GL Expense Accounts (Debit)">
                        <group string="Log Entries">
                            <field name="account_fuel_diesel_id" options="{'no_create': True}"
                                   string="Fuel — Diesel"/>
                            <field name="account_fuel_petrol_id" options="{'no_create': True}"
                                   string="Fuel — Petrol"/>
                            <field name="account_oil_id" options="{'no_create': True}"
                                   string="Oil Change"/>
                            <field name="account_filter_id" options="{'no_create': True}"
                                   string="Filters (Air / Oil / AC)"/>
                            <field name="account_other_id" options="{'no_create': True}"
                                   string="Other Consumables"/>
                        </group>
                        <group string="Spare Parts &amp; Other">
                            <field name="account_spare_parts_id" options="{'no_create': True}"
                                   string="Spare Parts &amp; Maintenance"/>
                            <field name="account_rental_id" options="{'no_create': True}"
                                   string="Rental Charges"/>
                        </group>
                    </group>

                    <group string="GL Credit Accounts">
                        <group>
                            <field name="account_log_credit_id"
                                   options="{'no_create': True}"
                                   string="Log Entry — Default Credit Account"
                                   help="Used ONLY for Direct Cash log entries (no petty cash or vendor bill linked). Typically a cash-in-hand or petty cash GL account. Petty Cash and Vendor Bill entries auto-link to their own JEs and do not use this account."/>
                            <field name="account_spare_parts_credit_id"
                                   options="{'no_create': True}"
                                   string="Spare Parts — Credit Account"
                                   help="Used for cash spare part purchases (no stock picking). Typically accounts payable or petty cash."/>
                        </group>
                    </group>

                    <group string="Operational Settings">
                        <field name="fuel_payment_source"/>
                        <field name="spare_parts_flow"/>
                    </group>

                    <separator string="MPPL Prefix Codes"/>
                    <p class="text-muted">
                        Add or deactivate prefix codes below. The <b>Next Seq #</b>
                        auto-increments each time a new vehicle of that type is registered.
                        Deactivated prefixes are hidden from the vehicle form.
                    </p>
                    <field name="mppl_prefix_ids" nolabel="1">
                        <list editable="top">
                            <field name="name"/>
                            <field name="prefix_code"/>
                            <field name="next_sequence" string="Next Seq #"/>
                            <field name="active"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fleet_settings" model="ir.actions.act_window">
        <field name="name">Fleet Settings</field>
        <field name="res_model">x.fleet.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
