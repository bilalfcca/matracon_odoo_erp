<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Spare Parts list view ─────────────────────────────────────────── -->
    <record id="view_fleet_spare_part_list" model="ir.ui.view">
        <field name="name">x.fleet.spare.part.list</field>
        <field name="model">x.fleet.spare.part</field>
        <field name="arch" type="xml">
            <list string="Spare Parts Log"
                  decoration-success="state == 'posted'"
                  decoration-muted="state == 'draft'">
                <field name="date"/>
                <field name="x_mppl_code" string="MPPL Code"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="x_site_config_id" string="Site" optional="show"/>
                <field name="product_id" string="Spare Part"/>
                <field name="x_spare_category" string="Category"/>
                <field name="description" optional="show"/>
                <field name="quantity"/>
                <field name="x_unit_cost"/>
                <field name="x_total_cost" string="Total (PKR)" sum="Total"/>
                <field name="picking_id" optional="hide"/>
                <field name="x_meter_at_service" optional="hide"/>
                <field name="x_account_move_id" optional="hide" string="JE"/>
                <field name="x_gl_posted" optional="show" string="GL"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ── Search view ───────────────────────────────────────────────────── -->
    <record id="view_fleet_spare_part_search" model="ir.ui.view">
        <field name="name">x.fleet.spare.part.search</field>
        <field name="model">x.fleet.spare.part</field>
        <field name="arch" type="xml">
            <search string="Spare Parts">
                <field name="vehicle_id"/>
                <field name="product_id"/>
                <filter string="Posted" name="posted" domain="[('state','=','posted')]"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter string="By Vehicle" name="group_vehicle"
                        context="{'group_by': 'vehicle_id'}"/>
                <filter string="By Month" name="group_month"
                        context="{'group_by': 'date:month'}"/>
                <filter string="By Category" name="group_category"
                        context="{'group_by': 'x_spare_category'}"/>
            </search>
        </field>
    </record>

    <!-- ── Graph: Spare Parts Cost by Category (pie) ─────────────────────── -->
    <record id="view_fleet_spare_part_graph_category" model="ir.ui.view">
        <field name="name">x.fleet.spare.part.graph.category</field>
        <field name="model">x.fleet.spare.part</field>
        <field name="arch" type="xml">
            <graph string="Spare Parts Cost by Category" type="pie" sample="1">
                <field name="x_spare_category" type="row"/>
                <field name="x_total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Graph: Spare Parts Cost Trend by Month (bar) ─────────────────── -->
    <record id="view_fleet_spare_part_graph_monthly" model="ir.ui.view">
        <field name="name">x.fleet.spare.part.graph.monthly</field>
        <field name="model">x.fleet.spare.part</field>
        <field name="arch" type="xml">
            <graph string="Spare Parts Cost Trend" type="bar" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="x_total_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ── Spare Parts Analysis action (graph first, then list) ─────────── -->
    <record id="action_fleet_spare_part_analysis" model="ir.actions.act_window">
        <field name="name">Spare Parts Analysis</field>
        <field name="res_model">x.fleet.spare.part</field>
        <field name="view_mode">graph,list</field>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_category': 1}</field>
    </record>
</odoo>
