<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon Purchase Order — QWeb PDF Template
        =============================================
        Uses Odoo's _prepare_html() header/footer mechanism:
          <div class="header">  → extracted → passed as -header-html to wkhtmltopdf (repeats every page)
          <div class="footer">  → extracted → passed as -footer-html to wkhtmltopdf (repeats every page)
          <div class="article"> → body content rendered through minimal_layout
    -->
    <template id="report_final_po_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ═══════════════════════════════════════════════════════
                     PAGE HEADER  (repeats on every page via -header-html)
                     Paper format margin_top must be large enough to hold this.
                     ═══════════════════════════════════════════════════════ -->
                <div class="header" style="
                        font-family: Arial, sans-serif;
                        width: 100%;
                        padding: 4mm 15mm 2mm 15mm;
                        box-sizing: border-box;
                        background: #ffffff;">
                    <table style="width:100%; border:0; border-collapse:collapse; border-spacing:0;">
                        <tr>
                            <!-- Logo -->
                            <td style="width:95px; padding:0; border:0; vertical-align:middle;">
                                <t t-if="env.company.logo">
                                    <img t-att-src="image_data_uri(env.company.logo)"
                                         style="max-height:58px; max-width:88px; object-fit:contain; display:block;"/>
                                </t>
                            </td>
                            <!-- Company name -->
                            <td style="padding:0 0 0 14px; border:0; vertical-align:middle;
                                       font-size:22px; font-weight:bold; color:#1a3a5c;
                                       letter-spacing:0.5px; white-space:nowrap;">
                                MATRACON PAKISTAN (PVT) LIMITED
                            </td>
                        </tr>
                    </table>
                    <!-- Divider line -->
                    <div style="border-top:2.5px solid #1a3a5c; margin-top:5px;"></div>
                </div>

                <!-- ═══════════════════════════════════════════════════════
                     PAGE FOOTER  (repeats on every page via -footer-html)
                     ═══════════════════════════════════════════════════════ -->
                <div class="footer" style="
                        font-family: Arial, sans-serif;
                        font-size: 8px;
                        color: #444;
                        text-align: center;
                        padding: 1mm 15mm 2mm 15mm;
                        width: 100%;
                        box-sizing: border-box;
                        background: #ffffff;">
                    <div style="border-top:1px solid #aaa; margin-bottom:2px;"></div>
                    <div>
                        <strong>Head Office</strong>&#160;:&#160;17, Street No. 89, G-6/3, Islamabad,
                        UAN: 0092-51-111-025-025&#160;&#160;Fax: +92-51-2101183&#160;&#160;E-mail: matracon@gmail.com
                    </div>
                    <div>
                        <strong>Regional Office</strong>&#160;:&#160;2nd Floor, Plot No. 26-C, Lane-3,
                        Main Rahat Commercial, Phase-6 DHA, Karachi&#160;&#160;021-35853154
                    </div>
                </div>

                <!-- ═══════════════════════════════════════════════════════
                     ARTICLE — main body content
                     ═══════════════════════════════════════════════════════ -->
                <div class="article">
                    <style type="text/css">
                        body, div, table, td, p, span {
                            font-family: Arial, sans-serif;
                            font-size: 13px;
                            color: #222;
                        }

                        /* ── PO reference bar ── */
                        .po-ref-bar {
                            display: table;
                            width: 100%;
                            margin-bottom: 16px;
                        }
                        .po-ref-bar .ref-left,
                        .po-ref-bar .ref-right {
                            display: table-cell;
                            font-weight: bold;
                            font-size: 13px;
                        }
                        .po-ref-bar .ref-right { text-align: right; }

                        /* ── Vendor block ── */
                        .po-vendor-block { margin-bottom: 18px; }
                        .v-company { font-size: 14px; font-weight: bold; margin-bottom: 2px; }
                        .v-attn    { font-weight: bold; }

                        /* ── Line items table ── */
                        .po-table {
                            width: 100%;
                            border-collapse: collapse;
                            font-size: 13px;
                            margin-bottom: 20px;
                        }
                        .po-table thead tr {
                            background: #1a3a5c;
                            color: #ffffff;
                        }
                        .po-table th {
                            text-align: center;
                            padding: 7px 8px;
                            border: 1px solid #1a3a5c;
                            font-size: 12px;
                            font-weight: bold;
                        }
                        .po-table td {
                            border: 1px solid #cccccc;
                            padding: 5px 8px;
                            font-size: 12px;
                            vertical-align: top;
                        }
                        .po-table tbody tr:nth-child(odd)  td { background: #ffffff; }
                        .po-table tbody tr:nth-child(even) td { background: #f4f6fa; }
                        .po-table tfoot td {
                            font-weight: bold;
                            background: #f0f4f8;
                            border: 1px solid #aaa;
                        }

                    </style>

                    <div class="page">

                        <!-- PO# left — Print date right -->
                        <div class="po-ref-bar">
                            <div class="ref-left"><t t-esc="o.name"/></div>
                            <div class="ref-right">
                                <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                            </div>
                        </div>

                        <!-- Vendor: Company / City / Attn -->
                        <t t-set="vendor"    t-value="o.partner_id"/>
                        <t t-set="v_company" t-value="vendor.parent_id if vendor.parent_id else vendor"/>
                        <t t-set="v_contact" t-value="vendor if vendor.parent_id else False"/>

                        <div class="po-vendor-block">
                            <div class="v-company"><t t-esc="v_company.name"/></div>
                            <t t-if="v_company.city">
                                <div><t t-esc="v_company.city"/></div>
                            </t>
                            <t t-elif="v_company.street">
                                <div><t t-esc="v_company.street"/></div>
                            </t>
                            <t t-if="v_contact">
                                <div class="v-attn">Attn: <t t-esc="v_contact.name"/></div>
                            </t>
                        </div>

                        <!-- PROJECT (bold, uppercase, underlined) -->
                        <t t-if="o.x_project_analytic_account_id">
                            <div style="margin-bottom:14px; font-size:13px;">
                                <strong>PROJECT:&#160;</strong><span
                                    style="text-decoration:underline; font-weight:bold; text-transform:uppercase;">
                                    <t t-esc="o.x_project_analytic_account_id.name"/>
                                </span>
                            </div>
                        </t>

                        <!-- Subject (underlined) -->
                        <t t-if="o.partner_ref">
                            <div style="margin-bottom:16px; font-size:13px;">
                                <strong>Subject:&#160;</strong><span
                                    style="text-decoration:underline; font-weight:bold;">
                                    <t t-esc="o.partner_ref"/>
                                </span>
                            </div>
                        </t>

                        <!-- Formal letter body -->
                        <div style="font-size:13px; line-height:1.7; margin-bottom:16px;">
                            <p style="margin:0 0 8px 0;">Dear Sir,</p>
                            <p style="margin:0 0 8px 0; text-indent:32px;">
                                Through your quotation, we are pleased to confirm the order for the Supply
                                of the abovementioned product for our subject project, as per the required
                                standards and specifications.
                            </p>
                        </div>

                        <!-- Line items table
                             Shows ALL non-section/note lines.
                             Qty  = x_approved_qty if set and > 0, else product_qty -->
                        <t t-set="po_grand_total" t-value="0.0"/>
                        <t t-set="line_no"        t-value="1"/>
                        <table class="po-table">
                            <thead>
                                <tr>
                                    <th style="width:4%;">#</th>
                                    <th style="width:38%; text-align:left;">Product / Description</th>
                                    <th style="width:9%;">UoM</th>
                                    <th style="width:10%;">Qty</th>
                                    <th style="width:18%; text-align:right;">Unit Price</th>
                                    <th style="width:21%; text-align:right;">
                                        Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line" t-as="line">
                                    <t t-if="not line.display_type">
                                        <t t-set="po_qty"
                                           t-value="(line.x_approved_qty or 0.0) if (line.x_approved_qty or 0.0) > 0
                                                    else (line.product_qty or 0.0)"/>
                                        <t t-set="po_sub" t-value="po_qty * (line.price_unit or 0.0)"/>
                                        <t t-set="po_grand_total" t-value="po_grand_total + po_sub"/>
                                        <tr>
                                            <td style="text-align:center;">
                                                <t t-esc="line_no"/>
                                                <t t-set="line_no" t-value="line_no + 1"/>
                                            </td>
                                            <td style="text-align:left;">
                                                <t t-esc="line.product_id.display_name or line.name"/>
                                                <t t-if="line.name and line.name != (line.product_id.display_name or '')">
                                                    <br/><span style="font-size:11px; color:#666;">
                                                        <t t-esc="line.name"/>
                                                    </span>
                                                </t>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-esc="line.product_uom_id.name"/>
                                            </td>
                                            <td style="text-align:center; font-weight:bold;">
                                                <t t-esc="'%.4g' % po_qty"/>
                                            </td>
                                            <td style="text-align:right;">
                                                <t t-esc="'{:,.2f}'.format(line.price_unit or 0.0)"/>
                                            </td>
                                            <td style="text-align:right; font-weight:bold;">
                                                <t t-esc="'{:,.2f}'.format(po_sub)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" style="text-align:right; padding:7px 8px;">
                                        Total Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)
                                    </td>
                                    <td style="text-align:right; padding:7px 8px; font-weight:bold;">
                                        <t t-esc="'{:,.2f}'.format(po_grand_total)"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Terms &amp; Conditions -->
                        <t t-if="o.note">
                            <div style="font-size:13px; font-weight:bold; margin:0 0 5px 0;">
                                Terms &amp; Conditions:
                            </div>
                            <div style="font-size:12px; line-height:1.65;">
                                <t t-out="o.note"/>
                            </div>
                        </t>

                        <!-- Signature block -->
                        <t t-set="sig" t-value="o.env['x.po.signature.config'].sudo().search(
                            [('company_id','=',o.company_id.id)], limit=1)"/>

                        <div style="margin-top:28px; font-size:13px; line-height:1.9;">
                            <p style="margin:0;">Thanking you.</p>
                            <p style="margin:0;">For &amp; on behalf of</p>
                            <p style="margin:0; font-weight:bold;">MATRACON PAKISTAN (PVT.) LIMITED</p>
                        </div>

                        <div style="margin-top:8px; min-height:56px; display:inline-block; padding-bottom:4px;">
                            <t t-if="sig and sig.x_ceo_signature">
                                <img t-att-src="image_data_uri(sig.x_ceo_signature)"
                                     style="max-height:56px; max-width:170px; object-fit:contain;"/>
                            </t>
                        </div>

                        <div style="display:inline-block; border-top:1px solid #000;
                                    padding-top:3px; margin-top:2px; min-width:170px; display:block;">
                            <div style="font-weight:bold; font-size:13px;">
                                <t t-esc="(sig and sig.x_ceo_name) or 'JEHANZEB SAULAT'"/>
                            </div>
                            <div style="font-size:12px;">
                                <t t-esc="(sig and sig.x_ceo_title) or 'CEO'"/>
                            </div>
                        </div>

                        <!-- CC -->
                        <div style="margin-top:20px; font-size:13px;">
                            <div>CC:</div>
                            <ul style="margin:4px 0 0 22px; padding:0; font-size:13px;">
                                <li>Director M/s Matracon Pakistan Pvt. Limited, Islamabad.</li>
                                <li>File</li>
                            </ul>
                        </div>

                    </div><!-- /page -->
                </div><!-- /article -->

            </t>
        </t>
    </template>
</odoo>
