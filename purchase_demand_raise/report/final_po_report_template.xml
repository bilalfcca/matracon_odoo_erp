<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon Purchase Order Print Template

        Layout  (mirrors the RFQ layout):
          • Vendor details  — TOP  (name, address, contact)
          • PURCHASE ORDER title — centred, navy blue
          • Meta info (PO Ref, Date = CEO approval date, Category, Project, etc.)
          • Product table — navy headers, alternating rows
              – Only lines where price_unit > 0  (CS-processed items only)
              – Qty column labelled "Quantity" (not "Approved Qty")
              – Qty = approved_qty → recommended_qty (no fallback to unprocessed qty)
          • Terms & Conditions (if any)
          • Signature block (PO Officer + CEO)
          • Matracon footer with LOGO + company details

        Deliberately does NOT use web.external_layout / web.internal_layout
        to prevent Odoo auto-injecting a company-name banner at the top.
        Uses web.html_container (Bootstrap + base CSS, no company header).
    -->
    <template id="report_final_po_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ── Page CSS ──────────────────────────────────────────────── -->
                <style type="text/css">
                    @page {
                        margin: 14mm 20mm 18mm 20mm;
                    }
                    body {
                        font-family: Arial, sans-serif;
                        font-size: 13px;
                        color: #222;
                    }

                    /* ── Vendor block at top ── */
                    .po-vendor-block {
                        margin-bottom: 18px;
                        padding-bottom: 10px;
                        border-bottom: 2px solid #1a3a5c;
                    }
                    .po-vendor-block .vendor-name {
                        font-size: 15px;
                        font-weight: bold;
                        margin-bottom: 3px;
                    }

                    /* ── Title ── */
                    .po-title {
                        text-align: center;
                        font-size: 22px;
                        font-weight: bold;
                        margin: 0 0 16px 0;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        color: #1a3a5c;
                    }

                    /* ── Meta info table ── */
                    .po-meta td {
                        padding: 3px 14px 3px 0;
                        font-size: 13px;
                    }
                    .po-meta td.lbl { font-weight: bold; white-space: nowrap; }

                    /* ── Line items table ── */
                    .po-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 13px;
                        margin-bottom: 20px;
                    }
                    .po-table thead tr {
                        background: #1a3a5c;
                        color: #ffffff;
                    }
                    .po-table th {
                        text-align: center;
                        padding: 8px 10px;
                        border: 1px solid #1a3a5c;
                        font-size: 13px;
                        font-weight: bold;
                    }
                    .po-table td {
                        border: 1px solid #cccccc;
                        padding: 6px 10px;
                        text-align: right;
                        font-size: 13px;
                    }
                    .po-table tbody tr:nth-child(odd)  td { background: #ffffff; }
                    .po-table tbody tr:nth-child(even) td { background: #f4f6fa; }
                    .po-table tfoot td {
                        font-weight: bold;
                        background: #f0f4f8;
                        border: 1px solid #aaa;
                    }

                    /* ── Signatures ── */
                    @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&amp;display=swap');
                    .matracon-sig {
                        font-family: 'Dancing Script', cursive;
                        font-size: 26px;
                        color: #1a237e;
                        line-height: 1.1;
                    }

                    /* ── Footer ── */
                    .po-footer {
                        margin-top: 36px;
                        padding-top: 10px;
                        border-top: 2px solid #1a3a5c;
                        text-align: center;
                        font-size: 12px;
                        color: #444;
                    }
                    .po-footer strong {
                        font-size: 13px;
                        color: #1a3a5c;
                    }
                </style>

                <div class="page" style="padding:0;">

                    <!-- ══════════════════════════════════════════════════════════
                         TOP — VENDOR / SUPPLIER DETAILS
                         ══════════════════════════════════════════════════════════ -->
                    <div class="po-vendor-block">
                        <t t-if="o.partner_id">
                            <div class="vendor-name"><t t-esc="o.partner_id.name"/></div>
                            <t t-if="o.partner_id.street">
                                <div><t t-esc="o.partner_id.street"/></div>
                            </t>
                            <t t-if="o.partner_id.street2">
                                <div><t t-esc="o.partner_id.street2"/></div>
                            </t>
                            <t t-if="o.partner_id.city or o.partner_id.state_id or o.partner_id.zip">
                                <div>
                                    <t t-if="o.partner_id.city"><t t-esc="o.partner_id.city"/></t>
                                    <t t-if="o.partner_id.state_id">
                                        <t t-if="o.partner_id.city">, </t>
                                        <t t-esc="o.partner_id.state_id.name"/>
                                    </t>
                                    <t t-if="o.partner_id.zip">&#160;<t t-esc="o.partner_id.zip"/></t>
                                </div>
                            </t>
                            <t t-if="o.partner_id.country_id">
                                <div><t t-esc="o.partner_id.country_id.name"/></div>
                            </t>
                            <t t-if="o.partner_id.phone or o.partner_id.mobile">
                                <div>Tel: <t t-esc="o.partner_id.phone or o.partner_id.mobile"/></div>
                            </t>
                            <t t-if="o.partner_id.email">
                                <div>Email: <t t-esc="o.partner_id.email"/></div>
                            </t>
                        </t>
                    </div>

                    <!-- ══════════════════════════════════════════════════════════
                         TITLE
                         ══════════════════════════════════════════════════════════ -->
                    <div class="po-title">Purchase Order</div>

                    <!-- ══════════════════════════════════════════════════════════
                         META — reference, CEO-approval date, category, project …
                         Date = date_approve (set when CEO clicks Final Approval),
                         NOT date_order (that is the PR creation date).
                         ══════════════════════════════════════════════════════════ -->
                    <table class="po-meta" style="margin-bottom:16px;">
                        <tr>
                            <td class="lbl">PO Reference:</td>
                            <td><t t-esc="o.name"/></td>
                        </tr>
                        <tr>
                            <td class="lbl">Date:</td>
                            <!-- date_approve is stamped by action_ceo_final_approval()
                                 at the moment the CEO approves — use it, not date_order. -->
                            <td>
                                <t t-if="o.date_approve">
                                    <t t-esc="o.date_approve" t-options='{"widget": "date"}'/>
                                </t>
                                <t t-else="">
                                    <t t-esc="o.date_order" t-options='{"widget": "date"}'/>
                                </t>
                            </td>
                        </tr>
                        <tr t-if="o.x_category_id">
                            <td class="lbl">Category:</td>
                            <td><t t-esc="o.x_category_id.name"/></td>
                        </tr>
                        <tr t-if="o.x_project_analytic_account_id">
                            <td class="lbl">Project:</td>
                            <td><t t-esc="o.x_project_analytic_account_id.name"/></td>
                        </tr>
                        <tr t-if="o.picking_type_id">
                            <td class="lbl">Deliver To:</td>
                            <td><t t-esc="o.picking_type_id.warehouse_id.name or ''"/> Site Warehouse</td>
                        </tr>
                        <tr>
                            <td class="lbl">Currency:</td>
                            <td><t t-esc="o.currency_id.name"/></td>
                        </tr>
                        <t t-if="o.partner_ref">
                            <tr>
                                <td class="lbl">Vendor Ref:</td>
                                <td><t t-esc="o.partner_ref"/></td>
                            </tr>
                        </t>
                    </table>

                    <!-- ══════════════════════════════════════════════════════════
                         LINE ITEMS TABLE
                         Filter: only lines where price_unit > 0
                           (lines not processed through the CS get price_unit = 0 —
                            they were never quoted/recommended, so exclude them)
                         Qty: approved_qty if set, else recommended_qty
                         ══════════════════════════════════════════════════════════ -->
                    <h3 style="font-size:14px; font-weight:bold; border-bottom:2px solid #1a3a5c;
                                padding-bottom:5px; margin-bottom:10px; color:#1a3a5c;">
                        Order Items
                    </h3>

                    <table class="po-table">
                        <thead>
                            <tr>
                                <th style="width:4%; text-align:center;">#</th>
                                <th style="width:36%; text-align:left;">Product / Description</th>
                                <th style="width:9%; text-align:center;">UoM</th>
                                <th style="width:12%; text-align:center;">Quantity</th>
                                <th style="width:18%; text-align:right;">Unit Price</th>
                                <th style="width:21%; text-align:right;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="line_no" t-value="1"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <!-- Only show lines that went through the CS process
                                     (price_unit > 0 means a vendor was selected for this item).
                                     Lines with price_unit = 0 were not recommended / approved
                                     by either HO or CEO — exclude them. -->
                                <t t-if="not line.display_type and line.price_unit > 0">
                                    <!-- Qty: approved first, then recommended -->
                                    <t t-set="po_qty"
                                       t-value="line.x_approved_qty if (line.x_approved_qty or 0) > 0
                                                else (line.x_recommended_qty or 0)"/>
                                    <t t-set="po_subtotal" t-value="po_qty * line.price_unit"/>
                                    <tr>
                                        <td style="text-align:center;">
                                            <t t-esc="line_no"/>
                                            <t t-set="line_no" t-value="line_no + 1"/>
                                        </td>
                                        <td style="text-align:left;">
                                            <t t-esc="line.product_id.display_name"/>
                                            <t t-if="line.name and line.name != line.product_id.display_name">
                                                <br/>
                                                <span style="font-size:11px; color:#666;">
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:center; font-weight:bold;">
                                            <t t-esc="'%.4g' % po_qty"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <t t-esc="line.price_unit"
                                               t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td style="text-align:right; font-weight:bold;">
                                            <t t-esc="po_subtotal"
                                               t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" style="text-align:right; padding:8px 10px;">
                                    Total:
                                </td>
                                <!-- o.amount_total already excludes lines with price_unit=0
                                     (they contribute 0), so this is correct. -->
                                <td style="text-align:right; padding:8px 10px;">
                                    <t t-esc="o.amount_total"
                                       t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ══════════════════════════════════════════════════════════
                         TERMS &amp; CONDITIONS
                         ══════════════════════════════════════════════════════════ -->
                    <t t-if="o.note">
                        <h3 style="font-size:14px; font-weight:bold; border-bottom:2px solid #1a3a5c;
                                    padding-bottom:5px; margin:16px 0 8px 0; color:#1a3a5c;">
                            Terms &amp; Conditions
                        </h3>
                        <div style="font-size:12px; line-height:1.6;">
                            <t t-out="o.note"/>
                        </div>
                    </t>

                    <!-- ══════════════════════════════════════════════════════════
                         SIGNATURES — PO Officer + CEO
                         ══════════════════════════════════════════════════════════ -->
                    <t t-set="sig"
                       t-value="o.env['x.po.signature.config'].sudo().search(
                           [('company_id', '=', o.company_id.id)], limit=1)"/>
                    <div style="display:table; width:100%; margin-top:48px;">
                        <!-- PO Officer -->
                        <div style="display:table-cell; width:50%; text-align:center; padding:0 20px;">
                            <div style="min-height:60px; display:flex; align-items:flex-end;
                                        justify-content:center; padding-bottom:4px;">
                                <t t-if="sig and sig.x_po_officer_signature">
                                    <img t-att-src="image_data_uri(sig.x_po_officer_signature)"
                                         style="max-height:58px; max-width:200px; object-fit:contain;"/>
                                </t>
                                <t t-else="">
                                    <span class="matracon-sig">
                                        <t t-esc="(sig and sig.x_po_officer_name) or 'Nasir Swati'"/>
                                    </span>
                                </t>
                            </div>
                            <div style="border-top:1px solid #000; padding-top:5px;">
                                <div style="font-weight:bold;">
                                    <t t-esc="(sig and sig.x_po_officer_name) or 'Nasir Swati'"/>
                                </div>
                                <div style="color:#555; font-size:12px;">
                                    <t t-esc="(sig and sig.x_po_officer_title) or 'Procurement Officer'"/>
                                </div>
                            </div>
                        </div>
                        <!-- CEO -->
                        <div style="display:table-cell; width:50%; text-align:center; padding:0 20px;">
                            <div style="min-height:60px; display:flex; align-items:flex-end;
                                        justify-content:center; padding-bottom:4px;">
                                <t t-if="sig and sig.x_ceo_signature">
                                    <img t-att-src="image_data_uri(sig.x_ceo_signature)"
                                         style="max-height:58px; max-width:200px; object-fit:contain;"/>
                                </t>
                                <t t-else="">
                                    <span class="matracon-sig">
                                        <t t-esc="(sig and sig.x_ceo_name) or 'Jehanzeb Saulat'"/>
                                    </span>
                                </t>
                            </div>
                            <div style="border-top:1px solid #000; padding-top:5px;">
                                <div style="font-weight:bold;">
                                    <t t-esc="(sig and sig.x_ceo_name) or 'Jehanzeb Saulat'"/>
                                </div>
                                <div style="color:#555; font-size:12px;">
                                    <t t-esc="(sig and sig.x_ceo_title) or 'Chief Executive Officer'"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════════════
                         FOOTER — MATRACON LOGO + COMPANY DETAILS
                         (matches RFQ layout: company goes to bottom)
                         ══════════════════════════════════════════════════════════ -->
                    <div class="po-footer">
                        <!-- Company logo -->
                        <t t-if="env.company.logo">
                            <div style="margin-bottom:6px;">
                                <img t-att-src="image_data_uri(env.company.logo)"
                                     style="max-height:48px; max-width:160px; object-fit:contain;"/>
                            </div>
                        </t>
                        <strong><t t-esc="env.company.name"/></strong><br/>
                        <span>
                            <t t-if="env.company.street">
                                <t t-esc="env.company.street"/>
                            </t>
                            <t t-if="env.company.city">
                                <t t-if="env.company.street">,&#160;</t>
                                <t t-esc="env.company.city"/>
                            </t>
                            <t t-if="env.company.zip">
                                &#160;<t t-esc="env.company.zip"/>
                            </t>
                            <t t-if="env.company.country_id">
                                <t t-if="env.company.city or env.company.street">,&#160;</t>
                                <t t-esc="env.company.country_id.name"/>
                            </t>
                        </span>
                        <t t-if="env.company.phone">
                            <br/>Tel: <t t-esc="env.company.phone"/>
                        </t>
                        <t t-if="env.company.vat">
                            <br/>NTN: <t t-esc="env.company.vat"/>
                        </t>
                        <t t-if="env.company.website">
                            <br/><t t-esc="env.company.website"/>
                        </t>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>
