<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon Purchase Order Print Template
        =======================================
        Layout (matching reference letterhead):
          • Fixed page header  — logo left + MATRACON PAKISTAN (PVT) LIMITED right
          • Watermark          — faded logo centred behind content
          • Fixed page footer  — Head Office + Regional Office addresses
          • PO# left / print-date right
          • Vendor block: Company / City / Attn
          • PROJECT (bold, uppercase, underline)
          • Subject (underline, from partner_ref or notes)
          • Formal letter body
          • Line items table  — shows ALL lines (falls back to product_qty when
                                 x_approved_qty is null/zero)
          • Terms & Conditions
          • Signature block + CC
    -->
    <template id="report_final_po_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <style type="text/css">
                    /* ── Page setup ── */
                    @page {
                        size: A4;
                        margin: 42mm 20mm 30mm 20mm;
                    }
                    body {
                        font-family: Arial, sans-serif;
                        font-size: 13px;
                        color: #222;
                    }

                    /* ── Fixed page header (repeats on every page) ── */
                    .mtr-page-header {
                        position: fixed;
                        top: -38mm;
                        left: -20mm;
                        right: -20mm;
                        padding: 5mm 20mm 3mm 20mm;
                        background: #ffffff;
                    }
                    .mtr-header-inner {
                        display: table;
                        width: 100%;
                    }
                    .mtr-header-inner td {
                        display: table-cell;
                        vertical-align: middle;
                        border: none;
                        padding: 0;
                    }
                    .mtr-header-logo-cell {
                        width: 110px;
                    }
                    .mtr-header-name {
                        padding-left: 16px;
                        font-size: 28px;
                        font-weight: bold;
                        color: #1a3a5c;
                        letter-spacing: 0.5px;
                        white-space: nowrap;
                        vertical-align: middle;
                    }
                    .mtr-header-divider {
                        border: none;
                        border-top: 2px solid #1a3a5c;
                        margin: 5px 0 0 0;
                    }

                    /* ── Watermark ── */
                    .mtr-watermark {
                        position: fixed;
                        top: 50%;
                        left: 50%;
                        width: 300px;
                        height: 300px;
                        margin-top: -150px;
                        margin-left: -150px;
                        opacity: 0.12;
                        z-index: -1;
                        pointer-events: none;
                    }
                    .mtr-watermark img {
                        width: 100%;
                        height: auto;
                    }

                    /* ── Fixed page footer (repeats on every page) ── */
                    .mtr-page-footer {
                        position: fixed;
                        bottom: -26mm;
                        left: -20mm;
                        right: -20mm;
                        padding: 0 20mm 4mm 20mm;
                        background: #ffffff;
                        font-size: 9.5px;
                        color: #444;
                        text-align: center;
                    }
                    .mtr-footer-divider {
                        border: none;
                        border-top: 1px solid #999;
                        margin: 0 0 3px 0;
                    }

                    /* ── PO reference bar ── */
                    .po-ref-bar {
                        display: table;
                        width: 100%;
                        margin-bottom: 16px;
                    }
                    .po-ref-bar .ref-left,
                    .po-ref-bar .ref-right {
                        display: table-cell;
                        font-weight: bold;
                        font-size: 13px;
                    }
                    .po-ref-bar .ref-right { text-align: right; }

                    /* ── Vendor block ── */
                    .po-vendor-block { margin-bottom: 20px; }
                    .v-company {
                        font-size: 14px;
                        font-weight: bold;
                        margin-bottom: 2px;
                    }
                    .v-attn { font-weight: bold; }

                    /* ── Line items table ── */
                    .po-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 13px;
                        margin-bottom: 20px;
                    }
                    .po-table thead tr {
                        background: #1a3a5c;
                        color: #ffffff;
                    }
                    .po-table th {
                        text-align: center;
                        padding: 8px 10px;
                        border: 1px solid #1a3a5c;
                        font-size: 13px;
                        font-weight: bold;
                    }
                    .po-table td {
                        border: 1px solid #cccccc;
                        padding: 6px 10px;
                        font-size: 13px;
                        vertical-align: top;
                    }
                    .po-table tbody tr:nth-child(odd)  td { background: #ffffff; }
                    .po-table tbody tr:nth-child(even) td { background: #f4f6fa; }
                    .po-table tfoot td {
                        font-weight: bold;
                        background: #f0f4f8;
                        border: 1px solid #aaa;
                    }

                    /* ── Signature cursive font ── */
                    @import url('https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&amp;display=swap');
                    .matracon-sig {
                        font-family: 'Dancing Script', cursive;
                        font-size: 26px;
                        color: #1a237e;
                        line-height: 1.1;
                    }
                </style>

                <!-- ══════════════════════════════════════════════════════════
                     FIXED PAGE HEADER (all pages)
                     ══════════════════════════════════════════════════════════ -->
                <div class="mtr-page-header">
                    <table class="mtr-header-inner">
                        <tr>
                            <td class="mtr-header-logo-cell">
                                <t t-if="env.company.logo">
                                    <img t-att-src="image_data_uri(env.company.logo)"
                                         style="max-height:72px; max-width:105px; object-fit:contain;"/>
                                </t>
                            </td>
                            <td class="mtr-header-name">
                                MATRACON PAKISTAN (PVT) LIMITED
                            </td>
                        </tr>
                    </table>
                    <hr class="mtr-header-divider"/>
                </div>

                <!-- ══════════════════════════════════════════════════════════
                     WATERMARK (faded logo, centred behind content)
                     ══════════════════════════════════════════════════════════ -->
                <t t-if="env.company.logo">
                    <div class="mtr-watermark">
                        <img t-att-src="image_data_uri(env.company.logo)"/>
                    </div>
                </t>

                <!-- ══════════════════════════════════════════════════════════
                     FIXED PAGE FOOTER (all pages)
                     ══════════════════════════════════════════════════════════ -->
                <div class="mtr-page-footer">
                    <hr class="mtr-footer-divider"/>
                    <div>
                        <strong>Head Office</strong> &#160;:&#160; 17, Street No. 89, G-6/3, Islamabad,
                        UAN: 0092-51-111-025-025 &#160; Fax: +92-51-2101183 &#160; E-mail: matracon@gmail.com
                    </div>
                    <div>
                        <strong>Regional Office</strong> : 2<sup>nd</sup> Floor, Plot No. 26-C, Lane-3,
                        Main Rahat Commercial, Phase-6 DHA, Karachi 021-35853154
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════════════
                     MAIN PAGE CONTENT
                     ══════════════════════════════════════════════════════════ -->
                <div class="page" style="padding:0;">

                    <!-- PO# left — Print date right -->
                    <div class="po-ref-bar">
                        <div class="ref-left"><t t-esc="o.name"/></div>
                        <div class="ref-right">
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                        </div>
                    </div>

                    <!-- Vendor: Company / City / Attn -->
                    <t t-set="vendor"    t-value="o.partner_id"/>
                    <t t-set="v_company" t-value="vendor.parent_id if vendor.parent_id else vendor"/>
                    <t t-set="v_contact" t-value="vendor if vendor.parent_id else False"/>

                    <div class="po-vendor-block">
                        <div class="v-company"><t t-esc="v_company.name"/></div>
                        <t t-if="v_company.city">
                            <div><t t-esc="v_company.city"/></div>
                        </t>
                        <t t-elif="v_company.street">
                            <div><t t-esc="v_company.street"/></div>
                        </t>
                        <t t-if="v_contact">
                            <div class="v-attn">Attn: <t t-esc="v_contact.name"/></div>
                        </t>
                    </div>

                    <!-- PROJECT (bold label, uppercase, underlined) -->
                    <t t-if="o.x_project_analytic_account_id">
                        <div style="margin-bottom:14px; font-size:13px;">
                            <strong>PROJECT: </strong><span
                                style="text-decoration:underline; font-weight:bold; text-transform:uppercase;">
                                <t t-esc="o.x_project_analytic_account_id.name"/>
                            </span>
                        </div>
                    </t>

                    <!-- Subject (underlined) -->
                    <t t-if="o.partner_ref">
                        <div style="margin-bottom:16px; font-size:13px;">
                            <strong>Subject: </strong><span
                                style="text-decoration:underline; font-weight:bold;">
                                <t t-esc="o.partner_ref"/>
                            </span>
                        </div>
                    </t>

                    <!-- ── Formal letter body ── -->
                    <div style="font-size:13px; line-height:1.7; margin-bottom:16px;">
                        <p style="margin:0 0 8px 0;">Dear Sir,</p>
                        <p style="margin:0 0 8px 0; text-indent:32px;">
                            Through your quotation, we are pleased to confirm the order for the Supply
                            of the abovementioned product for our subject project, as per the required
                            standards and specifications.
                        </p>
                    </div>

                    <!-- ── Line items table ── -->
                    <!-- NOTE: shows ALL non-section lines regardless of approved qty;
                         qty = x_approved_qty when set, otherwise product_qty -->
                    <t t-set="po_grand_total" t-value="0.0"/>
                    <t t-set="line_no"        t-value="1"/>
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th style="width:4%;">#</th>
                                <th style="width:38%; text-align:left;">Product / Description</th>
                                <th style="width:9%; text-align:center;">UoM</th>
                                <th style="width:11%; text-align:center;">Qty</th>
                                <th style="width:18%; text-align:right;">Unit Price</th>
                                <th style="width:20%; text-align:right;">Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-set="po_qty" t-value="(line.x_approved_qty or 0) if (line.x_approved_qty or 0) > 0 else (line.product_qty or 0)"/>
                                    <t t-set="po_sub" t-value="po_qty * (line.price_unit or 0.0)"/>
                                    <t t-set="po_grand_total" t-value="po_grand_total + po_sub"/>
                                    <tr>
                                        <td style="text-align:center;">
                                            <t t-esc="line_no"/>
                                            <t t-set="line_no" t-value="line_no + 1"/>
                                        </td>
                                        <td style="text-align:left;">
                                            <t t-esc="line.product_id.display_name or line.name"/>
                                            <t t-if="line.name and line.name != (line.product_id.display_name or '')">
                                                <br/><span style="font-size:11px; color:#666;">
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:center; font-weight:bold;">
                                            <t t-esc="'%.4g' % po_qty"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <t t-esc="'{:,.2f}'.format(line.price_unit or 0.0)"/>
                                        </td>
                                        <td style="text-align:right; font-weight:bold;">
                                            <t t-esc="'{:,.2f}'.format(po_sub)"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" style="text-align:right; padding:8px 10px;">
                                    Total Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)
                                </td>
                                <td style="text-align:right; padding:8px 10px; font-weight:bold;">
                                    <t t-esc="'{:,.2f}'.format(po_grand_total)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ── Terms &amp; Conditions ── -->
                    <t t-if="o.note">
                        <div style="font-size:13px; font-weight:bold; margin:0 0 6px 0;">
                            Terms &amp; Conditions:
                        </div>
                        <div style="font-size:12.5px; line-height:1.65;">
                            <t t-out="o.note"/>
                        </div>
                    </t>

                    <!-- ── Signature block ── -->
                    <t t-set="sig" t-value="o.env['x.po.signature.config'].sudo().search(
                        [('company_id','=',o.company_id.id)], limit=1)"/>

                    <div style="margin-top:32px; font-size:13px; line-height:1.9;">
                        <p style="margin:0;">Thanking you.</p>
                        <p style="margin:0;">For &amp; on behalf of</p>
                        <p style="margin:0; font-weight:bold;">MATRACON PAKISTAN (PVT.) LIMITED</p>
                    </div>

                    <div style="margin-top:10px; min-height:62px; display:flex; align-items:flex-end; padding-bottom:2px;">
                        <t t-if="sig and sig.x_ceo_signature">
                            <img t-att-src="image_data_uri(sig.x_ceo_signature)"
                                 style="max-height:60px; max-width:180px; object-fit:contain;"/>
                        </t>
                        <t t-else="">
                            <span class="matracon-sig">
                                <t t-esc="(sig and sig.x_ceo_name) or 'Jehanzeb Saulat'"/>
                            </span>
                        </t>
                    </div>

                    <div style="display:inline-block; border-top:1px solid #000;
                                padding-top:4px; margin-top:2px; min-width:180px;">
                        <div style="font-weight:bold; font-size:13px;">
                            <t t-esc="(sig and sig.x_ceo_name) or 'JEHANZEB SAULAT'"/>
                        </div>
                        <div style="font-size:12px;">
                            <t t-esc="(sig and sig.x_ceo_title) or 'CEO'"/>
                        </div>
                    </div>

                    <!-- ── CC ── -->
                    <div style="margin-top:22px; font-size:13px;">
                        <div>CC:</div>
                        <ul style="margin:4px 0 0 22px; padding:0; font-size:13px;">
                            <li>Director M/s Matracon Pakistan Pvt. Limited, Islamabad.</li>
                            <li>File</li>
                        </ul>
                    </div>

                </div><!-- /page -->
            </t>
        </t>
    </template>
</odoo>
