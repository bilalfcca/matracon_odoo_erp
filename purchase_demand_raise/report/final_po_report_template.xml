<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon Purchase Order: QWeb PDF Template
        ============================================
        Uses web.html_container then matracon_po_layout (our own standalone layout)
        which provides header / article / footer divs for wkhtmltopdf.

        Header carries:
          * Logo (left cell) + Company name (right cell) — side-by-side table layout
          * Thin navy divider
          * PO / RFQ reference + print-date

        Putting ref/date in the header guarantees they are always visible:
        they bypass the wkhtmltopdf article invisible-zone entirely.
    -->

    <!-- ═══════════════════════════════════════════════════════════════════
         Matracon PO/RFQ layout — shared by PO and RFQ templates.
         Calling template must set po_ref_number / po_ref_date before t-call.
    ═══════════════════════════════════════════════════════════════════════ -->
    <template id="matracon_po_layout">

        <!-- ── HEADER (repeats every page via wkhtmltopdf header-html) ── -->
        <div class="header" style="
                font-family: Arial, sans-serif;
                width: 100%;
                padding: 4px 10mm 4px 10mm;
                box-sizing: border-box;
                background: #ffffff;">

            <!-- Logo (left) + Company Name (right) — display:table so both cells
                 sit on one line and are vertically centered. white-space:nowrap
                 prevents the company name from wrapping to a second line. -->
            <div style="display:table; width:100%; border-collapse:collapse; border:none;">
                <div style="display:table-cell; vertical-align:middle; width:130px; padding-right:12px; border:none;">
                    <t t-if="env.company.logo">
                        <img t-att-src="image_data_uri(env.company.logo)"
                             style="height:120px; width:auto; display:block;"/>
                    </t>
                </div>
                <div style="display:table-cell; vertical-align:middle; border:none;">
                    <span style="font-family:'CG Omega', Arial, sans-serif;
                                 font-size:30px; font-weight:bold; font-style:normal;
                                 color:#4a1a6e; white-space:nowrap; display:block;">
                        MATRACON PAKISTAN (PVT) LIMITED
                    </span>
                </div>
            </div>

            <!-- Thin navy divider below brand row -->
            <div style="border-top:2.5px solid #1a3a5c; margin-top:4px; margin-bottom:2px;"></div>

            <!-- PO / RFQ reference number (left) + date (right)
                 Set by calling template:
                   <t t-set="po_ref_number" t-value="o.name"/>
                   <t t-set="po_ref_date"   t-value="...strftime(...)"/> -->
            <t t-if="po_ref_number or po_ref_date">
                <div style="overflow:hidden; padding:3px 0 2px 0; font-size:12px; font-weight:bold; color:#222;">
                    <span style="float:right;"><t t-esc="po_ref_date or ''"/></span>
                    <span><t t-esc="po_ref_number or ''"/></span>
                </div>
            </t>
        </div>

        <!-- ── ARTICLE (main body, content injected via t-out="0")
             padding-top: 22mm clears the wkhtmltopdf article invisible zone (~14mm)
             plus space for the header rows.
             text-align: justify — default for all paragraph/div text in the body.
             Explicit inline text-align on table cells overrides this. -->
        <div class="article" style="
                font-family: Arial, sans-serif;
                font-size: 13px;
                color: #222;
                text-align: justify;
                padding: 6mm 12mm 4mm 12mm;">

            <!-- CSS for product tables — lives here so it is part of the
                 minimal_layout body that wkhtmltopdf actually renders. -->
            <style type="text/css">
                body, div, p, span, li, td, th {
                    font-family: Arial, sans-serif;
                    color: #222;
                }
                /* Default justification for all body text */
                body, p, li {
                    text-align: justify;
                }
                /* Global reset: suppress borders on all td/th (Bootstrap may add them).
                   Data tables (.po-table, .rfq-table) override via higher specificity. */
                table  { border: none !important; border-collapse: collapse !important; border-spacing: 0 !important; }
                td, th { border: none !important; }

                /* PO product table */
                .po-table {
                    width: 100%;
                    border-collapse: collapse !important;
                    font-size: 12px;
                    margin-bottom: 18px;
                }
                .po-table thead tr { background: #1a3a5c; color: #ffffff; }
                .po-table th {
                    text-align: center;
                    padding: 7px 8px;
                    border: 1px solid #1a3a5c !important;
                    font-size: 12px;
                    font-weight: bold;
                    color: #ffffff;
                }
                .po-table td {
                    border: 1px solid #cccccc !important;
                    padding: 5px 8px;
                    font-size: 12px;
                    vertical-align: top;
                }
                .po-table tbody tr:nth-child(odd)  td { background: #ffffff; }
                .po-table tbody tr:nth-child(even) td { background: #f4f6fa; }
                .po-table tfoot tr td {
                    border-top: 2px solid #1a3a5c !important;
                    font-weight: bold;
                    background: #eef1f7;
                }

                /* RFQ product table */
                .rfq-table {
                    width: 100%;
                    border-collapse: collapse !important;
                    font-size: 12px;
                    margin-bottom: 18px;
                }
                .rfq-table thead tr { background: #1a3a5c; color: #ffffff; }
                .rfq-table th {
                    text-align: center;
                    padding: 7px 8px;
                    border: 1px solid #1a3a5c !important;
                    font-size: 12px;
                    font-weight: bold;
                    color: #ffffff;
                }
                .rfq-table td {
                    border: 1px solid #cccccc !important;
                    padding: 5px 8px;
                    font-size: 12px;
                    vertical-align: top;
                }
                .rfq-table tbody tr:nth-child(odd)  td { background: #ffffff; }
                .rfq-table tbody tr:nth-child(even) td { background: #f4f6fa; }
            </style>

            <!-- Actual page content from the calling template -->
            <t t-out="0"/>
        </div>

        <!-- ── FOOTER (repeats every page via wkhtmltopdf footer-html) ── -->
        <div class="footer" style="
                font-family: Arial, sans-serif;
                font-size: 8px;
                color: #444;
                text-align: center;
                padding: 1mm 12mm 1mm 12mm;
                width: 100%;
                box-sizing: border-box;
                background: #ffffff;">
            <div style="border-top:1px solid #aaa; margin-bottom:2px;"></div>
            <div>
                <strong>Head Office</strong>&#160;:&#160;17, Street No. 89, G-6/3, Islamabad,
                UAN: 0092-51-111-025-025&#160;&#160;Fax: +92-51-2101183&#160;&#160;E-mail: matracon@gmail.com
            </div>
            <div>
                <strong>Regional Office</strong>&#160;:&#160;2nd Floor, Plot No. 26-C, Lane-3,
                Main Rahat Commercial, Phase-6 DHA, Karachi&#160;&#160;021-35853154
            </div>
        </div>
    </template>


    <!-- ═══════════════════════════════════════════════════════════════════
         PURCHASE ORDER TEMPLATE
    ═══════════════════════════════════════════════════════════════════════ -->
    <template id="report_final_po_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- Supply ref + date to the layout header BEFORE t-call -->
                <t t-set="po_ref_number" t-value="o.name"/>
                <t t-set="po_ref_date"
                   t-value="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>

                <t t-call="purchase_demand_raise.matracon_po_layout">

                    <!-- Vendor: Company / City / Attn (divs, not table — avoids Bootstrap border CSS) -->
                    <t t-set="vendor"    t-value="o.partner_id"/>
                    <t t-set="v_company" t-value="vendor.parent_id if vendor.parent_id else vendor"/>
                    <t t-set="v_contact" t-value="vendor if vendor.parent_id else False"/>

                    <div style="margin-bottom:14px;">
                        <div style="font-size:14px; font-weight:bold; color:#222; line-height:1.5;">
                            <t t-esc="v_company.name"/>
                        </div>
                        <t t-if="v_company.city">
                            <div style="font-size:13px; color:#222; line-height:1.5;">
                                <t t-esc="v_company.city"/>
                            </div>
                        </t>
                        <t t-elif="v_company.street">
                            <div style="font-size:13px; color:#222; line-height:1.5;">
                                <t t-esc="v_company.street"/>
                            </div>
                        </t>
                        <t t-if="v_contact">
                            <div style="font-size:13px; font-weight:bold; color:#222; line-height:1.5;">
                                Attn: <t t-esc="v_contact.name"/>
                            </div>
                        </t>
                    </div>

                    <!-- PROJECT (bold, uppercase, underlined) -->
                    <t t-if="o.x_project_analytic_account_id">
                        <p style="margin:0 0 12px 0; font-size:13px; text-align:justify;">
                            <strong>PROJECT:&#160;</strong><span
                                style="text-decoration:underline; font-weight:bold; text-transform:uppercase;">
                                <t t-esc="o.x_project_analytic_account_id.name"/>
                            </span>
                        </p>
                    </t>

                    <!-- Subject (underlined) -->
                    <t t-if="o.partner_ref">
                        <p style="margin:0 0 14px 0; font-size:13px; text-align:justify;">
                            <strong>Subject:&#160;</strong><span
                                style="text-decoration:underline; font-weight:bold;">
                                <t t-esc="o.partner_ref"/>
                            </span>
                        </p>
                    </t>

                    <!-- Formal letter body -->
                    <p style="margin:0 0 7px 0; font-size:13px; line-height:1.7; text-align:justify;">Dear Sir,</p>
                    <p style="margin:0 0 14px 0; font-size:13px; line-height:1.7; text-align:justify; text-indent:28px;">
                        Through your quotation, we are pleased to confirm the order for the Supply
                        of the below mentioned product for our subject project, as per the required
                        standards and specifications.
                    </p>

                    <!-- Line items table
                         Qty = x_approved_qty if set and > 0, else product_qty -->
                    <t t-set="po_grand_total" t-value="0.0"/>
                    <t t-set="line_no"        t-value="1"/>
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th style="width:4%;">#</th>
                                <th style="width:38%; text-align:left;">Product / Description</th>
                                <th style="width:9%;">UoM</th>
                                <th style="width:10%;">Qty</th>
                                <th style="width:18%; text-align:right;">Unit Price</th>
                                <th style="width:21%; text-align:right;">
                                    Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <t t-set="po_qty"
                                       t-value="(line.x_approved_qty or 0.0) if (line.x_approved_qty or 0.0) > 0
                                                else (line.product_qty or 0.0)"/>
                                    <t t-set="po_sub" t-value="po_qty * (line.price_unit or 0.0)"/>
                                    <t t-set="po_grand_total" t-value="po_grand_total + po_sub"/>
                                    <tr>
                                        <td style="text-align:center;">
                                            <t t-esc="line_no"/>
                                            <t t-set="line_no" t-value="line_no + 1"/>
                                        </td>
                                        <td style="text-align:left;">
                                            <t t-esc="line.product_id.display_name or line.name"/>
                                            <t t-if="line.name and line.name != (line.product_id.display_name or '')">
                                                <br/><span style="font-size:11px; color:#666;">
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td style="text-align:center;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:center; font-weight:bold;">
                                            <t t-esc="'%.4g' % po_qty"/>
                                        </td>
                                        <td style="text-align:right;">
                                            <t t-esc="'{:,.2f}'.format(line.price_unit or 0.0)"/>
                                        </td>
                                        <td style="text-align:right; font-weight:bold;">
                                            <t t-esc="'{:,.2f}'.format(po_sub)"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" style="text-align:right; padding:7px 8px;">
                                    Total Amount (<t t-esc="o.currency_id.name or 'PKR'"/>)
                                </td>
                                <td style="text-align:right; padding:7px 8px; font-weight:bold;">
                                    <t t-esc="'{:,.2f}'.format(po_grand_total)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Terms &amp; Conditions -->
                    <t t-if="o.note">
                        <p style="font-size:13px; font-weight:bold; margin:0 0 4px 0; text-align:justify;">
                            Terms &amp; Conditions:
                        </p>
                        <div style="font-size:12px; line-height:1.65; text-align:justify;">
                            <t t-out="o.note"/>
                        </div>
                    </t>

                    <!-- Signature block -->
                    <t t-set="sig" t-value="o.env['x.po.signature.config'].sudo().search(
                        [('company_id','=',o.company_id.id)], limit=1)"/>

                    <p style="margin:24px 0 0 0; font-size:13px; line-height:1.9; text-align:justify;">Thanking you.</p>
                    <p style="margin:0; font-size:13px; line-height:1.9; text-align:justify;">For &amp; on behalf of</p>
                    <p style="margin:0; font-size:13px; line-height:1.9; font-weight:bold; text-align:justify;">
                        MATRACON PAKISTAN (PVT.) LIMITED
                    </p>

                    <div style="margin-top:8px; min-height:52px;">
                        <t t-if="sig and sig.x_ceo_signature">
                            <img t-att-src="image_data_uri(sig.x_ceo_signature)"
                                 style="max-height:52px; max-width:160px; object-fit:contain; display:block;"/>
                        </t>
                    </div>

                    <div style="border-top:1px solid #000; padding-top:3px; display:inline-block; min-width:160px;">
                        <p style="margin:0; font-weight:bold; font-size:13px;">
                            <t t-esc="(sig and sig.x_ceo_name) or 'JEHANZEB SAULAT'"/>
                        </p>
                        <p style="margin:0; font-size:12px;">
                            <t t-esc="(sig and sig.x_ceo_title) or 'CEO'"/>
                        </p>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
