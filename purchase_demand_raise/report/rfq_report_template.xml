<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon RFQ — QWeb PDF Template
        ==================================
        Uses the same matracon_po_layout as the PO template.
        Price / Tax / Total columns are BLANK — vendor fills in.

        Vendor override for CS "Print RFQ" per-vendor button:
          action_print_rfq() calls
            report.with_context(rfq_vendor_partner_id=partner.id).report_action(po)
          Falls back to o.partner_id when called directly from the PO form.
    -->
    <template id="report_rfq_demand_raise">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ── Resolve vendor ──────────────────────────────────────
                     rfq_vendor_partner_id in context → CS "Print RFQ"
                     o.partner_id → direct call from PO form
                ─────────────────────────────────────────────────────────── -->
                <t t-set="_rpid"
                   t-value="env.context.get('rfq_vendor_partner_id') or (o.partner_id.id if o.partner_id else 0)"/>
                <t t-set="rfq_partner"
                   t-value="env['res.partner'].browse(_rpid) if _rpid else False"/>

                <!-- Supply ref + date to the layout header BEFORE t-call -->
                <t t-set="po_ref_number" t-value="o.name"/>
                <t t-set="po_ref_date"
                   t-value="context_timestamp(o.date_approve or o.date_order).strftime('%B %d, %Y')"/>

                <t t-call="purchase_demand_raise.matracon_po_layout">

                    <!-- Vendor: Company / City / Attn (divs — avoids Bootstrap table border CSS) -->
                    <t t-if="rfq_partner">
                        <t t-set="v_company"
                           t-value="rfq_partner.parent_id if rfq_partner.parent_id else rfq_partner"/>
                        <t t-set="v_contact"
                           t-value="rfq_partner if rfq_partner.parent_id else False"/>

                        <div style="margin-bottom:14px;">
                            <div style="font-size:14px; font-weight:bold; color:#222; line-height:1.5;">
                                <t t-esc="v_company.name"/>
                            </div>
                            <t t-if="v_company.city">
                                <div style="font-size:13px; color:#222; line-height:1.5;">
                                    <t t-esc="v_company.city"/>
                                </div>
                            </t>
                            <t t-elif="v_company.street">
                                <div style="font-size:13px; color:#222; line-height:1.5;">
                                    <t t-esc="v_company.street"/>
                                </div>
                            </t>
                            <t t-if="v_contact">
                                <div style="font-size:13px; font-weight:bold; color:#222; line-height:1.5;">
                                    Attn: <t t-esc="v_contact.name"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- RFQ Title -->
                    <p style="text-align:center; font-size:18px; font-weight:bold; margin:0 0 12px 0;
                               text-transform:uppercase; letter-spacing:1px; color:#1a3a5c;">
                        Request for Quotation
                    </p>

                    <!-- RFQ meta (deadline / project only — ref + date are now in the header) -->
                    <div style="margin-bottom:12px; font-size:13px; color:#222; line-height:1.7;">
                        <t t-if="o.date_approve">
                            <div>
                                <span style="font-weight:bold; display:inline-block; min-width:110px;">Deadline:</span>
                                <span><t t-esc="o.date_approve" t-options='{"widget": "date"}'/></span>
                            </div>
                        </t>
                        <t t-if="o.x_project_analytic_account_id">
                            <div>
                                <span style="font-weight:bold; display:inline-block; min-width:110px;">Project:</span>
                                <span><t t-esc="o.x_project_analytic_account_id.name"/></span>
                            </div>
                        </t>
                    </div>

                    <!-- Formal letter body — 2 lines like PO -->
                    <p style="margin:0 0 7px 0; font-size:13px; line-height:1.7; text-align:justify;">Dear Sir/Madam,</p>
                    <p style="margin:0 0 14px 0; font-size:13px; line-height:1.7; text-align:justify; text-indent:28px;">
                        We are pleased to invite your quotation for the supply of the below mentioned
                        materials/services for our subject project, as per the required standards and
                        specifications.
                    </p>

                    <!-- Line items — Price / Tax / Total BLANK for vendor to fill -->
                    <table class="rfq-table">
                        <thead>
                            <tr>
                                <th style="width:4%;">#</th>
                                <t t-if="o.x_show_product_ref">
                                    <th style="width:8%; text-align:left;">Ref.</th>
                                </t>
                                <th t-attf-style="width:#{o.x_show_product_ref and '23%' or '31%'}; text-align:left;">Product / Description</th>
                                <th style="width:9%;">UoM</th>
                                <th style="width:11%;">Quantity</th>
                                <th style="width:16%;">Unit Price (PKR)</th>
                                <th style="width:11%;">Tax %</th>
                                <th style="width:18%;">Total (PKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="line_no" t-value="1"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <!-- qty cascade: recommended → requested → product_qty -->
                                    <t t-set="rfq_qty"
                                       t-value="(line.x_recommended_qty or 0) if (line.x_recommended_qty or 0) > 0
                                                else ((line.x_requested_qty or 0) if (line.x_requested_qty or 0) > 0
                                                else (line.product_qty or 0))"/>
                                    <tr>
                                        <td style="text-align:center; color:#222;">
                                            <t t-esc="line_no"/>
                                            <t t-set="line_no" t-value="line_no + 1"/>
                                        </td>
                                        <t t-if="o.x_show_product_ref">
                                            <td style="text-align:left; font-size:11px; color:#555;">
                                                <t t-esc="line.product_id.default_code or ''"/>
                                            </td>
                                        </t>
                                        <td style="text-align:left; color:#222;">
                                            <t t-esc="line.product_id.name or line.name"/>
                                            <t t-if="line.name and line.name != (line.product_id.name or '')">
                                                <br/><span style="font-size:11px; color:#666;">
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td style="text-align:center; color:#222;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:center; font-weight:bold; color:#222;">
                                            <t t-esc="('{:,.0f}' if rfq_qty == int(rfq_qty) else '{:,.3f}').format(rfq_qty)"/>
                                        </td>
                                        <!-- Price / Tax / Total: BLANK — vendor fills in -->
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Terms &amp; Conditions -->
                    <t t-if="o.note">
                        <div style="margin-top:18px;">
                            <p style="font-size:13px; font-weight:bold; color:#1a3a5c;
                                       margin:0 0 4px 0; text-transform:uppercase;
                                       letter-spacing:0.5px;">
                                Terms &amp; Conditions
                            </p>
                            <div style="font-size:12px; line-height:1.6; color:#222;
                                        border-top:1px solid #ccc; padding-top:6px;">
                                <t t-out="o.note"/>
                            </div>
                        </div>
                    </t>

                    <!-- Signature — Procurement Officer who prepared/sent this RFQ.
                         Single column (this report has only one signatory). Kept
                         self-contained (not a call into site_operations' shared
                         signature_block.xml macros) because purchase_demand_raise
                         does not depend on site_operations — site_operations
                         depends on purchase_demand_raise, the other way round —
                         so reaching into it here would be a fragile, backwards
                         cross-module reference. Mirrors the same image-or-blank
                         rendering logic as those macros. -->
                    <t t-set="_rfq_sig_user" t-value="o.sudo().x_rfq_prepared_by_id"/>
                    <div class="row mt-5">
                        <div class="col-4 text-center">
                            <div style="display:table; width:100%; height:60px;">
                                <div style="display:table-cell; vertical-align:bottom; text-align:center; padding-bottom:2px;">
                                    <t t-if="_rfq_sig_user and _rfq_sig_user.x_sign_signature">
                                        <img t-att-src="image_data_uri(_rfq_sig_user.x_sign_signature)"
                                             style="max-height:52px; max-width:150px; object-fit:contain;"/>
                                    </t>
                                </div>
                            </div>
                            <div style="border-top:2px solid #000; padding-top:8px;">
                                <div style="font-weight:700; font-size:13px;">Prepared By</div>
                                <t t-if="_rfq_sig_user">
                                    <div style="font-size:11px; color:#374151; margin-top:12px; font-weight:600;">
                                        <t t-esc="_rfq_sig_user.name"/>
                                    </div>
                                </t>
                                <!-- No blank "Name: ___" placeholder when nobody has
                                     prepared this RFQ yet — mirrors the fix in
                                     site_operations.report_sig_col (see that file's
                                     comment; kept self-contained here for the same
                                     module-dependency reason as the rest of this
                                     block). -->
                            </div>
                        </div>
                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>
