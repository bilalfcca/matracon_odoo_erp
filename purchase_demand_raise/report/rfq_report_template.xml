<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Matracon RFQ — QWeb PDF Template
        ==================================
        Uses the same matracon_po_layout as the PO template.
        Price / Tax / Total columns are BLANK — vendor fills in.

        Vendor override for CS "Print RFQ" per-vendor button:
          action_print_rfq() calls
            report.with_context(rfq_vendor_partner_id=partner.id).report_action(po)
          Falls back to o.partner_id when called directly from the PO form.
    -->
    <template id="report_rfq_demand_raise">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">

                <!-- ── Resolve vendor ──────────────────────────────────────
                     rfq_vendor_partner_id in context → CS "Print RFQ"
                     o.partner_id → direct call from PO form
                ─────────────────────────────────────────────────────────── -->
                <t t-set="_rpid"
                   t-value="env.context.get('rfq_vendor_partner_id') or (o.partner_id.id if o.partner_id else 0)"/>
                <t t-set="rfq_partner"
                   t-value="env['res.partner'].browse(_rpid) if _rpid else False"/>

                <t t-call="purchase_demand_raise.matracon_po_layout">

                    <!-- RFQ# left — Print date right -->
                    <table style="width:100%; border:0; border-collapse:collapse; border-spacing:0; margin-bottom:12px;">
                        <tr>
                            <td style="border:0; padding:0; font-size:13px; font-weight:bold; color:#222;">
                                <t t-esc="o.name"/>
                            </td>
                            <td style="border:0; padding:0; font-size:13px; font-weight:bold;
                                       color:#222; text-align:right;">
                                <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Vendor: Company / City / Attn (divs — avoids Bootstrap table border CSS) -->
                    <t t-if="rfq_partner">
                        <t t-set="v_company"
                           t-value="rfq_partner.parent_id if rfq_partner.parent_id else rfq_partner"/>
                        <t t-set="v_contact"
                           t-value="rfq_partner if rfq_partner.parent_id else False"/>

                        <div style="margin-bottom:14px;">
                            <div style="font-size:14px; font-weight:bold; color:#222; line-height:1.5;">
                                <t t-esc="v_company.name"/>
                            </div>
                            <t t-if="v_company.city">
                                <div style="font-size:13px; color:#222; line-height:1.5;">
                                    <t t-esc="v_company.city"/>
                                </div>
                            </t>
                            <t t-elif="v_company.street">
                                <div style="font-size:13px; color:#222; line-height:1.5;">
                                    <t t-esc="v_company.street"/>
                                </div>
                            </t>
                            <t t-if="v_contact">
                                <div style="font-size:13px; font-weight:bold; color:#222; line-height:1.5;">
                                    Attn: <t t-esc="v_contact.name"/>
                                </div>
                            </t>
                        </div>
                    </t>

                    <!-- RFQ Title -->
                    <p style="text-align:center; font-size:18px; font-weight:bold; margin:0 0 12px 0;
                               text-transform:uppercase; letter-spacing:1px; color:#1a3a5c;">
                        Request for Quotation
                    </p>

                    <!-- RFQ meta (ref / date / deadline / project) — divs avoid table border artifacts -->
                    <div style="margin-bottom:12px; font-size:13px; color:#222; line-height:1.7;">
                        <div>
                            <span style="font-weight:bold; display:inline-block; min-width:110px;">RFQ Reference:</span>
                            <span><t t-esc="o.name"/></span>
                        </div>
                        <div>
                            <span style="font-weight:bold; display:inline-block; min-width:110px;">Date:</span>
                            <span><t t-esc="context_timestamp(datetime.datetime.now()).strftime('%B %d, %Y')"/></span>
                        </div>
                        <t t-if="o.date_approve">
                            <div>
                                <span style="font-weight:bold; display:inline-block; min-width:110px;">Deadline:</span>
                                <span><t t-esc="o.date_approve" t-options='{"widget": "date"}'/></span>
                            </div>
                        </t>
                        <t t-if="o.x_project_analytic_account_id">
                            <div>
                                <span style="font-weight:bold; display:inline-block; min-width:110px;">Project:</span>
                                <span><t t-esc="o.x_project_analytic_account_id.name"/></span>
                            </div>
                        </t>
                    </div>

                    <!-- Formal letter body -->
                    <p style="font-size:13px; line-height:1.65; margin:0 0 6px 0;">Dear Sir/Madam,</p>
                    <p style="font-size:13px; line-height:1.65; margin:0 0 6px 0;">
                        We are pleased to invite your quotation for the supply of
                        materials/services as per the following requirements.
                    </p>
                    <p style="font-size:13px; line-height:1.65; margin:0 0 6px 0;">
                        Please find attached the RFQ document
                        (<t t-esc="o.name"/>) for your reference.
                    </p>
                    <p style="font-size:13px; line-height:1.65; margin:0 0 4px 0;">Kindly provide the following in your quotation:</p>
                    <ul style="font-size:13px; margin:0 0 6px 22px; padding:0;">
                        <li style="margin-bottom:2px;">Technical compliance with specifications</li>
                        <li style="margin-bottom:2px;">Unit rates and total quoted price</li>
                        <li style="margin-bottom:2px;">Delivery period</li>
                        <li style="margin-bottom:2px;">Warranty details</li>
                        <li style="margin-bottom:2px;">Validity of the offer</li>
                        <li style="margin-bottom:2px;">Installation / testing charges (if applicable)</li>
                    </ul>
                    <p style="font-size:13px; line-height:1.65; margin:0 0 6px 0;">
                        We look forward to receiving your competitive quotation at the earliest.
                    </p>
                    <p style="font-size:13px; line-height:1.65; margin:0 0 14px 0;">
                        Best regards,<br/>
                        <strong>Procurement Department</strong><br/>
                        Matracon Pakistan (Pvt.) Limited
                    </p>

                    <!-- Line items — Price / Tax / Total BLANK for vendor to fill -->
                    <table class="rfq-table">
                        <thead>
                            <tr>
                                <th style="width:4%;">#</th>
                                <th style="width:31%; text-align:left;">Product / Description</th>
                                <th style="width:9%;">UoM</th>
                                <th style="width:11%;">Quantity</th>
                                <th style="width:16%;">Unit Price (PKR)</th>
                                <th style="width:11%;">Tax %</th>
                                <th style="width:18%;">Total (PKR)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="line_no" t-value="1"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <t t-if="not line.display_type">
                                    <!-- qty cascade: recommended → requested → product_qty -->
                                    <t t-set="rfq_qty"
                                       t-value="(line.x_recommended_qty or 0) if (line.x_recommended_qty or 0) > 0
                                                else ((line.x_requested_qty or 0) if (line.x_requested_qty or 0) > 0
                                                else (line.product_qty or 0))"/>
                                    <tr>
                                        <td style="text-align:center; color:#222;">
                                            <t t-esc="line_no"/>
                                            <t t-set="line_no" t-value="line_no + 1"/>
                                        </td>
                                        <td style="text-align:left; color:#222;">
                                            <t t-esc="line.product_id.display_name or line.name"/>
                                            <t t-if="line.name and line.name != (line.product_id.display_name or '')">
                                                <br/><span style="font-size:11px; color:#666;">
                                                    <t t-esc="line.name"/>
                                                </span>
                                            </t>
                                        </td>
                                        <td style="text-align:center; color:#222;">
                                            <t t-esc="line.product_uom_id.name"/>
                                        </td>
                                        <td style="text-align:center; font-weight:bold; color:#222;">
                                            <t t-esc="'%.4g' % rfq_qty"/>
                                        </td>
                                        <!-- Price / Tax / Total: BLANK — vendor fills in -->
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                </t>
            </t>
        </t>
    </template>
</odoo>
