<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Unbind standard Odoo RFQ report — our Matracon template is primary -->
    <record id="purchase.report_purchase_quotation" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Matracon RFQ — bound to purchase.order -->
    <record id="action_report_rfq_demand_raise" model="ir.actions.report">
        <field name="name">Request for Quotation</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_demand_raise.report_rfq_demand_raise</field>
        <field name="report_file">purchase_demand_raise.report_rfq_demand_raise</field>
        <field name="print_report_name">'RFQ - %s' % (object.name)</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
