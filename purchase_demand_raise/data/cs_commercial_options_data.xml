    </record>

    <!-- ── Warranty ────────────────────────────────────────────────────── -->
    <record id="cs_opt_wr_12m_dlp" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">12 Months DLP</field>
        <field name="sequence">1</field>
    </record>
    <record id="cs_opt_wr_24m_dlp" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">24 Months DLP</field>
        <field name="sequence">2</field>
    </record>
    <record id="cs_opt_wr_12m_std" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">12 Months Standard</field>
        <field name="sequence">3</field>
    </record>
    <record id="cs_opt_wr_24m_std" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">24 Months Standard</field>
        <field name="sequence">4</field>
    </record>
    <record id="cs_opt_wr_as_contract" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">As per Contract</field>
        <field name="sequence">5</field>
    </record>
    <record id="cs_opt_wr_none" model="x.cs.commercial.option">
        <field name="category">warranty</field>
        <field name="name">No Warranty</field>
        <field name="sequence">6</field>
    </record>

</odoo>
