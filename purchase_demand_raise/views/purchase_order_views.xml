<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════════
         PURCHASE ORDER FORM — DEMAND RAISE  (Role-Based View)
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_purchase_order_form_demand_raise" model="ir.ui.view">
        <field name="name">purchase.order.form.demand.raise</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- ── 0. Standard Odoo state statusbar:
                 - Hidden on PR documents (replaced by x_pr_state bar)
                 - Hidden for Site Store (they always use our PR pipeline)
                 - Shown on alternative RFQs for HO/CEO (standard Odoo flow)
            ── -->
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="invisible">x_is_pr_document or x_is_site_store</attribute>
            </xpath>

            <!-- ── 1. Our PR status bar + all workflow buttons ── -->
            <xpath expr="//header" position="inside">

                <!-- PR Status bar: visible on PR docs, site store, and alternative RFQs -->
                <!-- HO Procurement: full approval chain shown -->
                <field name="x_pr_state" widget="statusbar"
                       statusbar_visible="draft,submitted,ceo_final,po_locked"
                       invisible="(not x_is_pr_document and not x_is_site_store and not x_is_alternative_rfq) or x_procurement_type == 'site_procurement'"/>
                <!-- Site Procurement: no HO/CEO steps — goes draft → po_locked directly -->
                <field name="x_pr_state" widget="statusbar"
                       statusbar_visible="draft,po_locked"
                       invisible="(not x_is_pr_document and not x_is_site_store) or x_procurement_type != 'site_procurement'"/>

                <!-- Print PR: Site Store only, draft/submitted only -->
                <button name="action_print_pr_internal"
                        string="Print PR"
                        type="object"
                        class="btn-secondary"
                        groups="purchase_demand_raise.group_site_store"
                        invisible="x_pr_state not in ('draft', 'submitted')"
                        data-hotkey="p"/>

                <!-- Site Store: Submit HO Procurement PR (requires HO + CEO approval) -->
                <button name="action_submit_pr"
                        string="Submit PR"
                        type="object"
                        class="btn-primary"
                        invisible="x_pr_state != 'draft' or not x_can_submit or x_procurement_type != 'ho_procurement'"
                        groups="purchase_demand_raise.group_site_store"
                        confirm="Confirm submission? PR will be sent to Procurement HO for vendor evaluation and CEO approval."/>

                <!-- Site Store: Submit Site Procurement PR (PM-approved, no HO/CEO required) -->
                <button name="action_submit_pr"
                        string="Submit PR"
                        type="object"
                        class="btn-primary"
                        invisible="x_pr_state != 'draft' or not x_can_submit or x_procurement_type != 'site_procurement'"
                        groups="purchase_demand_raise.group_site_store"
                        confirm="Submit this Site Procurement PR?"/>

                <!-- Site Store: disabled hint when PM doc not attached yet -->
                <button name="action_submit_pr"
                        string="Submit PR (Attach Signed PR First)"
                        type="object"
                        class="btn-secondary"
                        invisible="x_pr_state != 'draft' or x_can_submit"
                        groups="purchase_demand_raise.group_site_store"
                        disabled="1"/>

                <!-- Procurement Officer: Submit to CEO (PO-HO created PR — vendor + rec qty required) -->
                <button name="action_submit_pr"
                        string="Submit to CEO"
                        type="object"
                        class="btn-primary"
                        invisible="x_pr_state != 'draft' or not x_can_submit or x_pr_origin != 'procurement_ho'"
                        groups="purchase_demand_raise.group_procurement_ho"
                        confirm="Vendor and Recommended Quantities must be filled before submitting. Route this PR directly to CEO for final approval?"/>

                <!-- HO: Approve + recommend vendor → routes directly to CEO (single step) -->
                <button name="action_ho_approve"
                        string="✓ Approve &amp; Submit to CEO"
                        type="object"
                        class="btn-primary"
                        invisible="x_pr_state != 'submitted'"
                        groups="purchase_demand_raise.group_procurement_ho"
                        confirm="Set the Vendor field above before clicking. Vendor prices will be auto-fetched and the PR will route to CEO for final approval. Continue?"/>

                <button name="action_ho_reject"
                        string="✗ Reject"
                        type="object"
                        class="btn-danger"
                        invisible="x_pr_state != 'submitted'"
                        groups="purchase_demand_raise.group_procurement_ho"
                        confirm="Reject this PR? The initiator will be notified."/>

                <!-- CEO: Final Approve / Reject (also from Submitted when bypassing HO) -->
                <button name="action_ceo_final_approve"
                        string="✓ Final Approve &amp; Lock PO"
                        type="object"
                        class="btn-success"
                        invisible="x_pr_state not in ('ceo_final', 'submitted')"
                        groups="purchase_demand_raise.group_ceo_approval"
                        confirm="This will LOCK the PO and confirm the order. Continue?"/>

                <button name="action_ceo_final_reject"
                        string="✗ Reject"
                        type="object"
                        class="btn-danger"
                        invisible="x_pr_state not in ('ceo_final', 'submitted')"
                        groups="purchase_demand_raise.group_ceo_approval"
                        confirm="Reject at final stage? HO and initiator will be notified."/>

                <!-- Confirm PO when locked but Odoo state not yet purchase.
                     Hidden on alternatives — they are auto-confirmed by CEO approval. -->
                <button name="action_confirm_after_approval"
                        string="Confirm Order"
                        type="object"
                        class="btn-primary"
                        invisible="x_is_alternative_rfq or x_pr_state != 'po_locked' or (state in ('purchase', 'done') and incoming_picking_count != 0)"
                        groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"/>

                <!-- Print RFQ — HO/Head Office only; CEO sees Print PO instead -->
                <button name="action_print_rfq_no_price"
                        string="Print RFQ"
                        type="object"
                        class="btn-secondary"
                        invisible="x_is_site_store or x_is_ceo or state in ('purchase', 'done') or (x_is_pr_document and x_pr_state in ('rejected', 'cancelled'))"
                        groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"/>

                <!-- Print PO — CEO only; uses the Final PO report (heading: PURCHASE ORDER) -->
                <button name="%(purchase_demand_raise.action_report_final_po)d"
                        type="action"
                        string="Print PO"
                        class="btn-secondary"
                        invisible="x_pr_state in ('draft', 'rejected', 'cancelled')"
                        groups="purchase_demand_raise.group_ceo_approval"/>

                <!-- Preview PO PDF — opens in new tab; visible to HO/CEO/Admin once past draft -->
                <button name="action_preview_po_pdf"
                        type="object"
                        string="Preview PO"
                        class="btn-secondary"
                        title="Open Purchase Order PDF in a new browser tab"
                        invisible="x_pr_state in ('draft', 'submitted', 'rejected', 'cancelled')"
                        groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"/>

            </xpath>

            <!-- ── 2. Standard buttons: hide from Site Store; hide on PR docs when rejected ── -->
            <!-- Send RFQ/PO buttons:
                 [1] always hidden (duplicate from purchase_requisition)
                 [2] "Send RFQ" (state=sent)    — hidden for Site Store, CEO, locked/rejected PRs
                 [3] "Send PO"  (state=purchase) — hidden for Site Store and CEO (auto-sent on CEO approval) -->
            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_rfq_send'][2]" position="attributes">
                <attribute name="invisible">x_is_site_store or x_is_ceo or x_pr_state == 'po_locked' or (x_is_pr_document and x_pr_state in ('rejected', 'cancelled'))</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_rfq_send'][3]" position="attributes">
                <!-- "Send PO" button (state=purchase) — hide for all PR documents; keep for direct POs -->
                <attribute name="invisible">x_is_pr_document or x_is_site_store or x_is_ceo</attribute>
            </xpath>
            <!-- Confirm Order:
                 - PR documents: HIDDEN (CEO Final Approve handles confirm)
                 - Alternatives / direct POs: visible to HO and CEO
                 - Site Store: never visible
            -->
            <xpath expr="//header/button[@name='button_confirm'][@id='draft_confirm']" position="attributes">
                <attribute name="invisible">x_is_pr_document or x_is_site_store or x_is_alternative_rfq</attribute>
            </xpath>
            <!-- Cancel: hidden from Site Store and from PR docs once already cancelled/locked.
                 Rejected PRs CAN be cancelled (so they can then be deleted if needed). -->
            <xpath expr="//header/button[@name='button_cancel']" position="attributes">
                <attribute name="invisible">x_is_site_store or (x_is_pr_document and x_pr_state in ('po_locked', 'cancelled'))</attribute>
            </xpath>

            <!-- Hide the standard Odoo 'Reset to Draft' button on PR documents —
                 our custom action_reset_to_draft handles this with proper state cleanup -->
            <xpath expr="//header/button[@name='button_draft']" position="attributes">
                <attribute name="invisible">x_is_pr_document</attribute>
            </xpath>

            <!-- ── Reset / Undo buttons (role-specific) ── -->
            <xpath expr="//header/button[@name='button_cancel']" position="after">

                <!-- Site Store: undo submission → back to Draft (only while HO hasn't acted) -->
                <button name="action_reset_to_draft"
                        string="↩ Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        confirm="Reset this PR back to Draft? You will be able to edit and resubmit it."
                        groups="purchase_demand_raise.group_site_store"
                        invisible="x_pr_state not in ('submitted', 'cancelled', 'rejected') or x_ho_status != 'pending'"/>

                <!-- HO Procurement: undo their own approval → back to Submitted (only if CEO hasn't acted) -->
                <button name="action_reset_to_draft"
                        string="↩ Undo HO Approval"
                        type="object"
                        class="btn-secondary"
                        confirm="Undo your HO approval? The PR will return to Submitted state for re-evaluation."
                        groups="purchase_demand_raise.group_procurement_ho"
                        invisible="x_ho_status != 'approved' or x_ceo_status != 'pending'"/>

                <!-- CEO: undo their own approval/rejection → back to Pending CEO Approval -->
                <button name="action_reset_to_draft"
                        string="↩ Undo CEO Decision"
                        type="object"
                        class="btn-secondary"
                        confirm="Undo your CEO decision? The PR will return to Pending CEO Approval state."
                        groups="purchase_demand_raise.group_ceo_approval"
                        invisible="x_ceo_status not in ('approved', 'rejected')"/>

                <!-- Matracon Admin / System: full reset to Draft from any state -->
                <button name="action_reset_to_draft"
                        string="↩ Full Reset to Draft"
                        type="object"
                        class="btn-secondary"
                        confirm="Full reset: ALL approval statuses will be cleared and PR returned to Draft. Continue?"
                        groups="purchase_demand_raise.group_matracon_admin,base.group_system"
                        invisible="x_pr_state == 'draft'"/>

            </xpath>
            <!-- Hide duplicate standard Print Quotation buttons — use Print RFQ instead -->
            <xpath expr="//header/button[@name='print_quotation']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Upload Bill + Print at purchase state are handled in the priority-20 view below
                 (to avoid selector restrictions and run after all standard modules) -->

            <!-- ── 3. VENDOR FIELD: readonly control only here;
                 invisibility handled in the priority-20 view below
                 (purchase_requisition replaces partner_id, so we must run after it).
                 - HO: editable in rfq_phase (sets recommended vendor)
                 - CEO: editable in ceo_final (can override vendor if needed)
            ── -->

            <!-- ── 4. PARTNER REF — hide for Site Store ── -->
            <field name="partner_ref" position="attributes">
                <attribute name="groups">!purchase_demand_raise.group_site_store</attribute>
            </field>

            <!-- ── HO Guidance Banner: visible on PR in 'submitted' state for HO users ── -->
            <xpath expr="//sheet" position="inside">
                <div class="alert alert-info d-flex align-items-start gap-2"
                     role="status"
                     style="margin-bottom:8px;"
                     invisible="x_pr_state != 'submitted' or not x_is_ho or x_is_site_store">
                    <i class="fa fa-balance-scale fa-lg mt-1 text-primary"/>
                    <div>
                        <strong>Use the Comparative Statement to evaluate vendors.</strong><br/>
                        Click the <strong>Comparative Statement</strong> button (top-right) to add vendors,
                        enter their quotation prices, and select the preferred vendor.
                        The CS will automatically route this PR to CEO once a winner is selected and confirmed.
                        <br/>
                        <em class="text-muted">You can also set a vendor directly above and click
                        <strong>Approve &amp; Submit to CEO</strong> for a single-vendor approval.</em>
                    </div>
                </div>
            </xpath>

            <!-- ── 5a. Declare invisible flags (needed for column_invisible on line fields) ── -->
            <field name="x_pr_state" position="after">
                <field name="x_is_site_store" invisible="1"/>
                <field name="x_is_ho" invisible="1"/>
                <field name="x_is_ceo" invisible="1"/>
                <field name="x_is_pr_document" invisible="1"/>
                <field name="x_can_submit" invisible="1"/>
                <field name="x_has_tender_alternatives" invisible="1"/>
                <field name="x_project_site_config_id" invisible="1"/>
                <!-- Site warehouse restriction fields -->
                <field name="x_site_incoming_type_ids" invisible="1"/>
                <field name="x_site_has_multi_warehouse" invisible="1"/>
                <!-- x_pr_origin needed so line column_invisible and button invisible
                     conditions can access parent.x_pr_origin and x_pr_origin -->
                <field name="x_pr_origin" invisible="1"/>
            </field>

            <!-- ── 5b. INJECT custom header fields after partner_id ── -->
            <field name="partner_id" position="after">
                <!-- Procurement Type: visible on PR docs + site store; locked once submitted -->
                <field name="x_procurement_type"
                       widget="radio"
                       invisible="not x_is_pr_document and not x_is_site_store"
                       readonly="x_pr_state not in ('draft')"/>

                <!-- Local Supplier (Many2one) — Site Procurement only -->
                <field name="x_site_vendor_id"
                       string="Local Supplier"
                       placeholder="Select or create local supplier…"
                       invisible="x_procurement_type != 'site_procurement' or (not x_is_pr_document and not x_is_site_store)"
                       readonly="x_pr_state not in ('draft')"
                       context="{'site_procurement_vendor': True}"
                       options="{'no_quick_create': True}"/>

                <!-- Add to Liability Sheet — Site Procurement only -->
                <div invisible="x_procurement_type != 'site_procurement' or (not x_is_pr_document and not x_is_site_store)"
                     style="display:flex; align-items:center; gap:6px; margin-top:4px; margin-bottom:4px; white-space:nowrap;">
                    <span>Add this Supplier to Liability Sheet?</span>
                    <field name="x_add_to_liability_sheet"
                           nolabel="1"
                           readonly="x_pr_state not in ('draft')"/>
                </div>

                <!-- Category: HO Procurement only; locked once submitted/rejected -->
                <field name="x_category_id"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Select Category"
                       invisible="x_procurement_type == 'site_procurement' or (not x_is_pr_document and not x_is_site_store)"
                       readonly="x_pr_state not in ('draft')"/>

                <!-- Site Project: PO selects when raising a PR; auto-fills analytic + warehouse -->
                <field name="x_project_site_config_id"
                       options="{'no_create': True, 'no_open': True}"
                       placeholder="Select Site Project"
                       invisible="not x_is_ho or x_is_site_store"
                       readonly="x_pr_state != 'draft'"
                       required="x_is_ho and not x_is_site_store and x_pr_state == 'draft'"/>

                <!-- PM Signed PR — Site Store: upload field with instructional label -->
                <field name="x_pm_signed_pr"
                       widget="binary"
                       filename="x_pm_signed_pr_filename"
                       string="PM Signed PR (Attach before Submit)"
                       groups="purchase_demand_raise.group_site_store"
                       invisible="not x_is_pr_document and not x_is_site_store and not x_is_alternative_rfq"
                       readonly="x_pr_state != 'draft' or x_is_alternative_rfq"
                       help="Scan of the PM-signed printed PR. Must be attached before you can submit."/>
                <!-- PM Signed PR — HO/CEO/Head Office: read-only view, neutral label, no instructions -->
                <field name="x_pm_signed_pr"
                       widget="binary"
                       filename="x_pm_signed_pr_filename"
                       string="PM Signed Document"
                       groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"
                       invisible="not x_pm_signed_pr or (not x_is_pr_document and not x_is_alternative_rfq)"
                       readonly="1"/>
                <field name="x_pm_signed_pr_filename" invisible="1"/>

                <!-- Raised By -->
                <field name="x_initiator_id" readonly="1"
                       invisible="not x_is_pr_document and not x_is_site_store"/>

                <!-- Approval Status badges: HO Procurement only (Site Procurement has no HO/CEO step) -->
                <group string="Approval Status"
                       invisible="(not x_is_pr_document and not x_is_site_store and not x_is_alternative_rfq) or x_pr_state == 'draft' or x_procurement_type == 'site_procurement'">
                    <field name="x_ho_status" widget="badge"
                           decoration-warning="x_ho_status == 'pending'"
                           decoration-success="x_ho_status == 'approved'"
                           decoration-danger="x_ho_status == 'rejected'"
                           string="HO Status" readonly="1"/>
                    <field name="x_ceo_status" widget="badge"
                           decoration-warning="x_ceo_status == 'pending'"
                           decoration-success="x_ceo_status == 'approved'"
                           decoration-danger="x_ceo_status == 'rejected'"
                           string="CEO Status" readonly="1"/>
                </group>

                <!-- Rejection Reason -->
                <field name="x_rejection_reason"
                       invisible="x_pr_state != 'rejected'"
                       readonly="1" string="Rejection Reason"/>

                <!-- Project Analytic Account -->
                <field name="x_project_analytic_account_id"
                       invisible="not x_is_pr_document and not x_is_site_store and not x_has_tender_alternatives"
                       readonly="x_is_site_store"
                       groups="purchase_demand_raise.group_site_store,purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,base.group_system"/>
            </field>

            <!-- ── 6. LINE ITEMS — custom columns ── -->

            <!-- Lock entire order_line list when PR is rejected/cancelled/dispatched -->
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'cancel' or locked or (x_is_pr_document and x_pr_state in ('rejected', 'cancelled'))</attribute>
            </xpath>

            <!-- Role flags on lines (for readonly/invisible within lines) -->
            <field name="product_id" position="before">
                <field name="x_is_site_store" column_invisible="1"/>
                <field name="x_is_ho" column_invisible="1"/>
                <field name="x_is_ceo" column_invisible="1"/>
            </field>

            <!-- Standard Qty (product_qty):
                 - PR documents: hidden (replaced by x_requested_qty)
                 - Site Store: hidden
                 - Alternatives: hidden (we show Requested Qty instead for context)
                 - Direct admin/HO POs (not PR, not alternative): shown
            -->
            <field name="product_qty" position="attributes">
                <attribute name="column_invisible">parent.x_is_pr_document or parent.x_is_site_store or parent.x_is_alternative_rfq</attribute>
            </field>

            <!-- Requested Qty: PR docs + site store (site store edits); alternatives (HO edits freely)
                 Hidden for HO-created PRs (x_pr_origin='procurement_ho') — HO fills Recommended Qty directly -->
            <field name="product_qty" position="before">
                <field name="x_requested_qty"
                       string="Requested Qty"
                       column_invisible="(not parent.x_is_pr_document and not parent.x_is_site_store and not parent.x_is_alternative_rfq) or (parent.x_is_ho and parent.x_pr_origin == 'procurement_ho')"
                       readonly="not parent.x_is_site_store and not (parent.x_is_ho and parent.x_pr_state in ('draft', 'submitted')) and not parent.x_is_alternative_rfq"
                       optional="show"/>
            </field>

            <!-- Custom columns after product_qty -->
            <field name="product_qty" position="after">
                <!-- On Hand: PR docs, site store, and alternatives (always read-only) -->
                <field name="x_qty_on_hand"
                       string="On Hand"
                       column_invisible="not parent.x_is_pr_document and not parent.x_is_site_store and not parent.x_is_alternative_rfq"
                       readonly="1"
                       optional="show"/>

                <!-- Recommended Qty: HO edits on PR and alternatives; hidden from Site Store.
                     Editable in 'submitted' state (reviewing site-store PR) OR
                     in 'draft' state when HO is the PR creator (procurement_ho flow). -->
                <field name="x_recommended_qty"
                       string="Recommended Qty"
                       column_invisible="(not parent.x_is_pr_document and not parent.x_is_alternative_rfq) or parent.x_is_site_store"
                       readonly="not parent.x_is_ho or (parent.x_pr_state not in ('draft', 'submitted')) or (parent.x_pr_state == 'draft' and parent.x_pr_origin != 'procurement_ho')"
                       optional="show"/>

                <!-- Mandatory reason when HO changes recommended qty (PR docs only) -->
                <field name="x_qty_reason_required" column_invisible="1"/>
                <field name="x_qty_adjustment_reason"
                       string="Adjustment Reason"
                       column_invisible="not parent.x_is_pr_document or parent.x_is_site_store"
                       invisible="not x_qty_reason_required"
                       required="x_qty_reason_required and parent.x_pr_state == 'submitted'"
                       readonly="not parent.x_is_ho or (parent.x_pr_state not in ('draft', 'submitted')) or (parent.x_pr_state == 'draft' and parent.x_pr_origin != 'procurement_ho')"
                       placeholder="Required when recommended qty differs from requested"
                       optional="show"/>

                <!-- Decision: CEO only, on PR docs (not on alternatives) -->
                <field name="x_decision"
                       string="Decision"
                       column_invisible="not parent.x_is_pr_document or not parent.x_is_ceo"
                       readonly="parent.x_pr_state not in ('ceo_final', 'submitted')"
                       optional="show"/>

                <!-- Approved Qty: HO Procurement only (not used in Site Procurement) -->
                <field name="x_approved_qty"
                       string="Approved Qty"
                       column_invisible="parent.x_procurement_type == 'site_procurement' or (not parent.x_is_pr_document and not parent.x_is_site_store and not parent.x_is_alternative_rfq)"
                       readonly="not parent.x_is_ceo or parent.x_pr_state not in ('ceo_final', 'submitted')"
                       optional="show"/>

                <!-- Exceeds Recommended warning: CEO only, PR docs only -->
                <field name="x_exceeds_recommended"
                       string="⚠ Exceeds"
                       widget="boolean"
                       column_invisible="not parent.x_is_pr_document or not parent.x_is_ceo"
                       readonly="1"
                       optional="show"/>
            </field>

            <!-- ── 7. PRICE FIELDS — hidden for Site Store ── -->
            <field name="price_unit" position="attributes">
                <attribute name="column_invisible">parent.x_is_site_store</attribute>
            </field>
            <!-- Per-line currency: optional column shown after price_unit -->
            <field name="price_unit" position="after">
                <field name="x_line_currency_id"
                       string="Quote Currency"
                       optional="hide"
                       options="{'no_create': True, 'no_open': True}"
                       column_invisible="parent.x_is_site_store"/>
            </field>
            <field name="price_subtotal" position="attributes">
                <attribute name="column_invisible">parent.x_is_site_store</attribute>
            </field>
            <field name="tax_ids" position="attributes">
                <attribute name="column_invisible">parent.x_is_site_store</attribute>
            </field>

            <!-- ── 8. ANALYTIC DISTRIBUTION — hidden for Site Store ── -->
            <field name="analytic_distribution" position="attributes">
                <attribute name="column_invisible">parent.x_is_site_store</attribute>
            </field>

            <!-- ── 9. TOTALS FOOTER — hidden for Site Store ── -->
            <xpath expr="//group[hasclass('oe_subtotal_footer')]" position="attributes">
                <attribute name="groups">!purchase_demand_raise.group_site_store</attribute>
            </xpath>

            <!-- ── 10. CURRENCY — hidden for Site Store ── -->
            <field name="currency_id" position="attributes">
                <attribute name="groups">!purchase_demand_raise.group_site_store</attribute>
            </field>

        </field>
    </record>

    <!-- ═══════════════════════════════════════
         SMART BUTTON — Comparative Statement (CS-model based)
         ═══════════════════════════════════════ -->
    <record id="view_purchase_order_buttons_cs" model="ir.ui.view">
        <field name="name">purchase.order.buttons.cs</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Primary CS button: opens / creates the CS for this PR.
                     This is the MAIN vendor evaluation interface for HO —
                     replaces the native Alternatives tab. -->
                <button name="action_open_comparative_statement"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-balance-scale"
                        groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"
                        invisible="x_is_site_store or x_pr_state not in ('draft','submitted','ceo_final','po_locked')">
                    <field name="x_comparative_statement_id" invisible="1"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text" style="font-size:12px;font-weight:bold;">
                            Comparative
                        </span>
                        <span class="o_stat_text" style="font-size:12px;font-weight:bold;">
                            Statement
                        </span>
                        <span class="o_stat_text text-muted"
                              style="font-size:10px;"
                              invisible="x_comparative_statement_id">
                            Click to start
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════
         QUOTATION TERMS — per alternative RFQ (for CS)
         ═══════════════════════════════════════ -->
    <record id="view_purchase_order_form_quote_terms" model="ir.ui.view">
        <field name="name">purchase.order.form.quote.terms</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Quotation Terms (CS)"
                      name="quote_terms_cs"
                      groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,base.group_system"
                      invisible="x_is_site_store">
                    <group>
                        <group string="Commercial Terms">
                            <field name="x_quote_brand" placeholder="e.g. Siemens, Local make, As per specs"/>
                            <field name="x_quote_delivery_basis" placeholder="e.g. Ex-Works, FOR site"/>
                            <field name="x_quote_delivery_period" placeholder="e.g. 4–6 weeks"/>
                            <field name="x_quote_payment_terms" placeholder="e.g. 30 days after delivery"/>
                            <field name="x_quote_warranty" placeholder="e.g. 12 months / DLP as per contract"/>
                        </group>
                        <group string="Tax &amp; Reference">
                            <field name="x_quote_tax_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Select purchase taxes — applied to all lines"/>
                            <field name="x_quote_tax_treatment" placeholder="Optional note, e.g. charged extra / inclusive"/>
                            <field name="x_quote_validity"/>
                            <field name="partner_ref" string="Quotation Reference"/>
                        </group>
                    </group>
                    <group string="Additional Terms &amp; Conditions (any product / scope)">
                        <field name="x_quote_additional_terms" colspan="2" nolabel="1"
                               placeholder="Scope, inclusions, exclusions, testing, mobilization, HSE, or other vendor-specific conditions…"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Fill these on <strong>each alternative RFQ</strong> (one vendor per RFQ).
                        They are used when building the Comparative Statement.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════
         CATEGORY FILTER on product_id in lines
         When x_category_id is set (HO Procurement): restrict to that category.
         When x_category_id is not set (Site Procurement): show all purchasable products.
         ═══════════════════════════════════════ -->
    <record id="view_purchase_order_form_category_domain" model="ir.ui.view">
        <field name="name">purchase.order.form.category.domain</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="attributes">
                <attribute name="domain">[('categ_id', '=', parent.x_category_id), ('purchase_ok', '=', True)] if parent.x_category_id else [('purchase_ok', '=', True)]</attribute>
            </field>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         PRIORITY-20 OVERRIDES — must run AFTER purchase_requisition (priority 16)
         so that we correctly target the replaced partner_id node and the
         Alternatives tab that purchase_requisition adds.
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_purchase_order_form_site_store_overrides" model="ir.ui.view">
        <field name="name">purchase.order.form.site.store.overrides</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <!-- ── "Request for Quotation" span → "Purchase Requisition" for PR docs ──
                 The standard span shows "Request for Quotation" when state in ('draft','sent').
                 For PR documents and Site Store users we replace it with "Purchase Requisition". -->
            <xpath expr="//span[@class='o_form_label'][contains(., 'Request for Quotation')]" position="attributes">
                <attribute name="invisible">state not in ('draft', 'sent') or x_is_pr_document or x_is_site_store</attribute>
            </xpath>
            <xpath expr="//span[@class='o_form_label'][contains(., 'Request for Quotation')]" position="after">
                <span class="o_form_label"
                      invisible="state not in ('draft', 'sent') or (not x_is_pr_document and not x_is_site_store)">Purchase Requisition </span>
            </xpath>

            <!-- ── Hide "Ask Confirmation" receipt reminder for ALL users ── -->
            <xpath expr="//label[@for='receipt_reminder_email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='reminder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Deliver To (picking_type_id):
                 - Site Store, 1 site  → auto-filled, readonly
                 - Site Store, 2+ sites → dropdown restricted to their warehouses
                 - Everyone else → standard behaviour (incoming types only) -->
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="domain">
                    [('id', 'in', x_site_incoming_type_ids)] if x_is_site_store else [('code', '=', 'incoming')]
                </attribute>
                <attribute name="readonly">
                    x_is_site_store and not x_site_has_multi_warehouse
                </attribute>
            </xpath>

            <!-- Vendor field:
                 - Site Procurement: always hidden (no formal vendor — use x_site_vendor_name instead).
                 - HO Procurement, Site Store: hidden until PO is locked.
                 - HO Procurement, po_locked: Site Store sees vendor read-only (so they know who to expect).
                 - HO edits at 'draft'/'submitted'; CEO can override at 'ceo_final'. -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">x_procurement_type == 'site_procurement' or (x_is_site_store and x_pr_state != 'po_locked')</attribute>
                <attribute name="readonly">x_is_site_store or x_pr_state not in ('draft', 'submitted', 'ceo_final')</attribute>
            </xpath>

            <!-- Alternatives tab: hidden for ALL PR documents.
                 Vendor comparison is now handled exclusively through the
                 Comparative Statement (see smart button). This prevents
                 duplicate RFQs from being created for each vendor. -->
            <xpath expr="//page[@name='alternative_pos']" position="attributes">
                <attribute name="invisible">x_is_pr_document or x_pr_state == 'po_locked'</attribute>
            </xpath>

            <!-- Upload Bill widget: hidden from EVERYONE — site accountant feature for later -->
            <xpath expr="//widget[@name='purchase_file_uploader']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Print PO report button: hidden (use Print RFQ / Final PO report instead) -->
            <xpath expr="//header/button[@type='action']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Receive Products: Site Store only (standard Odoo receipt form) -->
            <xpath expr="//header/button[@name='action_view_picking']" position="attributes">
                <attribute name="groups">purchase_demand_raise.group_site_store</attribute>
                <attribute name="invisible">is_shipped or state not in ('purchase', 'done') or x_pr_state not in ('po_locked', 'dispatched')</attribute>
            </xpath>

            <!-- Receipt stat button: Site Store (to receive products) + CEO/Admin (to reverse before undo) -->
            <xpath expr="//div[@name='button_box']//button[@name='action_view_picking']" position="attributes">
                <attribute name="groups">purchase_demand_raise.group_site_store,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_matracon_admin,base.group_system</attribute>
                <attribute name="invisible">incoming_picking_count == 0</attribute>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         T&C TEMPLATE SELECTOR — injected above the note field
         Visible to Procurement HO, Head Office, CEO, and Admin only.
         Site Store does not select templates (they don't create confirmed POs).
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_purchase_order_form_tc_template" model="ir.ui.view">
        <field name="name">purchase.order.form.tc.template</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- T&C template selector: injected before the outer group that contains
                 the note field so it sits at the same layout level and gets full-form
                 width (not cramped inside a nested half-width group).
                 colspan="2" spans both columns of the standard 2-col group layout. -->
            <xpath expr="//group[group[field[@name='note']]]" position="before">
                <group invisible="x_is_site_store"
                       groups="purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system">
                    <field name="x_terms_template_id"
                           string="T&amp;C Template"
                           placeholder="Select a template to auto-fill Terms &amp; Conditions…"
                           options="{'no_create': True}"
                           readonly="state in ('purchase', 'done', 'cancel')"
                           colspan="2"/>
                </group>
            </xpath>
            <!-- T&C note text: hidden from Site Store (vendor terms are internal) -->
            <xpath expr="//field[@name='note']" position="attributes">
                <attribute name="invisible">x_is_site_store</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         CREATE ALTERNATIVE WIZARD — Restrict Vendor to "Vendor" tagged contacts
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_create_alternative_vendor_domain" model="ir.ui.view">
        <field name="name">purchase.requisition.create.alternative.vendor.domain</field>
        <field name="model">purchase.requisition.create.alternative</field>
        <field name="inherit_id" ref="purchase_requisition.purchase_requisition_create_alternative_form"/>
        <field name="arch" type="xml">
            <field name="partner_ids" position="attributes">
                <attribute name="domain">[('category_id.name', '=', 'Vendor')]</attribute>
            </field>
        </field>
    </record>

</odoo>
