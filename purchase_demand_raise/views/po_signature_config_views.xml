<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         PO SIGNATURE CONFIGURATION
         Opens the current company record to manage signature images
         printed on Purchase Order PDFs.
         Accessible via: Purchase → Configuration → PO Signatures
    ════════════════════════════════════════════════════════════════ -->

    <!-- Standalone company form — shows only PO signature fields -->
    <record id="view_company_po_signatures_form" model="ir.ui.view">
        <field name="name">res.company.po.signatures.form</field>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <form string="PO Signature Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert" style="margin-bottom:16px;">
                        <i class="fa fa-info-circle me-2"/>
                        Upload the digitized signature images below. They will appear on the
                        <strong>Purchase Order PDF</strong> sent to vendors after CEO approval.
                        Recommended: PNG with transparent background, height ~150 px.
                    </div>

                    <div class="row">
                        <!-- PO Officer -->
                        <div class="col-6">
                            <h5 class="fw-bold border-bottom pb-2 mb-3">PO Officer Signature</h5>
                            <group>
                                <field name="x_po_officer_name" string="Full Name"/>
                                <field name="x_po_officer_title" string="Title / Designation"/>
                                <field name="x_po_officer_signature"
                                       string="Signature Image"
                                       widget="image"
                                       options="{'size': [240, 120]}"
                                       help="PNG with transparent background recommended."/>
                            </group>
                        </div>

                        <!-- CEO -->
                        <div class="col-6">
                            <h5 class="fw-bold border-bottom pb-2 mb-3">CEO Signature</h5>
                            <group>
                                <field name="x_ceo_name" string="Full Name"/>
                                <field name="x_ceo_title" string="Title / Designation"/>
                                <field name="x_ceo_signature"
                                       string="Signature Image"
                                       widget="image"
                                       options="{'size': [240, 120]}"
                                       help="PNG with transparent background recommended."/>
                            </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: opens current company in signature config view -->
    <record id="action_po_signature_config" model="ir.actions.act_window">
        <field name="name">PO Signatures</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_company_po_signatures_form"/>
        <field name="target">current</field>
    </record>

    <!-- Menu under Purchase → Configuration -->
    <menuitem id="menu_po_signature_config"
              name="PO Signatures"
              parent="purchase.menu_purchase_config"
              action="action_po_signature_config"
              sequence="55"
              groups="purchase.group_purchase_manager,base.group_erp_manager"/>

</odoo>
