<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_pr_receipt" model="ir.ui.view">
        <field name="name">stock.picking.form.pr.receipt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <!-- Priority 21 — must run after site_operations.view_picking_form_site_ops (priority 20)
             so our add="x_is_site_procurement" appends to whatever invisible that view sets. -->
        <field name="priority">21</field>
        <field name="arch" type="xml">

            <!-- Site Procurement: hide "Receive From" (partner_id) — no formal
                 vendor is used; the informal vendor name lives on the PO as
                 x_site_vendor_name.  We append our condition to whatever invisible
                 was already set by the site_ops view (priority 20). -->
            <xpath expr="//div[hasclass('o_td_label')][label[@for='partner_id']]" position="attributes">
                <attribute name="invisible" separator=" or " add="x_is_site_procurement"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible" separator=" or " add="x_is_site_procurement"/>
            </xpath>

            <!-- Inject PR Receipt Details group + the x_is_site_procurement flag
                 between the standard header fields and the Operations notebook.
                 The flag is outside the conditionally-visible group so it is
                 always loaded by the OWL renderer regardless of picking type. -->
            <xpath expr="//sheet/notebook" position="before">

                <!-- Always-visible invisible flag — tells the form whether this is
                     a site-procurement receipt so the partner_id row can hide. -->
                <field name="x_is_site_procurement" invisible="1"/>

                <!-- PR Receipt Details: only visible on incoming PR receipts. -->
                <group string="PR Receipt Details"
                       invisible="picking_type_code != 'incoming' or not purchase_id">
                    <group>
                        <field name="x_project_analytic_account_id"
                               string="Project"
                               readonly="1"
                               options="{'no_open': True}"/>
                        <field name="x_dmr_no"
                               string="DMR No"
                               readonly="1"/>
                        <field name="x_gate_pass_no"
                               placeholder="Enter gate pass number…"/>
                    </group>
                    <group>
                        <!-- Renamed: Weight Document → Weight/PO Document -->
                        <field name="x_weight_document"
                               widget="binary"
                               filename="x_weight_document_filename"
                               string="Weight/PO Document (upload before validating)"/>
                        <field name="x_weight_document_filename" invisible="1"/>
                    </group>
                </group>

            </xpath>

            <!-- ══════════════════════════════════════════════════════════════════
                 "Validate" → "Mark Received"  (incoming PR receipts only)

                 Strategy:
                   1. Insert "Mark Received" buttons (receipt-only) BEFORE the
                      existing oe_highlight Validate button.
                   2. Suppress the original Validate buttons for receipts using
                      separator/add to preserve their existing invisible conditions.

                 The new buttons carry a distinguishing extra class
                 (o_btn_mark_received) so that the XPaths in step 2 — which
                 match @class='oe_highlight' and @class='o_btn_validate' exactly —
                 do NOT accidentally re-hide the new buttons (exact-match vs. contains).
            ══════════════════════════════════════════════════════════════════ -->

            <!-- Step 1a: primary "Mark Received" (shown at Ready / assigned state) -->
            <xpath expr="//button[@name='button_validate'][@class='oe_highlight']" position="before">
                <button name="button_validate"
                        invisible="picking_type_code != 'incoming' or not purchase_id or state in ('draft', 'confirmed', 'done', 'cancel')"
                        string="Mark Received" type="object"
                        class="oe_highlight o_btn_mark_received"
                        groups="stock.group_stock_user" data-hotkey="v"/>
            </xpath>

            <!-- Step 1b: secondary "Mark Received" (shown at Todo / confirmed state) -->
            <xpath expr="//button[@name='button_validate'][@class='o_btn_validate']" position="before">
                <button name="button_validate"
                        invisible="picking_type_code != 'incoming' or not purchase_id or state in ('waiting', 'assigned', 'done', 'cancel')"
                        string="Mark Received" type="object"
                        class="o_btn_validate o_btn_mark_received"
                        groups="stock.group_stock_user" data-hotkey="v"/>
            </xpath>

            <!-- Step 2a: hide original oe_highlight Validate for PR receipts -->
            <xpath expr="//button[@name='button_validate'][@class='oe_highlight']" position="attributes">
                <attribute name="invisible" separator=" or " add="picking_type_code == 'incoming' and bool(purchase_id)"/>
            </xpath>

            <!-- Step 2b: hide original o_btn_validate for PR receipts -->
            <xpath expr="//button[@name='button_validate'][@class='o_btn_validate']" position="attributes">
                <attribute name="invisible" separator=" or " add="picking_type_code == 'incoming' and bool(purchase_id)"/>
            </xpath>

            <!-- ══════════════════════════════════════════════════════════════════
                 Operations tab — column headers for PR receipts

                 The material-issuance view (priority 20) already renamed
                 product_uom_qty "Demand" → "Quantity".  We add receipt-specific
                 columns and hide the originals for incoming + purchase contexts.

                 product_uom_qty  →  "Original Demand"  (receipts)
                 quantity         →  "Receiving Now"    (receipts)
            ══════════════════════════════════════════════════════════════════ -->

            <!-- product_uom_qty: add "Original Demand" after the existing column -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="product_uom_qty"
                       string="Original Demand"
                       readonly="1"
                       column_invisible="parent.picking_type_code != 'incoming' or not parent.purchase_id"/>
            </xpath>
            <!-- Hide the [1] (original) product_uom_qty for receipts -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty'][1]" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming' and bool(parent.purchase_id)</attribute>
            </xpath>

            <!-- quantity: add "Receiving Now" after the existing column -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="quantity"
                       string="Receiving Now"
                       readonly="not is_quantity_done_editable"
                       column_invisible="parent.state == 'draft' or parent.picking_type_code != 'incoming' or not parent.purchase_id"
                       decoration-danger="product_uom_qty and quantity &gt; product_uom_qty and parent.state not in ['done', 'cancel']"/>
            </xpath>
            <!-- Hide the [1] (original) quantity for receipts; keep draft-hide behaviour for others -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity'][1]" position="attributes">
                <attribute name="column_invisible">parent.state == 'draft' or (parent.picking_type_code == 'incoming' and bool(parent.purchase_id))</attribute>
            </xpath>

        </field>
    </record>

</odoo>
