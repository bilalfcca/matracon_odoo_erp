<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="view_po_terms_template_list" model="ir.ui.view">
        <field name="name">x.po.terms.template.list</field>
        <field name="model">x.po.terms.template</field>
        <field name="arch" type="xml">
            <list string="T&amp;C Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="po_count" string="Used In"/>
                <field name="active" widget="toggle_button"
                       options='{"terminology": {"string_true": "Active", "string_false": "Archived"}}'/>
            </list>
        </field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <record id="view_po_terms_template_form" model="ir.ui.view">
        <field name="name">x.po.terms.template.form</field>
        <field name="model">x.po.terms.template</field>
        <field name="arch" type="xml">
            <form string="T&amp;C Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="po_count == 0">
                            <field name="po_count" widget="statinfo"
                                   string="Purchase Orders"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. PO with LC, PO without LC…"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description"
                                   placeholder="Internal note: when to use this template"/>
                        </group>
                    </group>
                    <separator string="Terms &amp; Conditions Content"/>
                    <div class="alert alert-info" role="alert">
                        This content will be <strong>copied</strong> into the
                        Purchase Order's Terms &amp; Conditions field when selected.
                        Users can further edit the text on individual orders.
                    </div>
                    <field name="content" widget="html"
                           style="min-height:400px;"
                           placeholder="Enter the full Terms &amp; Conditions text here…"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ─────────────────────────────────────────────────────── -->
    <record id="view_po_terms_template_search" model="ir.ui.view">
        <field name="name">x.po.terms.template.search</field>
        <field name="model">x.po.terms.template</field>
        <field name="arch" type="xml">
            <search string="Search T&amp;C Templates">
                <field name="name" string="Template Name"/>
                <field name="description"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ──────────────────────────────────────────────────────────── -->
    <record id="action_po_terms_template" model="ir.actions.act_window">
        <field name="name">T&amp;C Templates</field>
        <field name="res_model">x.po.terms.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_po_terms_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first T&amp;C Template
            </p>
            <p>
                Define reusable Terms &amp; Conditions templates for Purchase Orders.
                Select a template on any PO to auto-fill the T&amp;C section —
                the text can still be edited per order.
            </p>
        </field>
    </record>

</odoo>
