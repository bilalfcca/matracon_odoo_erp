<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — Form View (Redesigned v2)
         Layout:
           • Product summary table above tabs (all PR items with qty breakdown)
           • "Vendor Quotes" tab — one vendor per row; click to open full detail
             dialog with price table + terms + T&C template + documents
           • "Comparison Matrix" tab — side-by-side HTML
           • "Notes" tab
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_cs_form" model="ir.ui.view">
        <field name="name">x.comparative.statement.form</field>
        <field name="model">x.comparative.statement</field>
        <field name="arch" type="xml">
            <form string="Comparative Statement">
                <header>
                    <!-- Confirm &amp; route to CEO -->
                    <button name="action_confirm"
                            string="✓ Confirm Selection &amp; Route to CEO"
                            type="object"
                            class="btn-primary"
                            invisible="x_state != 'draft'"
                            confirm="Lock the winning vendor and advance this PR to CEO approval?"/>
                    <!-- Print CS PDF -->
                    <button name="action_print"
                            string="⬇ Download CS"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <!-- Onscreen HTML Preview (for PO / CEO) -->
                    <button name="action_preview_cs"
                            string="👁 Preview CS"
                            type="object"
                            class="btn-secondary"
                            title="Open a formatted onscreen preview of the Comparative Statement"/>
                    <!-- Send RFQ to all vendors in this CS -->
                    <button name="action_send_rfq_to_vendors"
                            string="📧 Send RFQ to Vendors"
                            type="object"
                            class="btn-secondary"
                            title="Send RFQ email to all vendors listed in this Comparative Statement"
                            invisible="not x_vendor_line_ids"/>
                    <field name="x_state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- ── Winner banner ── -->
                    <div class="alert alert-success d-flex align-items-center gap-2"
                         role="alert"
                         style="border-left:4px solid #28a745;"
                         invisible="not x_recommended_vendor_id">
                        <i class="fa fa-trophy fa-lg text-success"/>
                        <span>
                            <strong style="font-size:15px;">Selected Winner: </strong>
                            <field name="x_recommended_vendor_id" readonly="1" nolabel="1"
                                   style="font-size:15px;font-weight:bold;"/>
                            <span class="text-muted ms-2" invisible="x_state == 'confirmed'">—
                                Click <strong>✓ Confirm Selection &amp; Route to CEO</strong>
                                above to finalise.
                            </span>
                        </span>
                    </div>

                    <!-- ── Guide when no winner yet ── -->
                    <div class="alert alert-info d-flex align-items-start gap-2"
                         role="alert"
                         invisible="x_recommended_vendor_id or x_state == 'confirmed'">
                        <i class="fa fa-info-circle fa-lg mt-1"/>
                        <div>
                            <strong>How to evaluate vendors:</strong>
                            <ol class="mb-0 mt-1">
                                <li>In <strong>Vendor Quotes</strong> tab: click <strong>+ Add a line</strong> to add each vendor.</li>
                                <li>Click the vendor row to open their quote form — enter prices for each product, fill commercial terms, pick a T&amp;C template, and attach their quotation PDF.</li>
                                <li>Click <strong>⭐ Choose</strong> on the best vendor row to select them and copy their details to the PR.</li>
                                <li>Click <strong>✓ Confirm Selection &amp; Route to CEO</strong> above to finalise.</li>
                            </ol>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="x_state == 'confirmed'"
                                   placeholder="e.g. CS - P00001"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="x_purchase_order_id"
                                   readonly="x_state == 'confirmed'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="x_state" readonly="1" widget="badge"
                                   decoration-warning="x_state == 'draft'"
                                   decoration-success="x_state == 'confirmed'"/>
                        </group>
                    </group>

                    <!-- ── Product Summary (above tabs) ───────────────────────── -->
                    <div style="margin:0 0 8px 0;" invisible="not x_purchase_order_id">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa fa-list-ul text-muted"/>
                            <strong>Requisition Items</strong>
                            <span class="text-muted small ms-1">— Requested &amp; approval quantities from the PR</span>
                        </div>
                        <field name="x_product_summary_html" widget="html" readonly="1" nolabel="1"/>
                    </div>

                    <!-- ════════════════════════════════════════════════════
                         TABS
                         ════════════════════════════════════════════════════ -->
                    <notebook>

                        <!-- ══════════════════════════════════════════════════
                             TAB 1 — VENDOR QUOTES
                             One row per vendor; click row to open full detail
                             dialog (price table + terms + T&C + documents).
                             ══════════════════════════════════════════════════ -->
                        <page string="Vendor Quotes" name="vendor_quotes">
                            <div class="mb-2 text-muted small">
                                Add each vendor below. <strong>Click a vendor row</strong> to open their full quote form — enter prices, terms, T&amp;C and attach their quotation PDF. Then click
                                <strong>⭐ Choose</strong> on the best vendor.
                            </div>
                            <field name="x_vendor_line_ids"
                                   readonly="x_state == 'confirmed'"
                                   widget="one2many"
                                   context="{'default_x_cs_id': id}">

                                <!-- ── Compact list (one row per vendor) ── -->
                                <list string="Vendors"
                                      decoration-success="x_is_recommended"
                                      decoration-info="x_is_lowest">
                                    <field name="sequence" widget="handle"/>
                                    <field name="x_partner_id" string="Vendor" required="1"/>
                                    <field name="x_total_price" string="Sub-Total" readonly="1"/>
                                    <field name="x_gst_amount" string="GST" readonly="1" optional="show"/>
                                    <field name="x_net_total" string="Net Total" readonly="1"
                                           decoration-success="x_is_lowest"
                                           decoration-danger="not x_is_lowest and x_total_price > 0"/>
                                    <field name="x_savings_vs_highest" string="Saving" readonly="1" optional="show"/>
                                    <field name="x_tc_template_id" string="T&amp;C Template"
                                           readonly="1" optional="show"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="x_is_lowest" column_invisible="1"/>
                                    <field name="x_is_recommended" column_invisible="1"/>
                                    <!-- Choose / Winner buttons -->
                                    <!-- Best-value vendor: star + green outline -->
                                    <button name="action_choose_vendor"
                                            string="⭐ Choose"
                                            type="object"
                                            class="btn-sm btn-outline-success"
                                            invisible="not x_is_lowest or x_is_recommended"
                                            title="Lowest price — select this vendor and copy their details to the PR"/>
                                    <!-- Non-best, non-winner vendor: no star, grey outline -->
                                    <button name="action_choose_vendor"
                                            string="Choose"
                                            type="object"
                                            class="btn-sm btn-outline-secondary"
                                            invisible="x_is_lowest or x_is_recommended"
                                            title="Select this vendor and copy their details to the PR"/>
                                    <!-- Already selected as winner -->
                                    <button name="action_choose_vendor"
                                            string="🏆 Winner"
                                            type="object"
                                            class="btn-sm btn-success"
                                            invisible="not x_is_recommended"
                                            title="This vendor is selected — click to re-select"/>
                                    <!-- Send RFQ to this vendor -->
                                    <button name="action_send_rfq"
                                            string="📧 RFQ"
                                            type="object"
                                            class="btn-sm btn-outline-info"
                                            title="Send RFQ email to this vendor"/>
                                    <!-- Print RFQ PDF for this vendor -->
                                    <button name="action_print_rfq"
                                            string="🖨 Print RFQ"
                                            type="object"
                                            class="btn-sm btn-outline-secondary"
                                            title="Download RFQ PDF for this vendor (vendor details shown at top)"/>
                                </list>

                                <!-- ── Full per-vendor detail dialog ── -->
                                <form string="Vendor Quote Details">
                                    <div class="d-flex justify-content-between align-items-center mb-3"
                                         style="border-bottom:2px solid #1a3a5c;padding-bottom:8px;">
                                        <div>
                                            <h4 class="mb-0" style="color:#1a3a5c;">
                                                <field name="x_partner_id" required="1"
                                                       options="{'no_create': False}"/>
                                            </h4>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button name="action_choose_vendor"
                                                    string="⭐ Choose This Vendor"
                                                    type="object"
                                                    class="btn btn-success"
                                                    invisible="x_is_recommended"
                                                    title="Select this vendor and copy details to the PR"/>
                                            <span class="badge bg-success fs-6 d-flex align-items-center"
                                                  invisible="not x_is_recommended">
                                                🏆 Selected Winner
                                            </span>
                                            <!-- Send RFQ to this specific vendor -->
                                            <button name="action_send_rfq"
                                                    string="📧 Send RFQ"
                                                    type="object"
                                                    class="btn btn-outline-secondary"
                                                    title="Send Request for Quotation email to this vendor"/>
                                            <!-- Print RFQ PDF for this specific vendor -->
                                            <button name="action_print_rfq"
                                                    string="🖨 Print RFQ"
                                                    type="object"
                                                    class="btn btn-outline-secondary"
                                                    title="Download RFQ PDF with this vendor's details at the top"/>
                                        </div>
                                    </div>

                                    <!-- ── Price Quotation ── -->
                                    <separator string="Price Quotation"/>
                                    <field name="x_line_ids" widget="one2many"
                                           readonly="parent.x_state == 'confirmed'">
                                        <!-- create/delete disabled: products are fixed from the PR -->
                                        <list editable="bottom"
                                              create="0"
                                              delete="0"
                                              decoration-muted="x_unit_price == 0">
                                            <!-- x_pr_line_id kept invisible so the Owl client
                                                 tracks it in the create payload — used to recover
                                                 x_product_id when readonly fields are stripped -->
                                            <field name="x_pr_line_id" column_invisible="1"/>
                                            <field name="x_product_id" string="Product" readonly="1"/>
                                            <field name="x_uom_id" string="UoM" readonly="1"/>
                                            <field name="x_qty" string="Qty" readonly="1"/>
                                            <field name="x_currency_id" string="Currency"
                                                   optional="show"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                            <field name="x_unit_price" string="Unit Price"/>
                                            <field name="x_total_price" string="Total" readonly="1"/>
                                            <field name="x_gst_rate" string="GST %"/>
                                            <field name="x_gst_amount" string="GST Amt" readonly="1"/>
                                            <field name="x_net_price" string="Net Price" readonly="1"/>
                                            <field name="x_remarks" string="Remarks" optional="show"/>
                                        </list>
                                    </field>

                                    <!-- Totals row -->
                                    <group>
                                        <group/>
                                        <group>
                                            <field name="x_total_price" string="Sub-Total (Excl. GST)" readonly="1"/>
                                            <field name="x_gst_amount" string="Total GST" readonly="1"/>
                                            <field name="x_net_total" string="Grand Total (Incl. GST)" readonly="1"/>
                                        </group>
                                    </group>

                                    <!-- ── Commercial Terms (7 required fields) ── -->
                                    <separator string="Commercial Terms"/>
                                    <group>
                                        <!-- Left column -->
                                        <group string="Delivery &amp; Origin">
                                            <!-- 1. Delivery Basis -->
                                            <field name="x_delivery_basis_opt_id"
                                                   string="Delivery Basis"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_delivery_basis"
                                                   placeholder="or type manually…"/>

                                            <!-- 5. Delivery Time -->
                                            <field name="x_delivery_time_opt_id"
                                                   string="Delivery Time"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_delivery_period"
                                                   placeholder="or type manually…"/>

                                            <!-- 6. Brand / Origin -->
                                            <field name="x_brand_opt_id"
                                                   string="Brand / Origin"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_brand_origin"
                                                   placeholder="or type manually…"/>
                                        </group>

                                        <!-- Right column -->
                                        <group string="Payment &amp; Warranty">
                                            <!-- 3. Payment Mode -->
                                            <field name="x_payment_mode_opt_id"
                                                   string="Payment Mode"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_payment_mode"
                                                   placeholder="or type manually…"/>

                                            <!-- 4. Payment Terms (Odoo standard) -->
                                            <field name="x_payment_term_id"
                                                   string="Payment Terms"
                                                   options="{'no_create': False, 'no_open': True}"
                                                   placeholder="Select standard payment terms…"/>
                                            <!-- Custom note — shown only when "Other / Custom Terms" selected -->
                                            <field name="x_custom_payment_note"
                                                   string="Custom Note"
                                                   placeholder="Specify custom arrangement…"
                                                   invisible="not x_payment_term_id or x_payment_term_id.name != 'Other / Custom Terms'"/>

                                            <!-- 2. Taxes &amp; Duties -->
                                            <field name="x_tax_opt_id"
                                                   string="Taxes &amp; Duties"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_tax_treatment"
                                                   placeholder="or type manually…"/>

                                            <!-- 7. Warranty -->
                                            <field name="x_warranty_opt_id"
                                                   string="Warranty"
                                                   options="{'no_create': False, 'no_open': False}"/>
                                            <field name="x_warranty"
                                                   placeholder="or type manually…"/>
                                        </group>
                                    </group>

                                    <!-- ── Documents ── -->
                                    <separator string="Vendor Quotation Documents"/>
                                    <field name="x_attachment_ids"
                                           widget="many2many_binary"
                                           string="Attach Quotation PDFs / Images"/>

                                    <!-- ── Remarks ── -->
                                    <separator string="Additional Remarks"/>
                                    <field name="x_remarks" widget="text"
                                           placeholder="Any remarks for this vendor…"/>
                                </form>

                            </field>
                        </page>

                        <!-- Comparison Matrix and Notes tabs removed per user request -->

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — List View
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_cs_list" model="ir.ui.view">
        <field name="name">x.comparative.statement.list</field>
        <field name="model">x.comparative.statement</field>
        <field name="arch" type="xml">
            <list string="Comparative Statements"
                  decoration-success="x_state == 'confirmed'"
                  decoration-muted="x_state == 'draft'">
                <field name="name"/>
                <field name="x_purchase_order_id"/>
                <field name="x_recommended_vendor_id"/>
                <field name="x_vendor_count" string="Vendors"/>
                <field name="x_state" widget="badge"
                       decoration-warning="x_state == 'draft'"
                       decoration-success="x_state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — Action
         ════════════════════════════════════════════════════════════════ -->
    <record id="action_comparative_statement" model="ir.actions.act_window">
        <field name="name">Comparative Statements</field>
        <field name="res_model">x.comparative.statement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Comparative Statements yet
            </p>
            <p>
                Open a Purchase Requisition in <strong>Submitted</strong> state and click
                the <strong>Comparative Statement</strong> button to start comparing vendors.
            </p>
        </field>
    </record>

</odoo>
