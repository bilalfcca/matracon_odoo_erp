<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — Form View (Redesigned)
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_cs_form" model="ir.ui.view">
        <field name="name">x.comparative.statement.form</field>
        <field name="model">x.comparative.statement</field>
        <field name="arch" type="xml">
            <form string="Comparative Statement">
                <header>
                    <!-- Confirm &amp; route to CEO -->
                    <button name="action_confirm"
                            string="✓ Confirm Selection &amp; Route to CEO"
                            type="object"
                            class="btn-primary"
                            invisible="x_state != 'draft'"
                            confirm="This will lock the winner selection and advance the PR to CEO approval. Continue?"/>
                    <!-- Print CS PDF -->
                    <button name="action_print"
                            string="Print CS"
                            type="object"
                            class="btn-secondary"
                            icon="fa-print"/>
                    <field name="x_state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>

                <sheet>
                    <!-- Winner banner (shows after selection) -->
                    <div class="alert alert-success d-flex align-items-center"
                         role="alert"
                         invisible="not x_recommended_vendor_id">
                        <i class="fa fa-check-circle me-2 fs-5"/>
                        <span>
                            <strong>Winner selected: </strong>
                            <field name="x_recommended_vendor_id" readonly="1" nolabel="1"
                                   class="fw-bold"/>
                        </span>
                    </div>

                    <div class="alert alert-info"
                         role="alert"
                         invisible="x_recommended_vendor_id or x_state == 'confirmed'">
                        <i class="fa fa-info-circle me-2"/>
                        <span>
                            Add vendors in the <strong>Vendors &amp; Terms</strong> tab,
                            enter prices in <strong>Quote Lines</strong>, then click
                            <strong>⭐ Select as Winner</strong> on the best vendor row.
                        </span>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="x_state == 'confirmed'"
                                   placeholder="e.g. CS - P00001"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="x_purchase_order_id"
                                   readonly="x_state == 'confirmed'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="x_state" readonly="1" widget="badge"
                                   decoration-warning="x_state == 'draft'"
                                   decoration-success="x_state == 'confirmed'"/>
                        </group>
                    </group>

                    <!-- ── Tabs ── -->
                    <notebook>

                        <!-- ── Tab 1: Vendors &amp; Terms ──────────────────── -->
                        <page string="Vendors &amp; Terms" name="vendors_terms">
                            <div class="mb-2 text-muted small">
                                Add vendors below. Product lines are auto-created from the PR.
                                Click <strong>⭐ Select as Winner</strong> on the best vendor when ready.
                            </div>
                            <field name="x_vendor_line_ids"
                                   readonly="x_state == 'confirmed'"
                                   widget="one2many">
                                <list editable="bottom"
                                      decoration-success="x_is_recommended"
                                      decoration-muted="not x_is_recommended and x_is_lowest == False">
                                    <field name="sequence" widget="handle"/>
                                    <field name="x_partner_id" string="Vendor" required="1"/>
                                    <field name="x_brand_origin" string="Brand/Origin"/>
                                    <field name="x_delivery_basis" string="Delivery"/>
                                    <field name="x_delivery_period" string="Lead Time"/>
                                    <field name="x_payment_term_id" string="Payment Terms"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="x_payment_terms" string="Custom Pay. Notes"
                                           optional="hide"/>
                                    <field name="x_warranty" string="Warranty"/>
                                    <field name="x_tax_treatment" string="Tax"/>
                                    <field name="x_rfq_reference" string="Quote Ref"/>
                                    <field name="x_quote_validity" string="Valid Until"/>
                                    <field name="x_ancillary_included" string="Ancillaries?"/>
                                    <field name="x_total_price" string="Total" readonly="1"/>
                                    <field name="x_net_total" string="Net Total" readonly="1"
                                           decoration-success="x_is_lowest"
                                           decoration-danger="not x_is_lowest and x_total_price > 0"/>
                                    <field name="x_savings_vs_highest" string="Saving" readonly="1"/>
                                    <field name="x_is_lowest" column_invisible="1"/>
                                    <field name="x_is_recommended" column_invisible="1"/>
                                    <!-- Select Winner button -->
                                    <button name="action_select_as_recommended"
                                            string="⭐ Select Winner"
                                            type="object"
                                            class="btn-sm btn-success"
                                            invisible="x_is_recommended"
                                            title="Mark this vendor as the recommended winner"/>
                                    <button name="action_select_as_recommended"
                                            string="✓ Winner"
                                            type="object"
                                            class="btn-sm btn-outline-success"
                                            invisible="not x_is_recommended"
                                            title="This vendor is currently selected as the winner"/>
                                </list>
                            </field>
                        </page>

                        <!-- ── Tab 2: Quote Lines (per vendor) ─────────────── -->
                        <page string="Quote Lines" name="quote_lines">
                            <div class="mb-2 text-muted small">
                                Enter the quoted prices per vendor. Lines are grouped by vendor.
                                Use <strong>Add a line</strong> to add extra items if needed.
                            </div>
                            <field name="x_vendor_line_ids"
                                   readonly="x_state == 'confirmed'"
                                   widget="one2many">
                                <form string="Vendor Quote Details">
                                    <group>
                                        <group string="Vendor Info">
                                            <field name="x_partner_id" string="Vendor"
                                                   readonly="1"/>
                                            <field name="x_rfq_reference"
                                                   placeholder="Vendor's quotation number"/>
                                            <field name="x_quote_validity"/>
                                        </group>
                                        <group string="Totals">
                                            <field name="x_total_price" readonly="1"/>
                                            <field name="x_gst_amount" readonly="1"/>
                                            <field name="x_net_total" readonly="1"/>
                                        </group>
                                    </group>
                                    <group string="Commercial Terms">
                                        <group>
                                            <field name="x_payment_term_id"
                                                   string="Payment Terms"
                                                   options="{'no_create': True, 'no_open': True}"
                                                   placeholder="Select standard payment terms…"/>
                                            <field name="x_payment_terms"
                                                   string="Custom Payment Notes"
                                                   placeholder="Any extra payment conditions not covered above…"/>
                                            <field name="x_delivery_basis"/>
                                            <field name="x_delivery_period"
                                                   placeholder="e.g. 4–6 weeks"/>
                                        </group>
                                        <group>
                                            <field name="x_warranty"
                                                   placeholder="e.g. 12 months"/>
                                            <field name="x_brand_origin"
                                                   placeholder="e.g. Siemens, Local"/>
                                            <field name="x_tax_treatment"
                                                   placeholder="e.g. GST 17% extra"/>
                                            <field name="x_ancillary_included"/>
                                        </group>
                                    </group>
                                    <field name="x_line_ids" widget="one2many">
                                        <list editable="bottom">
                                            <field name="x_product_id" string="Product"/>
                                            <field name="x_uom_id" string="UoM" readonly="1"/>
                                            <field name="x_qty" string="Qty"/>
                                            <field name="x_unit_price" string="Unit Price"/>
                                            <field name="x_total_price" string="Total" readonly="1"/>
                                            <field name="x_gst_rate" string="GST %"/>
                                            <field name="x_gst_amount" string="GST Amt" readonly="1"/>
                                            <field name="x_net_price" string="Net" readonly="1"/>
                                            <field name="x_remarks" string="Remarks"/>
                                        </list>
                                    </field>
                                    <separator string="Vendor Quotation Documents"/>
                                    <field name="x_attachment_ids"
                                           widget="many2many_binary"
                                           string="Attached Quotation PDFs"/>
                                    <separator string="Additional Remarks"/>
                                    <field name="x_remarks" widget="text"
                                           placeholder="Any remarks for this vendor…"/>
                                </form>
                            </field>
                        </page>

                        <!-- ── Tab 3: Comparison Matrix ────────────────────── -->
                        <page string="Comparison Matrix" name="comparison_matrix">
                            <div class="mb-2 text-muted small">
                                Live cross-vendor price comparison.
                                Green cells = lowest rate for that product.
                                ★ column = selected winner.
                            </div>
                            <field name="x_comparison_html" widget="html" readonly="1"/>
                        </page>

                        <!-- ── Tab 4: Notes ────────────────────────────────── -->
                        <page string="Negotiation Notes" name="notes">
                            <field name="x_negotiation_notes" widget="html"
                                   placeholder="Record negotiation history, audit trail, reasons for vendor selection…"/>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — List View
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_cs_list" model="ir.ui.view">
        <field name="name">x.comparative.statement.list</field>
        <field name="model">x.comparative.statement</field>
        <field name="arch" type="xml">
            <list string="Comparative Statements"
                  decoration-success="x_state == 'confirmed'"
                  decoration-muted="x_state == 'draft'">
                <field name="name"/>
                <field name="x_purchase_order_id"/>
                <field name="x_recommended_vendor_id"/>
                <field name="x_state" widget="badge"
                       decoration-warning="x_state == 'draft'"
                       decoration-success="x_state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         COMPARATIVE STATEMENT — Action
         ════════════════════════════════════════════════════════════════ -->
    <record id="action_comparative_statement" model="ir.actions.act_window">
        <field name="name">Comparative Statements</field>
        <field name="res_model">x.comparative.statement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Comparative Statements yet
            </p>
            <p>
                Open a Purchase Requisition and click
                <strong>Comparative Statement</strong> to start comparing vendors.
            </p>
        </field>
    </record>

</odoo>
