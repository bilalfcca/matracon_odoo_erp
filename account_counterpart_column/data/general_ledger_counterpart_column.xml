<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- General Ledger: Counterpart Account column.
         Shows the account(s) that received the opposite debit/credit side of
         the same journal entry. Value computed in
         AccountGeneralLedgerReportHandler._report_custom_engine_general_ledger
         (models/account_general_ledger.py), reusing the same custom formula
         ("engine=custom") the report's other columns already use, so it goes
         through the report's normal screen/PDF/XLSX export pipeline with no
         extra work.

         A high sequence keeps it after all standard columns regardless of
         their (default 0) sequence, without touching any existing record. -->
    <record id="general_ledger_line_counterpart_account" model="account.report.expression">
        <field name="report_line_id" ref="account_reports.general_ledger_custom_engine_line"/>
        <field name="label">counterpart_account</field>
        <field name="engine">custom</field>
        <field name="formula">_report_custom_engine_general_ledger</field>
        <field name="subformula">counterpart_account</field>
    </record>

    <record id="general_ledger_report_counterpart_account" model="account.report.column">
        <field name="report_id" ref="account_reports.general_ledger_report"/>
        <field name="name">Counterpart Account</field>
        <field name="expression_label">counterpart_account</field>
        <field name="figure_type">string</field>
        <field name="sequence">70</field>
    </record>
</odoo>
