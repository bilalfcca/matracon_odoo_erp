<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal Items: Counterpart Account column.
         Hidden by default (optional="hide") so no existing screen changes
         appearance - users opt in via the list view's optional-columns
         toggle. This is a plain (non-primary) extension of the base
         "account.view_move_line_tree" view, so it automatically flows into
         every view that inherits it (the bank/cash, misc and sales/purchase
         grouped Journal Items lists), and therefore into the "Journal Items"
         drill-down opened from an account balance on the Trial Balance
         report (Accounting > Reporting > Ledgers > Trial Balance), as well
         as the main Accounting > Accounting > Journal Items menu. -->
    <record id="view_move_line_tree_counterpart_account" model="ir.ui.view">
        <field name="name">account.move.line.list.counterpart.account</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="x_counterpart_account_display" optional="hide" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
