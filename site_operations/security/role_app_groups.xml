<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ──────────────────────────────────────────────────────────────────────
             IMPORTANT: All implied_ids use (6, 0, [...]) to REPLACE (not just add)
             so that removing a group on upgrade actually takes effect.
             Each entry must list ALL groups the role needs — both Odoo functional
             groups AND our custom group_mtr_app_* visibility gates.
        ──────────────────────────────────────────────────────────────────────── -->

        <!-- Site Store: Purchase + Inventory + Fleet -->
        <!-- NOTE: group_mtr_app_fleet is added by matracon_fleet/security/app_visibility_fleet.xml
             via Command.link — it cannot be referenced here because matracon_fleet loads after site_operations. -->
        <record id="purchase_demand_raise.group_site_store" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('purchase.group_purchase_user'),
                    ref('stock.group_stock_user'),
                    ref('uom.group_uom'),
                    ref('base.group_allow_export'),
                    ref('group_mtr_app_purchase'),
                    ref('group_mtr_app_inventory'),
                ])
            ]"/>
        </record>

        <!-- Procurement Officer: Purchase + Inventory (admin) + Contacts + Accounting (manager) + Dashboard -->
        <!-- Full admin on all 5 apps: read/write/edit/delete any record.
             stock.group_stock_multi_locations + stock.group_stock_multi_warehouses
             allow seeing all site warehouses and locations in the Inventory app.
             account.group_account_manager gives complete Accounting access — standard Odoo
             ACLs for that group cover all existing and future accounting models automatically.
             Custom model ACLs for Accounting are granted via group_head_office (which all HO
             users hold alongside their role group) — see ir.model.access.csv additions below. -->
        <record id="purchase_demand_raise.group_procurement_ho" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('purchase.group_purchase_user'),
                    ref('purchase.group_purchase_manager'),
                    ref('stock.group_stock_user'),
                    ref('stock.group_stock_manager'),
                    ref('stock.group_stock_multi_locations'),
                    ref('stock.group_stock_multi_warehouses'),
                    ref('uom.group_uom'),
                    ref('account.group_account_manager'),
                    ref('base.group_partner_manager'),
                    ref('base.group_allow_export'),
                    ref('group_mtr_app_purchase'),
                    ref('group_mtr_app_inventory'),
                    ref('group_mtr_app_accounting'),
                    ref('group_mtr_app_contacts'),
                ])
            ]"/>
        </record>

        <!-- CEO: Purchase + Inventory + Contacts + Accounting (manager) + Attendance + Compliance + Fleet -->
        <!-- NOTE: group_mtr_app_fleet added by matracon_fleet/security/app_visibility_fleet.xml -->
        <!-- account.group_account_manager replaces the previous readonly+invoice pair — CEO needs
             full accounting authority (create payments, manage journals, etc.).
             stock groups give complete Inventory access; base.group_partner_manager gives Contacts;
             hr_attendance.group_hr_attendance_officer gives Attendance.
             All HO roles follow the "no site drafts" record rules defined in record_rules.xml —
             CEO sees only confirmed/posted records, which is correct. -->
        <record id="purchase_demand_raise.group_ceo_approval" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('purchase.group_purchase_manager'),
                    ref('stock.group_stock_user'),
                    ref('stock.group_stock_manager'),
                    ref('stock.group_stock_multi_locations'),
                    ref('stock.group_stock_multi_warehouses'),
                    ref('uom.group_uom'),
                    ref('account.group_account_manager'),
                    ref('base.group_partner_manager'),
                    ref('hr_attendance.group_hr_attendance_officer'),
                    ref('base.group_allow_export'),
                    ref('group_mtr_app_purchase'),
                    ref('group_mtr_app_inventory'),
                    ref('group_mtr_app_accounting'),
                    ref('group_mtr_app_contacts'),
                    ref('group_mtr_app_attendance'),
                    ref('group_mtr_app_compliance'),
                ])
            ]"/>
        </record>

        <!-- Site Accountant: Accounting + Attendance only (NO Employees, NO Payroll) -->
        <!-- hr_attendance.group_hr_attendance_officer transitively implies hr.group_hr_user -->
        <!-- so employees are accessible in attendance lines without seeing the HR app. -->
        <!-- group_account_user (Bookkeeper) is required so that site accountants can:
             - Confirm customer invoices and vendor bills (group_account_invoice)
             - Edit journal entry lines on invoices/bills
             - Access reporting menus: Partner Ledger, Aged Payables/Receivables,
               Balance Sheet, Trial Balance (group_account_readonly, implied by Bookkeeper)
             Bookkeeper (group_account_user) implies Read-only + Invoicing & Banks,
             which in turn implies Invoicing — so all billing + reporting access is covered.
             ir.rule record rules still scope the actual data to this site's analytic account. -->
        <!-- NOTE: group_mtr_app_fleet added by matracon_fleet/security/app_visibility_fleet.xml -->
        <record id="group_site_accountant" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('account.group_account_user'),
                    ref('hr_attendance.group_hr_attendance_officer'),
                    ref('base.group_allow_export'),
                    ref('group_mtr_app_accounting'),
                    ref('group_mtr_app_attendance'),
                ])
            ]"/>
        </record>

        <!-- Finance HO: Accounting + Employees + Payroll + Attendance + Compliance + Contacts + Fleet -->
        <!-- NOTE: group_mtr_app_fleet added by matracon_fleet/security/app_visibility_fleet.xml -->
        <record id="group_finance_ho" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('account.group_account_manager'),
                    ref('hr.group_hr_manager'),
                    ref('hr_attendance.group_hr_attendance_officer'),
                    ref('base.group_allow_export'),
                    ref('base.group_partner_manager'),
                    ref('group_mtr_app_accounting'),
                    ref('group_mtr_app_hr'),
                    ref('group_mtr_app_attendance'),
                    ref('group_mtr_app_payroll'),
                    ref('group_mtr_app_compliance'),
                    ref('group_mtr_app_contacts'),
                ])
            ]"/>
        </record>

        <!-- Matracon Admin: all apps + Settings + System (replaces purchase_demand_raise base implied_ids)
             base.group_system is intentionally included so that:
               - All ir.rule bypass rules keyed on base.group_system automatically apply
               - ACL rows that only grant base.group_system access are covered
               - Settings → Technical menus are accessible
               - Odoo treats this role as a true superadmin across every installed app -->
        <!-- NOTE: group_mtr_app_fleet added by matracon_fleet/security/app_visibility_fleet.xml -->
        <record id="purchase_demand_raise.group_matracon_admin" model="res.groups">
            <field name="implied_ids" eval="[
                (6, 0, [
                    ref('base.group_system'),
                    ref('purchase_demand_raise.group_head_office'),
                    ref('purchase_demand_raise.group_procurement_ho'),
                    ref('purchase_demand_raise.group_ceo_approval'),
                    ref('site_operations.group_finance_ho'),
                    ref('purchase.group_purchase_manager'),
                    ref('stock.group_stock_manager'),
                    ref('uom.group_uom'),
                    ref('account.group_account_manager'),
                    ref('project.group_project_manager'),
                    ref('base.group_partner_manager'),
                    ref('base.group_allow_export'),
                    ref('group_mtr_app_purchase'),
                    ref('group_mtr_app_inventory'),
                    ref('group_mtr_app_accounting'),
                    ref('group_mtr_app_project'),
                    ref('group_mtr_app_hr'),
                    ref('group_mtr_app_attendance'),
                    ref('group_mtr_app_payroll'),
                    ref('group_mtr_app_settings'),
                    ref('group_mtr_app_contacts'),
                    ref('group_mtr_app_compliance'),
                ])
            ]"/>
        </record>
    </data>
</odoo>
