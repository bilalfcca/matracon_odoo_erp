<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_liability_sheet_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="sheet">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ── Title ── -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2 style="font-weight:700; letter-spacing:1px;">
                                    LIABILITY SHEET
                                </h2>
                                <h4 style="color:#555;">
                                    <t t-esc="sheet.name"/>
                                </h4>
                            </div>
                        </div>

                        <!-- ── Header Info — Project, Period, PM only ── -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-sm" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;font-weight:600;">Project</td>
                                        <td><t t-esc="sheet.project_analytic_account_id.name or '-'"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:600;">Period</td>
                                        <td>
                                            <t t-esc="sheet.date_from.strftime('%d/%m/%Y') if sheet.date_from else '-'"/>
                                            &#160;to&#160;
                                            <t t-esc="sheet.date_to.strftime('%d/%m/%Y') if sheet.date_to else '-'"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm" style="font-size:13px;">
                                    <tr>
                                        <td style="width:45%;font-weight:600;">Project Manager</td>
                                        <td><t t-esc="sheet.pm_id.name or '-'"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ── Common sets ── -->
                        <t t-set="selected_lines"        t-value="sheet.line_ids.filtered(lambda l: l.is_selected)"/>
                        <t t-set="all_lines"             t-value="sheet.line_ids"/>
                        <t t-set="show_approved"         t-value="sheet.state in ('approved', 'paid')"/>
                        <t t-set="is_overall"            t-value="sheet.x_report_filter == 'overall'"/>

                        <!-- ════════════════════════════════════════════
                             PERIOD VIEW  (Selected Period filter)
                        ════════════════════════════════════════════ -->
                        <t t-if="not is_overall">
                            <t t-set="sel_total_liability"   t-value="sum(l.liability_amount   for l in selected_lines)"/>
                            <t t-set="sel_total_recommended" t-value="sum(l.recommended_amount for l in selected_lines)"/>
                            <t t-set="sel_total_approved"    t-value="sum(l.approved_amount    for l in selected_lines)"/>

                            <!-- Summary Boxes -->
                            <div class="row mb-1">
                                <div class="col-12">
                                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#6c757d; letter-spacing:0.6px; border-bottom:1px solid #dee2e6; padding-bottom:3px; margin-bottom:6px;">
                                        This Sheet Totals — Period:
                                        <t t-esc="sheet.date_from.strftime('%d/%m/%Y') if sheet.date_from else ''"/>
                                        to
                                        <t t-esc="sheet.date_to.strftime('%d/%m/%Y') if sheet.date_to else ''"/>
                                    </div>
                                </div>
                            </div>
                            <t t-if="show_approved">
                                <div class="row mb-4 text-center">
                                    <div class="col-4">
                                        <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px; background:#f8f9fa;">
                                            <div style="font-size:11px; color:#6c757d; text-transform:uppercase; font-weight:600;">Total Liability</div>
                                            <div style="font-size:16px; font-weight:700;"><t t-esc="'{:,.0f}'.format(sel_total_liability)"/></div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px; background:#fff3cd;">
                                            <div style="font-size:11px; color:#6c757d; text-transform:uppercase; font-weight:600;">Recommended</div>
                                            <div style="font-size:16px; font-weight:700;"><t t-esc="'{:,.0f}'.format(sel_total_recommended)"/></div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div style="border:1px solid #198754; border-radius:4px; padding:8px; background:#d1e7dd;">
                                            <div style="font-size:11px; color:#146c43; text-transform:uppercase; font-weight:600;">&#10003; Approved</div>
                                            <div style="font-size:16px; font-weight:700; color:#0a3622;"><t t-esc="'{:,.0f}'.format(sel_total_approved)"/></div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="row mb-4 text-center">
                                    <div class="col-6">
                                        <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px; background:#f8f9fa;">
                                            <div style="font-size:11px; color:#6c757d; text-transform:uppercase; font-weight:600;">Total Liability</div>
                                            <div style="font-size:16px; font-weight:700;"><t t-esc="'{:,.0f}'.format(sel_total_liability)"/></div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px; background:#fff3cd;">
                                            <div style="font-size:11px; color:#6c757d; text-transform:uppercase; font-weight:600;">Recommended</div>
                                            <div style="font-size:16px; font-weight:700;"><t t-esc="'{:,.0f}'.format(sel_total_recommended)"/></div>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- Period Lines Table -->
                            <table class="table table-sm table-bordered" style="font-size:12px;">
                                <thead>
                                    <tr style="background:#c0392b; color:#fff;">
                                        <th class="text-center" style="width:4%;">#</th>
                                        <th t-attf-style="width:#{show_approved and '18%' or '22%'};">Vendor / Partner</th>
                                        <th t-attf-style="width:#{show_approved and '18%' or '22%'};">Description</th>
                                        <th class="text-right" t-attf-style="width:#{show_approved and '11%' or '13%'};">Opening Balance</th>
                                        <th class="text-right" t-attf-style="width:#{show_approved and '11%' or '13%'};">New Liability</th>
                                        <th class="text-right" t-attf-style="width:#{show_approved and '11%' or '13%'};">Total Liability</th>
                                        <th class="text-right" t-attf-style="width:#{show_approved and '13%' or '13%'};">Recommended</th>
                                        <th t-if="show_approved" class="text-right" style="width:14%; background:#145a32;">Approved</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="selected_lines" t-as="line">
                                        <tr t-attf-style="background:#{line_index % 2 == 0 and '#f8f9fa' or '#fff'}">
                                            <td class="text-center"><t t-esc="line_index + 1"/></td>
                                            <td style="font-weight:500;"><t t-esc="line.partner_id.name or '-'"/></td>
                                            <td><t t-esc="line.description or '-'"/></td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(line.opening_balance)"/></td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(line.new_liability)"/></td>
                                            <td class="text-right" style="font-weight:600;"><t t-esc="'{:,.0f}'.format(line.liability_amount)"/></td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(line.recommended_amount)"/></td>
                                            <td t-if="show_approved" class="text-right" style="font-weight:700; color:#0a3622;">
                                                <t t-esc="'{:,.0f}'.format(line.approved_amount)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="background:#e9ecef; font-weight:700; border-top:2px solid #adb5bd;">
                                        <td colspan="5" class="text-right" style="font-size:12px;">TOTALS</td>
                                        <td class="text-right"><t t-esc="'{:,.0f}'.format(sel_total_liability)"/></td>
                                        <td class="text-right"><t t-esc="'{:,.0f}'.format(sel_total_recommended)"/></td>
                                        <td t-if="show_approved" class="text-right" style="color:#0a3622;">
                                            <t t-esc="'{:,.0f}'.format(sel_total_approved)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ════════════════════════════════════════════
                             OVERALL VIEW  (Overall filter)
                        ════════════════════════════════════════════ -->
                        <t t-if="is_overall">
                            <t t-set="ov_bills"    t-value="sum(l.x_overall_total_bills    for l in all_lines)"/>
                            <t t-set="ov_approved" t-value="sum(l.x_overall_total_approved for l in all_lines)"/>
                            <t t-set="ov_paid"     t-value="sum(l.x_overall_total_paid     for l in all_lines)"/>
                            <t t-set="ov_net"      t-value="sum(l.x_overall_net_outstanding for l in all_lines)"/>

                            <!-- Summary Boxes -->
                            <div class="row mb-1">
                                <div class="col-12">
                                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:#6c757d; letter-spacing:0.6px; border-bottom:1px solid #dee2e6; padding-bottom:3px; margin-bottom:6px;">
                                        Overall Totals — All Time (Project: <t t-esc="sheet.project_analytic_account_id.name or '-'"/>)
                                    </div>
                                </div>
                            </div>
                            <div class="row mb-4 text-center">
                                <div class="col-3">
                                    <div style="border:1px solid #dee2e6; border-radius:4px; padding:8px; background:#f8f9fa;">
                                        <div style="font-size:10px; color:#6c757d; text-transform:uppercase; font-weight:600;">Total Bills</div>
                                        <div style="font-size:15px; font-weight:700;"><t t-esc="'{:,.0f}'.format(ov_bills)"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div style="border:1px solid #0d6efd; border-radius:4px; padding:8px; background:#cfe2ff;">
                                        <div style="font-size:10px; color:#084298; text-transform:uppercase; font-weight:600;">Total Approved</div>
                                        <div style="font-size:15px; font-weight:700; color:#084298;"><t t-esc="'{:,.0f}'.format(ov_approved)"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div style="border:1px solid #198754; border-radius:4px; padding:8px; background:#d1e7dd;">
                                        <div style="font-size:10px; color:#146c43; text-transform:uppercase; font-weight:600;">Total Paid</div>
                                        <div style="font-size:15px; font-weight:700; color:#0a3622;"><t t-esc="'{:,.0f}'.format(ov_paid)"/></div>
                                    </div>
                                </div>
                                <div class="col-3">
                                    <div style="border:1px solid #dc3545; border-radius:4px; padding:8px; background:#f8d7da;">
                                        <div style="font-size:10px; color:#842029; text-transform:uppercase; font-weight:600;">Net Outstanding</div>
                                        <div style="font-size:15px; font-weight:700; color:#842029;"><t t-esc="'{:,.0f}'.format(ov_net)"/></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Overall Lines Table — all vendors on the sheet -->
                            <table class="table table-sm table-bordered" style="font-size:12px;">
                                <thead>
                                    <tr style="background:#1a3a5c; color:#fff;">
                                        <th class="text-center" style="width:4%;">#</th>
                                        <th style="width:22%;">Vendor / Partner</th>
                                        <th style="width:18%;">Description</th>
                                        <th class="text-right" style="width:14%;">Total Bills (All Time)</th>
                                        <th class="text-right" style="width:14%;">Total Approved</th>
                                        <th class="text-right" style="width:14%;">Total Paid (All Time)</th>
                                        <th class="text-right" style="width:14%; background:#5a1a1a;">Net Outstanding</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="all_lines" t-as="line">
                                        <tr t-attf-style="background:#{line_index % 2 == 0 and '#f8f9fa' or '#fff'}">
                                            <td class="text-center"><t t-esc="line_index + 1"/></td>
                                            <td style="font-weight:500;"><t t-esc="line.partner_id.name or '-'"/></td>
                                            <td><t t-esc="line.description or '-'"/></td>
                                            <td class="text-right"><t t-esc="'{:,.0f}'.format(line.x_overall_total_bills)"/></td>
                                            <td class="text-right" style="color:#084298; font-weight:600;">
                                                <t t-esc="'{:,.0f}'.format(line.x_overall_total_approved)"/>
                                            </td>
                                            <td class="text-right" style="color:#0a3622; font-weight:600;">
                                                <t t-esc="'{:,.0f}'.format(line.x_overall_total_paid)"/>
                                            </td>
                                            <td class="text-right" style="font-weight:700; color:#842029;">
                                                <t t-esc="'{:,.0f}'.format(line.x_overall_net_outstanding)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr style="background:#e9ecef; font-weight:700; border-top:2px solid #adb5bd;">
                                        <td colspan="3" class="text-right" style="font-size:12px;">TOTALS</td>
                                        <td class="text-right"><t t-esc="'{:,.0f}'.format(ov_bills)"/></td>
                                        <td class="text-right" style="color:#084298;"><t t-esc="'{:,.0f}'.format(ov_approved)"/></td>
                                        <td class="text-right" style="color:#0a3622;"><t t-esc="'{:,.0f}'.format(ov_paid)"/></td>
                                        <td class="text-right" style="color:#842029;"><t t-esc="'{:,.0f}'.format(ov_net)"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ── Signature Block ── -->
                        <t t-set="_ls_prep" t-value="sheet.sudo().create_uid"/>
                        <t t-set="_ls_ceo"  t-value="sheet.sudo().x_ceo_approved_by_id"/>
                        <div class="row mt-5">
                            <!-- Prepared By -->
                            <div class="col-4 text-center">
                                <div style="height:60px; display:flex; align-items:flex-end; justify-content:center; padding-bottom:2px;">
                                    <t t-if="_ls_prep and _ls_prep.x_sign_signature">
                                        <img t-att-src="image_data_uri(_ls_prep.x_sign_signature)"
                                             style="max-height:55px; max-width:150px; object-fit:contain;"/>
                                    </t>
                                </div>
                                <div style="border-top:2px solid #000; padding-top:8px;">
                                    <div style="font-weight:700; font-size:13px;">Prepared By</div>
                                    <t t-if="_ls_prep">
                                        <div style="font-size:11px; color:#374151; margin-top:12px; font-weight:600;"><t t-esc="_ls_prep.name"/></div>
                                    </t>
                                    <!-- No blank "Name: ___" placeholder when unsigned. -->
                                </div>
                            </div>
                            <!-- Checked By -->
                            <div class="col-4 text-center">
                                <div style="height:60px;"></div>
                                <div style="border-top:2px solid #000; padding-top:8px;">
                                    <div style="font-weight:700; font-size:13px;">Checked By</div>
                                </div>
                            </div>
                            <!-- Approved By: CEO digital sig, or PM signed stamp, or blank -->
                            <div class="col-4 text-center">
                                <t t-if="_ls_ceo and _ls_ceo.x_sign_signature">
                                    <!-- CEO has a saved digital signature -->
                                    <div style="height:60px; display:flex; align-items:flex-end; justify-content:center; padding-bottom:2px;">
                                        <img t-att-src="image_data_uri(_ls_ceo.x_sign_signature)"
                                             style="max-height:55px; max-width:150px; object-fit:contain;"/>
                                    </div>
                                    <div style="border-top:2px solid #198754; padding-top:8px;">
                                        <div style="font-weight:700; font-size:13px; color:#198754;">&#10003; Approved By</div>
                                        <div style="font-size:11px; color:#374151; margin-top:4px; font-weight:600;"><t t-esc="_ls_ceo.name"/></div>
                                    </div>
                                </t>
                                <t t-elif="sheet.pm_is_signed">
                                    <!-- Legacy: PM signed upload (no digital sig) -->
                                    <div style="height:60px;"></div>
                                    <div style="border-top:2px solid #198754; padding-top:8px;">
                                        <div style="font-weight:700; font-size:13px; color:#198754;">&#10003; Approved By</div>
                                        <div style="font-size:11px; color:#198754; margin-top:4px;">
                                            <t t-esc="sheet.pm_id.name or ''"/>
                                        </div>
                                        <div style="font-size:10px; color:#6c757d; margin-top:6px;">
                                            Signed: <t t-esc="sheet.pm_signature_date.strftime('%d/%m/%Y %H:%M') if sheet.pm_signature_date else ''"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="height:60px;"></div>
                                    <div style="border-top:2px solid #000; padding-top:8px;">
                                        <div style="font-weight:700; font-size:13px;">Approved By</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
