<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Shared signature block templates used by all Matracon print documents.

        DIGITAL SIGNATURE SUPPORT
        ─────────────────────────
        Each template accepts optional context variables (set via t-call child
        t-set nodes or before the call):

            sig_prepared_user  — res.users record for "Prepared By" column
            sig_checked_user   — res.users record for "Checked By" column
            sig_approved_user  — res.users record for "Approved By" column
            sig_received_user  — res.users record for extra/4th column (rarely used)

        When a variable is set AND the user has x_sign_signature set, the
        signature image is rendered above the line; the Name is auto-filled.
        When no variable is set (nobody signed yet): just the blank line +
        label — no "Name: ___" placeholder underneath (removed 2026-09, was
        printing on every unsigned slot with no signature above it).

        Calling convention (signature vars inside t-call so they stay scoped):

            <t t-call="site_operations.report_sig_3col">
                <t t-set="sig_prepared_user" t-value="doc.sudo().create_uid"/>
                <t t-set="sig_approved_user" t-value="doc.sudo().x_ceo_approved_by_id"/>
            </t>

        Or for 4-col with extra_label:
            <t t-call="site_operations.report_sig_4col">
                <t t-set="extra_label">Received By</t>
                <t t-set="sig_prepared_user" t-value="doc.sudo().create_uid"/>
            </t>

        Convention (column meanings):
            3-col: Prepared By | Checked By | Approved By
            4-col: Prepared By | Checked By | Approved By | [extra_label]
                   where extra_label = "Received By" or "Return By"
    -->

    <!-- ── Helper macro: one signature column ──────────────────────────────── -->
    <!--
        Renders a single signature column cell.
        Variables consumed:  _sc_user, _sc_label, _sc_col_class, _sc_height
    -->
    <template id="report_sig_col">
        <div t-attf-class="#{_sc_col_class or 'col-4'} text-center">
            <!-- Signature image area (height = space above line) -->
            <div t-attf-style="display:table; width:100%; height:#{_sc_height or '60'}px;">
                <div style="display:table-cell; vertical-align:bottom; text-align:center; padding-bottom:2px;">
                    <t t-if="_sc_user and _sc_user.x_sign_signature">
                        <img t-att-src="image_data_uri(_sc_user.x_sign_signature)"
                             t-attf-style="max-height:#{(_sc_height or 60) - 8}px; max-width:150px; object-fit:contain;"/>
                    </t>
                </div>
            </div>
            <!-- Line + label + name -->
            <div style="border-top:2px solid #000; padding-top:8px;">
                <div style="font-weight:700; font-size:13px;"><t t-esc="_sc_label or 'Signed By'"/></div>
                <t t-if="_sc_user">
                    <div style="font-size:11px; color:#374151; margin-top:12px; font-weight:600;">
                        <t t-esc="_sc_user.name"/>
                    </div>
                </t>
                <!-- No blank "Name: ___" placeholder when unsigned — the empty
                     line + label above is the signature slot; nothing is printed
                     underneath until someone actually signs. -->
            </div>
        </div>
    </template>

    <!-- ── 3-column block ───────────────────────────────────────────────── -->
    <template id="report_sig_3col">
        <div class="row mt-5">
            <!-- Prepared By -->
            <t t-set="_sc_user"      t-value="sig_prepared_user or False"/>
            <t t-set="_sc_label"     t-value="'Prepared By'"/>
            <t t-set="_sc_col_class" t-value="'col-4'"/>
            <t t-set="_sc_height"    t-value="60"/>
            <t t-call="site_operations.report_sig_col"/>

            <!-- Checked By -->
            <t t-set="_sc_user"  t-value="sig_checked_user or False"/>
            <t t-set="_sc_label" t-value="'Checked By'"/>
            <t t-call="site_operations.report_sig_col"/>

            <!-- Approved By -->
            <t t-set="_sc_user"  t-value="sig_approved_user or False"/>
            <t t-set="_sc_label" t-value="'Approved By'"/>
            <t t-call="site_operations.report_sig_col"/>
        </div>
    </template>

    <!-- ── 4-column block ───────────────────────────────────────────────── -->
    <template id="report_sig_4col">
        <div class="row mt-5">
            <!-- Prepared By -->
            <t t-set="_sc_user"      t-value="sig_prepared_user or False"/>
            <t t-set="_sc_label"     t-value="'Prepared By'"/>
            <t t-set="_sc_col_class" t-value="'col-3'"/>
            <t t-set="_sc_height"    t-value="60"/>
            <t t-call="site_operations.report_sig_col"/>

            <!-- Checked By -->
            <t t-set="_sc_user"  t-value="sig_checked_user or False"/>
            <t t-set="_sc_label" t-value="'Checked By'"/>
            <t t-call="site_operations.report_sig_col"/>

            <!-- Approved By -->
            <t t-set="_sc_user"  t-value="sig_approved_user or False"/>
            <t t-set="_sc_label" t-value="'Approved By'"/>
            <t t-call="site_operations.report_sig_col"/>

            <!-- Extra column (Received By / Return By — typically no tracked user) -->
            <t t-set="_sc_user"  t-value="sig_received_user or False"/>
            <t t-set="_sc_label" t-value="extra_label or 'Received By'"/>
            <t t-call="site_operations.report_sig_col"/>
        </div>
    </template>


    <!-- report_sig_4col_labels (a second, hand-duplicated 4-column implementation)
         was removed 2026-09 — it had zero callers (Bank Payment Voucher and Journal
         Entry Voucher hand-copied their own blank markup instead of calling either
         macro). Both now call report_sig_4col above, the one already proven in
         production by Petty Cash Expense, Cheque Print, MIF, Gate Pass and MTN. -->

</odoo>
