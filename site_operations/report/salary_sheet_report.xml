<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ──────────────────────────────────────────────────────────────────────
         Paper format: A4 Landscape with narrow margins for the disbursement table
    ─────────────────────────────────────────────────────────────────────────── -->
    <record id="paperformat_salary_sheet_landscape" model="report.paperformat">
        <field name="name">Salary Sheet (Landscape A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report action — binds to x.salary.sheet, landscape paper format -->
    <record id="action_report_salary_sheet" model="ir.actions.report">
        <field name="name">Salary Sheet</field>
        <field name="model">x.salary.sheet</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">site_operations.report_salary_sheet_document</field>
        <field name="report_file">site_operations.report_salary_sheet_document</field>
        <field name="print_report_name">'Salary Sheet - ' + (object.name or '')</field>
        <field name="binding_model_id" ref="model_x_salary_sheet"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_salary_sheet_landscape"/>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN TEMPLATE
         Part 1 — Department-wise Salary Disbursement Table  (landscape)
         Part 2 — Individual Salary Receipt / Acknowledgment Slips  (2 per row)
    ════════════════════════════════════════════════════════════════════════ -->
    <template id="report_salary_sheet_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="sheet">
                <div class="page">
                    <style>
                        /* ── Global reset for salary report ── */
                        * { box-sizing: border-box; margin: 0; padding: 0; }
                        body { font-family: Arial, sans-serif; font-size: 8px; color: #000; }

                        /* ── Page heading ── */
                        .sal-heading { text-align: center; margin-bottom: 8px; }
                        .sal-heading .co-name {
                            font-size: 14px; font-weight: 700; letter-spacing: 0.5px;
                            text-transform: uppercase; margin-bottom: 2px;
                        }
                        .sal-heading .proj-name { font-size: 11px; font-weight: 600; color: #1a3a5c; margin-bottom: 1px; }
                        .sal-heading .period    { font-size: 9px; color: #555; }

                        /* ── Main disbursement table ── */
                        table.sal-tbl { width: 100%; border-collapse: collapse; font-size: 7.5px; }
                        table.sal-tbl th,
                        table.sal-tbl td {
                            border: 0.5px solid #888;
                            padding: 2px 2px;
                            vertical-align: middle;
                        }
                        table.sal-tbl thead tr th {
                            background-color: #1a3a5c;
                            color: #fff;
                            font-weight: 700;
                            text-align: center;
                            font-size: 7px;
                            line-height: 1.2;
                        }
                        tr.dept-row td {
                            background-color: #FFE600 !important;
                            font-weight: 700;
                            font-size: 8px;
                            padding: 3px 4px;
                        }
                        tr.sub-row td {
                            background-color: #e0e4ed !important;
                            font-weight: 700;
                            font-size: 7.5px;
                        }
                        tr.grand-row td {
                            background-color: #1a3a5c !important;
                            color: #fff !important;
                            font-weight: 700;
                            font-size: 8px;
                        }
                        .tr  { text-align: right  !important; }
                        .tc  { text-align: center !important; }
                        .tl  { text-align: left   !important; }
                        .sig-empty { height: 28px; }

                        /* ── Approval signature block ── */
                        .approval-row {
                            display: flex;
                            justify-content: space-around;
                            margin-top: 18px;
                        }
                        .approval-col {
                            width: 28%;
                            text-align: center;
                        }
                        .approval-col .sig-space { height: 30px; }
                        .approval-col .sig-label {
                            border-top: 1px solid #000;
                            padding-top: 3px;
                            font-size: 9px;
                            font-weight: 700;
                        }

                        /* ── Receipt slips section ── */
                        .slip-break { page-break-before: always; }
                        .slip-title {
                            font-size: 12px;
                            font-weight: 700;
                            text-align: center;
                            color: #1a3a5c;
                            border-bottom: 2px solid #1a3a5c;
                            padding-bottom: 5px;
                            margin-bottom: 10px;
                        }
                        .slip-grid {
                            display: flex;
                            flex-wrap: wrap;
                            gap: 7px;
                        }
                        .slip-card {
                            width: calc(50% - 4px);
                            border: 1.5px solid #444;
                            border-radius: 3px;
                            padding: 7px 8px;
                            font-size: 8.5px;
                            page-break-inside: avoid;
                            break-inside: avoid;
                        }
                        .slip-card-head {
                            display: flex;
                            justify-content: space-between;
                            align-items: baseline;
                            border-bottom: 1.5px solid #1a3a5c;
                            padding-bottom: 4px;
                            margin-bottom: 5px;
                        }
                        .slip-emp-name { font-size: 10px; font-weight: 700; }
                        .slip-emp-job  { font-size: 8px; color: #555; }

                        .slip-info-grid {
                            display: flex;
                            gap: 10px;
                            margin-bottom: 5px;
                        }
                        .slip-info-col { flex: 1; }
                        .slip-info-row { display: flex; margin-bottom: 1px; }
                        .slip-lbl { color: #555; min-width: 75px; font-size: 7.5px; }
                        .slip-val { font-size: 7.5px; font-weight: 600; }

                        .slip-amounts {
                            display: flex;
                            border: 1px solid #bbb;
                            margin-bottom: 5px;
                            border-radius: 2px;
                            overflow: hidden;
                        }
                        .slip-amt {
                            flex: 1;
                            padding: 3px 4px;
                            text-align: center;
                            border-right: 1px solid #bbb;
                            font-size: 7.5px;
                        }
                        .slip-amt:last-child { border-right: none; }
                        .slip-amt .sa-lbl { color: #666; font-size: 7px; display: block; }
                        .slip-amt .sa-val { font-size: 9.5px; font-weight: 700; }
                        .slip-amt-net {
                            background-color: #1a3a5c !important;
                            color: #fff !important;
                        }
                        .slip-amt-net .sa-lbl { color: #ccc !important; }

                        .slip-ack {
                            font-size: 8px;
                            color: #222;
                            margin-bottom: 6px;
                            line-height: 1.35;
                        }
                        .slip-sig-row {
                            display: flex;
                            align-items: flex-end;
                            gap: 8px;
                            margin-top: 4px;
                        }
                        .slip-sig-line {
                            flex: 1;
                            border-top: 1px solid #333;
                            padding-top: 2px;
                            font-size: 7px;
                            color: #555;
                            text-align: center;
                        }
                        .slip-thumb {
                            width: 42px;
                            height: 36px;
                            border: 1px solid #aaa;
                            display: flex;
                            flex-direction: column;
                            align-items: center;
                            justify-content: center;
                            font-size: 6.5px;
                            color: #aaa;
                            border-radius: 1px;
                        }
                    </style>

                    <!-- ════════════════════════════════════════════════════════
                         PART 1 — SALARY DISBURSEMENT TABLE
                    ════════════════════════════════════════════════════════ -->

                    <!-- Page heading -->
                    <div class="sal-heading">
                        <div class="co-name">Matracon Pakistan (Pvt) Limited</div>
                        <div class="proj-name">
                            <t t-esc="sheet.project_analytic_account_id.name or 'Head Office'"/>
                        </div>
                        <div class="period">
                            Salary Disbursement Sheet
                            &#160;|&#160;
                            <t t-esc="sheet.date_from.strftime('%B %Y') if sheet.date_from else sheet.name"/>
                        </div>
                    </div>

                    <!-- Department-wise salary table -->
                    <t t-set="dept_groups" t-value="sheet._lines_by_department()"/>

                    <!-- Grand total accumulators (accumulated across departments) -->
                    <t t-set="g_count" t-value="0"/>
                    <t t-set="g_basic" t-value="0"/>
                    <t t-set="g_allow" t-value="0"/>
                    <t t-set="g_gross" t-value="0"/>
                    <t t-set="g_adv"   t-value="0"/>
                    <t t-set="g_net"   t-value="0"/>

                    <table class="sal-tbl">
                        <thead>
                            <tr>
                                <th style="width:3%;">Sr.<br/>No</th>
                                <th style="width:11%;">Name</th>
                                <th style="width:9%;">Father Name</th>
                                <th style="width:7%;">Designation</th>
                                <th style="width:8%;">Mobile No.</th>
                                <th style="width:7%;">Salary<br/>Per Month</th>
                                <th style="width:6%;">Allow-<br/>ance</th>
                                <th style="width:6%;">Date of<br/>Joining</th>
                                <th style="width:6%;">Date of<br/>Leaving</th>
                                <th style="width:3%;">Days</th>
                                <th style="width:7%;">Gross<br/>Salary</th>
                                <th style="width:6%;">Advan-<br/>ces</th>
                                <th style="width:7%;">Net Salary<br/>Amount</th>
                                <th style="width:14%;">Signature</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="dept_groups" t-as="dept_group">

                                <!-- Yellow department header row -->
                                <tr class="dept-row">
                                    <td colspan="14"><t t-esc="dept_group[0]"/></td>
                                </tr>

                                <!-- Per-department accumulators -->
                                <t t-set="d_sr"    t-value="0"/>
                                <t t-set="d_basic" t-value="0"/>
                                <t t-set="d_allow" t-value="0"/>
                                <t t-set="d_gross" t-value="0"/>
                                <t t-set="d_adv"   t-value="0"/>
                                <t t-set="d_net"   t-value="0"/>
                                <t t-set="d_count" t-value="0"/>

                                <!-- Employee rows -->
                                <t t-foreach="dept_group[1]" t-as="line">
                                    <t t-set="d_sr"    t-value="d_sr + 1"/>
                                    <t t-set="emp"     t-value="line.employee_id.sudo()"/>
                                    <t t-set="ln_gross" t-value="line.basic_salary + line.allowances"/>
                                    <t t-set="d_basic" t-value="d_basic + line.detail_basic_full"/>
                                    <t t-set="d_allow" t-value="d_allow + line.allowances"/>
                                    <t t-set="d_gross" t-value="d_gross + ln_gross"/>
                                    <t t-set="d_adv"   t-value="d_adv   + line.detail_advance"/>
                                    <t t-set="d_net"   t-value="d_net   + line.net_payable"/>
                                    <t t-set="d_count" t-value="d_count + 1"/>
                                    <tr>
                                        <td class="tc"><t t-esc="d_sr"/></td>
                                        <td><t t-esc="emp.name"/></td>
                                        <td><t t-esc="emp.x_father_name or ''"/></td>
                                        <td><t t-esc="emp.job_id.name or ''"/></td>
                                        <td><t t-esc="emp.mobile_phone or ''"/></td>
                                        <td class="tr">
                                            <t t-esc="'{:,.0f}'.format(line.detail_basic_full) if line.detail_basic_full else '—'"/>
                                        </td>
                                        <td class="tr">
                                            <t t-esc="'{:,.0f}'.format(line.allowances) if line.allowances else ''"/>
                                        </td>
                                        <td class="tc">
                                            <t t-esc="emp.date_start.strftime('%d-%b-%y') if emp.date_start else ''"/>
                                        </td>
                                        <td class="tc">
                                            <t t-esc="emp.date_end.strftime('%d-%b-%y') if emp.date_end else ''"/>
                                        </td>
                                        <td class="tc">
                                            <t t-esc="'{:.0f}'.format(line.paid_days)"/>
                                        </td>
                                        <td class="tr">
                                            <t t-esc="'{:,.0f}'.format(ln_gross)"/>
                                        </td>
                                        <td class="tr">
                                            <t t-esc="'{:,.0f}'.format(line.detail_advance) if line.detail_advance else ''"/>
                                        </td>
                                        <td class="tr" style="font-weight:700;">
                                            <t t-esc="'{:,.0f}'.format(line.net_payable)"/>
                                        </td>
                                        <td class="sig-empty"></td>
                                    </tr>
                                </t>

                                <!-- Accumulate into grand totals BEFORE rendering sub-row
                                     (QWeb evaluates t-set left-to-right inline) -->
                                <t t-set="g_count" t-value="g_count + d_count"/>
                                <t t-set="g_basic" t-value="g_basic + d_basic"/>
                                <t t-set="g_allow" t-value="g_allow + d_allow"/>
                                <t t-set="g_gross" t-value="g_gross + d_gross"/>
                                <t t-set="g_adv"   t-value="g_adv   + d_adv"/>
                                <t t-set="g_net"   t-value="g_net   + d_net"/>

                                <!-- Sub-Total row for the department -->
                                <tr class="sub-row">
                                    <td colspan="4" class="tc">Sub Total</td>
                                    <td class="tc"><t t-esc="d_count"/></td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(d_basic)"/></td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(d_allow)"/></td>
                                    <td colspan="3"></td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(d_gross)"/></td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(d_adv) if d_adv else ''"/></td>
                                    <td class="tr"><t t-esc="'{:,.0f}'.format(d_net)"/></td>
                                    <td></td>
                                </tr>

                            </t>
                        </tbody>

                        <!-- Grand Total -->
                        <tfoot>
                            <tr class="grand-row">
                                <td colspan="4" class="tc">TOTAL AMOUNT</td>
                                <td class="tc"><t t-esc="g_count"/></td>
                                <td class="tr"><t t-esc="'{:,.0f}'.format(g_basic)"/></td>
                                <td class="tr"><t t-esc="'{:,.0f}'.format(g_allow)"/></td>
                                <td colspan="3"></td>
                                <td class="tr"><t t-esc="'{:,.0f}'.format(g_gross)"/></td>
                                <td class="tr"><t t-esc="'{:,.0f}'.format(g_adv) if g_adv else ''"/></td>
                                <td class="tr"><t t-esc="'{:,.0f}'.format(g_net)"/></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ── Approval Signatures ───────────────────────────────── -->
                    <div class="approval-row">
                        <div class="approval-col">
                            <div class="sig-space"></div>
                            <div class="sig-label">ACCOUNTS MANAGER</div>
                        </div>
                        <div class="approval-col">
                            <div class="sig-space"></div>
                            <div class="sig-label">VERIFIED BY PM</div>
                        </div>
                        <div class="approval-col">
                            <div class="sig-space"></div>
                            <div class="sig-label">APPROVED BY CEO</div>
                        </div>
                    </div>

                    <!-- ════════════════════════════════════════════════════════
                         PART 2 — INDIVIDUAL SALARY RECEIPT / ACKNOWLEDGMENT SLIPS
                         Printed after the disbursement table; site accountant
                         collects one signed slip per employee as proof of receipt.
                         Layout: 2 slips per row × N rows (landscape A4).
                    ════════════════════════════════════════════════════════ -->
                    <div class="slip-break">
                        <div class="slip-title">
                            SALARY RECEIPT / ACKNOWLEDGMENT SLIPS
                            —
                            <t t-esc="sheet.date_from.strftime('%B %Y') if sheet.date_from else sheet.name"/>
                            &#160;|&#160;
                            <t t-esc="sheet.project_analytic_account_id.name or 'Head Office'"/>
                        </div>

                        <div class="slip-grid">
                            <t t-foreach="sheet.line_ids" t-as="line">
                                <t t-set="emp" t-value="line.employee_id.sudo()"/>
                                <t t-set="sl_gross" t-value="line.basic_salary + line.allowances"/>

                                <div class="slip-card">
                                    <!-- Slip header: name + designation -->
                                    <div class="slip-card-head">
                                        <span class="slip-emp-name">
                                            <t t-esc="emp.name"/>
                                        </span>
                                        <span class="slip-emp-job">
                                            <t t-esc="emp.job_id.name or ''"/>
                                            <t t-if="emp.department_id">
                                                ·
                                                <t t-esc="emp.department_id.name"/>
                                            </t>
                                        </span>
                                    </div>

                                    <!-- Employee info: 2-column grid -->
                                    <div class="slip-info-grid">
                                        <div class="slip-info-col">
                                            <div class="slip-info-row">
                                                <span class="slip-lbl">Father Name:</span>
                                                <span class="slip-val">
                                                    <t t-esc="emp.x_father_name or '—'"/>
                                                </span>
                                            </div>
                                            <div class="slip-info-row">
                                                <span class="slip-lbl">Mobile:</span>
                                                <span class="slip-val">
                                                    <t t-esc="emp.mobile_phone or '—'"/>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="slip-info-col">
                                            <div class="slip-info-row">
                                                <span class="slip-lbl">CNIC:</span>
                                                <span class="slip-val">
                                                    <t t-esc="emp.x_cnic or '—'"/>
                                                </span>
                                            </div>
                                            <div class="slip-info-row">
                                                <span class="slip-lbl">Days Worked:</span>
                                                <span class="slip-val">
                                                    <t t-esc="'{:.0f}'.format(line.paid_days)"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Amount breakdown bar -->
                                    <div class="slip-amounts">
                                        <div class="slip-amt">
                                            <span class="sa-lbl">Gross Salary</span>
                                            <span class="sa-val">
                                                <t t-esc="'{:,.0f}'.format(sl_gross)"/>
                                            </span>
                                        </div>
                                        <div class="slip-amt">
                                            <span class="sa-lbl">Advance Rec.</span>
                                            <span class="sa-val">
                                                <t t-esc="'{:,.0f}'.format(line.detail_advance) if line.detail_advance else '—'"/>
                                            </span>
                                        </div>
                                        <div class="slip-amt">
                                            <span class="sa-lbl">WHT / EOBI</span>
                                            <span class="sa-val">
                                                <t t-esc="'{:,.0f}'.format(line.detail_wht + line.detail_eobi) if (line.detail_wht or line.detail_eobi) else '—'"/>
                                            </span>
                                        </div>
                                        <div class="slip-amt slip-amt-net">
                                            <span class="sa-lbl">Net Payable</span>
                                            <span class="sa-val">
                                                <t t-esc="'{:,.0f}'.format(line.net_payable)"/>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Acknowledgment text -->
                                    <div class="slip-ack">
                                        I, the undersigned, hereby acknowledge receipt of
                                        <b>PKR <t t-esc="'{:,.0f}'.format(line.net_payable)"/></b>
                                        as full and final salary for
                                        <b><t t-esc="sheet.date_from.strftime('%B %Y') if sheet.date_from else ''"/></b>.
                                    </div>

                                    <!-- Signature row -->
                                    <div class="slip-sig-row">
                                        <div class="slip-sig-line">Signature</div>
                                        <div class="slip-thumb">
                                            <span>Thumb</span>
                                            <span>Print</span>
                                        </div>
                                        <div class="slip-sig-line">Date: ___________</div>
                                    </div>
                                </div>

                            </t>
                        </div><!-- end slip-grid -->
                    </div><!-- end slip-break -->

                </div><!-- end page -->
            </t>
        </t>
    </template>

</odoo>
