<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Journal Entry Voucher — BPV-style PDF template
    ================================================
    Matches the Bank Payment Voucher layout exactly:
      • Title left, company logo right
      • Meta: Vendor/Journal/Project/Cheque left; Financial Year/Voucher/Date right
      • Main table: Account Code | Title/Narration | Debit | Credit
      • Account Title + Cheque No sub-row on the credit (bank) line
      • Amount in words box
      • 4-column signature block (50px top margin)
-->
<template id="report_journal_entry_document">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">
<div class="article" style="font-family:Arial,sans-serif; font-size:11pt; padding-top:16mm;">

    <!-- ════════════════════════════════════════════════════════════
         Pre-compute variables
    ═══════════════════════════════════════════════════════════════ -->
    <t t-set="pm"       t-value="o.date.month if o.date else 1"/>
    <t t-set="py"       t-value="o.date.year  if o.date else 2026"/>
    <t t-set="fy_start" t-value="py if pm >= 7 else py - 1"/>
    <t t-set="fy_end"   t-value="fy_start + 1"/>

    <t t-set="data_lines"   t-value="o.line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"/>
    <t t-set="total_debit"  t-value="sum(data_lines.mapped('debit'))"/>
    <t t-set="total_credit" t-value="sum(data_lines.mapped('credit'))"/>

    <!-- ════════════════════════════════════════════════════════════
         HEADER — title left, company logo right
    ═══════════════════════════════════════════════════════════════ -->
    <div class="row mb-3" style="align-items:center;">
        <div class="col-8">
            <div style="font-size:20pt; font-weight:700; letter-spacing:0.5px;">
                Bank Payment Voucher (JE)
            </div>
        </div>
        <div class="col-4 text-end">
            <t t-if="o.company_id.logo">
                <img t-att-src="image_data_uri(o.company_id.logo)"
                     style="height:90px; max-width:220px; object-fit:contain;"/>
            </t>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         META INFO BOX — left: vendor/journal/cheque  right: FY/voucher/date
    ═══════════════════════════════════════════════════════════════ -->
    <div class="row mb-3">
        <div class="col-6">
            <table style="font-size:10.5pt; width:100%;">
                <t t-if="o.partner_id">
                    <tr>
                        <td style="font-weight:600; width:38%; padding:2px 6px 2px 0;">Vendor</td>
                        <td style="padding:2px 0;"><t t-esc="o.partner_id.name"/></td>
                    </tr>
                </t>
                <tr>
                    <td style="font-weight:600; padding:2px 6px 2px 0;">Journal</td>
                    <td style="padding:2px 0;"><t t-esc="o.journal_id.name"/></td>
                </tr>
                <t t-if="o.x_project_analytic_account_id">
                    <tr>
                        <td style="font-weight:600; padding:2px 6px 2px 0;">Project</td>
                        <td style="padding:2px 0;"><t t-esc="o.x_project_analytic_account_id.name"/></td>
                    </tr>
                </t>
                <t t-if="o.x_account_title">
                    <tr>
                        <td style="font-weight:600; padding:2px 6px 2px 0;">Account Title</td>
                        <td style="padding:2px 0; font-weight:600;"><t t-esc="o.x_account_title"/></td>
                    </tr>
                </t>
                <t t-if="o.x_cheque_number">
                    <tr>
                        <td style="font-weight:600; padding:2px 6px 2px 0;">Cheque / Ref No.</td>
                        <td style="padding:2px 0; font-weight:700; color:#1a3050; font-size:11pt;">
                            <t t-esc="o.x_cheque_number"/>
                        </td>
                    </tr>
                </t>
                <t t-if="o.ref">
                    <tr>
                        <td style="font-weight:600; padding:2px 6px 2px 0; vertical-align:top;">Reference</td>
                        <td style="padding:2px 0;"><t t-esc="o.ref"/></td>
                    </tr>
                </t>
                <t t-if="o.narration">
                    <tr>
                        <td style="font-weight:600; padding:2px 6px 2px 0; vertical-align:top;">Narration</td>
                        <td style="padding:2px 0;"><t t-out="o.narration"/></td>
                    </tr>
                </t>
            </table>
        </div>

        <div class="col-6">
            <table style="font-size:10.5pt; border-collapse:collapse; width:100%;
                          border:1.5px solid #333;">
                <tr style="background:#f0f0f0;">
                    <td style="font-weight:700; padding:4px 10px; border:1px solid #aaa; width:50%;">
                        Financial Year
                    </td>
                    <td style="padding:4px 10px; border:1px solid #aaa;">
                        <t t-esc="fy_start"/>&#160;–&#160;<t t-esc="fy_end"/>
                    </td>
                </tr>
                <tr>
                    <td style="font-weight:700; padding:4px 10px; border:1px solid #aaa;">
                        Voucher No
                    </td>
                    <td style="padding:4px 10px; border:1px solid #aaa;">
                        <t t-esc="o.name or '—'"/>
                    </td>
                </tr>
                <tr style="background:#f0f0f0;">
                    <td style="font-weight:700; padding:4px 10px; border:1px solid #aaa;">
                        Date
                    </td>
                    <td style="padding:4px 10px; border:1px solid #aaa;">
                        <t t-esc="o.date.strftime('%d/%m/%Y') if o.date else '—'"/>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         MAIN TABLE
         Each JE line as one row.
         Credit lines that have a cheque / account title get a
         sub-row matching the BPV bank-details mini-table.
    ═══════════════════════════════════════════════════════════════ -->
    <table style="width:100%; border-collapse:collapse; font-size:10.5pt; margin-top:6px;">
        <thead>
            <tr style="background:#222; color:#fff;">
                <th style="padding:6px 8px; border:1px solid #555; width:12%; text-align:left;">
                    Account Code
                </th>
                <th style="padding:6px 8px; border:1px solid #555; text-align:left;">
                    Title / Narration
                </th>
                <th style="padding:6px 8px; border:1px solid #555; width:14%; text-align:right;">
                    Debit
                </th>
                <th style="padding:6px 8px; border:1px solid #555; width:14%; text-align:right;">
                    Credit
                </th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="data_lines" t-as="line">
                <tr style="border-bottom:1px solid #dee2e6;">
                    <td style="padding:7px 8px; border:1px solid #ccc; font-family:monospace; font-size:10pt; vertical-align:top;">
                        <t t-esc="line.account_id.code or '—'"/>
                    </td>
                    <td style="padding:7px 8px; border:1px solid #ccc; vertical-align:top;">
                        <div style="font-weight:600;">
                            <t t-esc="line.account_id.name"/>
                        </div>
                        <t t-if="line.partner_id">
                            <div style="font-size:9.5pt; color:#444; margin-top:3px;">
                                <t t-esc="line.partner_id.name"/>
                            </div>
                        </t>
                        <t t-if="line.name">
                            <div style="font-size:9.5pt; color:#555; margin-top:2px;">
                                <t t-esc="line.name"/>
                            </div>
                        </t>
                        <!-- Bank details sub-row on credit line (matches BPV style) -->
                        <t t-if="line.credit > 0 and (o.x_account_title or o.x_cheque_number)">
                            <table style="margin-top:6px; font-size:9.5pt; border-collapse:collapse; width:auto;">
                                <tr>
                                    <t t-if="o.x_account_title">
                                        <td style="border:1px solid #aaa; padding:3px 10px; background:#f8f8f8; font-weight:600;">Account Title</td>
                                        <td style="border:1px solid #aaa; padding:3px 14px; min-width:130px;">
                                            <t t-esc="o.x_account_title"/>
                                        </td>
                                    </t>
                                    <t t-if="o.x_cheque_number">
                                        <td style="border:1px solid #aaa; padding:3px 10px; background:#f8f8f8; font-weight:600; padding-left:16px;">Cheque No</td>
                                        <td style="border:1px solid #aaa; padding:3px 14px; min-width:110px;">
                                            <t t-esc="o.x_cheque_number"/>
                                        </td>
                                    </t>
                                    <td style="border:1px solid #aaa; padding:3px 10px; background:#f8f8f8; font-weight:600; padding-left:16px;">Date</td>
                                    <td style="border:1px solid #aaa; padding:3px 14px; min-width:90px;">
                                        <t t-esc="o.date.strftime('%d/%m/%Y') if o.date else ''"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                    </td>
                    <td style="padding:7px 8px; border:1px solid #ccc; text-align:right; font-weight:600; vertical-align:top;">
                        <t t-if="line.debit">
                            <t t-esc="'{:,.2f}'.format(line.debit)"/>
                        </t>
                        <t t-else=""><span style="color:#aaa;">—</span></t>
                    </td>
                    <td style="padding:7px 8px; border:1px solid #ccc; text-align:right; font-weight:600; vertical-align:top;">
                        <t t-if="line.credit">
                            <t t-esc="'{:,.2f}'.format(line.credit)"/>
                        </t>
                        <t t-else=""><span style="color:#aaa;">—</span></t>
                    </td>
                </tr>
            </t>

            <!-- ── TOTAL ROW ── -->
            <tr style="background:#f0f0f0; font-weight:700; font-size:11pt;">
                <td style="padding:7px 8px; border:1.5px solid #888;" colspan="2">Total</td>
                <td style="padding:7px 8px; border:1.5px solid #888; text-align:right;">
                    <t t-esc="'{:,.2f}'.format(total_debit)"/>
                </td>
                <td style="padding:7px 8px; border:1.5px solid #888; text-align:right;">
                    <t t-esc="'{:,.2f}'.format(total_credit)"/>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- ════════════════════════════════════════════════════════════
         AMOUNT IN WORDS
    ═══════════════════════════════════════════════════════════════ -->
    <div style="margin-top:14px; border:1px solid #ccc; border-radius:3px; overflow:hidden;">
        <div style="padding:8px 12px; background:#fafafa; font-size:10.5pt;">
            <span style="font-weight:700; margin-right:8px;">Amount in Words:</span>
            <t t-esc="o.currency_id.amount_to_text(total_credit)"/>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         SIGNATURE BLOCK
         50px top margin gives signatories space to sign above each line.
    ═══════════════════════════════════════════════════════════════ -->
    <div style="margin-top:50px;">
        <t t-call="site_operations.report_sig_4col_labels">
            <t t-set="extra_label">Received By</t>
        </t>
    </div>

</div>
</t>
</t>
</template>
</odoo>
