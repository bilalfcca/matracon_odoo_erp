<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
    Journal Entry Voucher — BPV-style PDF template
    ================================================
    Matches the Bank Payment Voucher layout exactly:
      • Title left, company logo right
      • Meta: Vendor/Journal/Project/Cheque left; Financial Year/Voucher/Date right
      • Main table: Account Code | Title/Narration | Debit | Credit
      • Account Title + Cheque No sub-row on the credit (bank) line
      • Amount in words box
      • 4-column signature block
-->
<template id="report_journal_entry_document">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">
<div class="article" style="font-family:Arial,sans-serif; font-size:9pt; padding-top:6mm;">

    <!-- ════════════════════════════════════════════════════════════
         Pre-compute variables
    ═══════════════════════════════════════════════════════════════ -->
    <t t-set="pm"       t-value="o.date.month if o.date else 1"/>
    <t t-set="py"       t-value="o.date.year  if o.date else 2026"/>
    <t t-set="fy_start" t-value="py if pm >= 7 else py - 1"/>
    <t t-set="fy_end"   t-value="fy_start + 1"/>

    <t t-set="data_lines"   t-value="o.line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note'))"/>
    <t t-set="total_debit"  t-value="sum(data_lines.mapped('debit'))"/>
    <t t-set="total_credit" t-value="sum(data_lines.mapped('credit'))"/>

    <!-- ════════════════════════════════════════════════════════════
         HEADER — title left, company logo right
    ═══════════════════════════════════════════════════════════════ -->
    <div class="row mb-1" style="align-items:center;">
        <div class="col-8">
            <div style="font-size:13pt; font-weight:700; letter-spacing:0.3px;">
                Bank Payment Voucher (JE)
            </div>
        </div>
        <div class="col-4 text-end">
            <t t-if="o.company_id.logo">
                <img t-att-src="image_data_uri(o.company_id.logo)"
                     style="height:75px; max-width:200px; object-fit:contain;"/>
            </t>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         META INFO BOX — left: vendor/journal/cheque  right: FY/voucher/date
    ═══════════════════════════════════════════════════════════════ -->
    <div class="row mb-1">
        <div class="col-6">
            <table style="font-size:9pt; width:100%;">
                <t t-if="o.partner_id">
                    <tr>
                        <td style="font-weight:600; width:38%; padding:1px 4px 1px 0;">Vendor</td>
                        <td style="padding:1px 0;"><t t-esc="o.partner_id.name"/></td>
                    </tr>
                </t>
                <tr>
                    <td style="font-weight:600; padding:1px 4px 1px 0;">Journal</td>
                    <td style="padding:1px 0;"><t t-esc="o.journal_id.name"/></td>
                </tr>
                <t t-if="o.x_project_analytic_account_id">
                    <tr>
                        <td style="font-weight:600; padding:1px 4px 1px 0;">Project</td>
                        <td style="padding:1px 0;"><t t-esc="o.x_project_analytic_account_id.name"/></td>
                    </tr>
                </t>
                <t t-if="o.x_account_title">
                    <tr>
                        <td style="font-weight:600; padding:1px 4px 1px 0;">Account Title</td>
                        <td style="padding:1px 0; font-weight:600;"><t t-esc="o.x_account_title"/></td>
                    </tr>
                </t>
                <t t-if="o.x_cheque_number">
                    <tr>
                        <td style="font-weight:600; padding:1px 4px 1px 0;">Cheque / Ref No.</td>
                        <td style="padding:1px 0; font-weight:700; color:#1a3050;">
                            <t t-esc="o.x_cheque_number"/>
                        </td>
                    </tr>
                </t>
                <t t-if="o.ref">
                    <tr>
                        <td style="font-weight:600; padding:1px 4px 1px 0; vertical-align:top;">Reference</td>
                        <td style="padding:1px 0;"><t t-esc="o.ref"/></td>
                    </tr>
                </t>
                <t t-if="o.narration">
                    <tr>
                        <td style="font-weight:600; padding:1px 4px 1px 0; vertical-align:top;">Narration</td>
                        <td style="padding:1px 0;"><t t-out="o.narration"/></td>
                    </tr>
                </t>
            </table>
        </div>

        <div class="col-6">
            <table style="font-size:9pt; border-collapse:collapse; width:100%;
                          border:1.5px solid #333;">
                <tr style="background:#f0f0f0;">
                    <td style="font-weight:700; padding:2px 6px; border:1px solid #aaa; width:50%;">
                        Financial Year
                    </td>
                    <td style="padding:2px 6px; border:1px solid #aaa;">
                        <t t-esc="fy_start"/>&#160;–&#160;<t t-esc="fy_end"/>
                    </td>
                </tr>
                <tr>
                    <td style="font-weight:700; padding:2px 6px; border:1px solid #aaa;">
                        Voucher No
                    </td>
                    <td style="padding:2px 6px; border:1px solid #aaa;">
                        <t t-esc="o.name or '—'"/>
                    </td>
                </tr>
                <tr style="background:#f0f0f0;">
                    <td style="font-weight:700; padding:2px 6px; border:1px solid #aaa;">
                        Date
                    </td>
                    <td style="padding:2px 6px; border:1px solid #aaa;">
                        <t t-esc="o.date.strftime('%d/%m/%Y') if o.date else '—'"/>
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         MAIN TABLE
         Each JE line as one row.
         Credit lines that have a cheque / account title get a
         sub-row matching the BPV bank-details mini-table.
    ═══════════════════════════════════════════════════════════════ -->
    <table style="width:100%; border-collapse:collapse; font-size:8.5pt; margin-top:2px;">
        <thead>
            <tr style="background:#222; color:#fff;">
                <th style="padding:3px 5px; border:1px solid #555; width:12%; text-align:left;">
                    Account Code
                </th>
                <th style="padding:3px 5px; border:1px solid #555; text-align:left;">
                    Title / Narration
                </th>
                <th style="padding:3px 5px; border:1px solid #555; width:14%; text-align:right;">
                    Debit
                </th>
                <th style="padding:3px 5px; border:1px solid #555; width:14%; text-align:right;">
                    Credit
                </th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="data_lines" t-as="line">
                <tr style="border-bottom:1px solid #dee2e6;">
                    <td style="padding:3px 5px; border:1px solid #ccc; font-family:monospace; font-size:8.5pt; vertical-align:top;">
                        <t t-esc="line.account_id.code or '—'"/>
                    </td>
                    <td style="padding:3px 5px; border:1px solid #ccc; vertical-align:top;">
                        <div style="font-weight:600;">
                            <t t-esc="line.account_id.name"/>
                        </div>
                        <t t-if="line.partner_id">
                            <div style="font-size:8.5pt; color:#444; margin-top:2px;">
                                <t t-esc="line.partner_id.name"/>
                            </div>
                        </t>
                        <t t-if="line.name">
                            <div style="font-size:8.5pt; color:#555; margin-top:1px;">
                                <t t-esc="line.name"/>
                            </div>
                        </t>
                        <!-- Bank / cheque details sub-row — shown on any line that carries
                             its own x_account_title or x_cheque_number (same concept as BPV).
                             Falls back to the move-header value when the line field is blank,
                             so single-cheque entries (where the header value propagates to all
                             lines) still render correctly. -->
                        <t t-set="line_account_title"  t-value="line.x_account_title  or o.x_account_title"/>
                        <t t-set="line_cheque_number"  t-value="line.x_cheque_number  or o.x_cheque_number"/>
                        <t t-if="line_account_title or line_cheque_number">
                            <table style="margin-top:3px; font-size:8.5pt; border-collapse:collapse; width:auto;">
                                <tr>
                                    <t t-if="line_account_title">
                                        <td style="border:1px solid #aaa; padding:2px 6px; background:#f8f8f8; font-weight:600;">Account Title</td>
                                        <td style="border:1px solid #aaa; padding:2px 8px; min-width:120px;">
                                            <t t-esc="line_account_title"/>
                                        </td>
                                    </t>
                                    <t t-if="line_cheque_number">
                                        <td style="border:1px solid #aaa; padding:2px 6px; background:#f8f8f8; font-weight:600;">Cheque No</td>
                                        <td style="border:1px solid #aaa; padding:2px 8px; min-width:100px;">
                                            <t t-esc="line_cheque_number"/>
                                        </td>
                                    </t>
                                    <td style="border:1px solid #aaa; padding:2px 6px; background:#f8f8f8; font-weight:600;">Date</td>
                                    <td style="border:1px solid #aaa; padding:2px 8px; min-width:80px;">
                                        <t t-esc="o.date.strftime('%d/%m/%Y') if o.date else ''"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                    </td>
                    <td style="padding:3px 5px; border:1px solid #ccc; text-align:right; font-weight:600; vertical-align:top;">
                        <t t-if="line.debit">
                            <t t-esc="'{:,.2f}'.format(line.debit)"/>
                        </t>
                        <t t-else=""><span style="color:#aaa;">—</span></t>
                    </td>
                    <td style="padding:3px 5px; border:1px solid #ccc; text-align:right; font-weight:600; vertical-align:top;">
                        <t t-if="line.credit">
                            <t t-esc="'{:,.2f}'.format(line.credit)"/>
                        </t>
                        <t t-else=""><span style="color:#aaa;">—</span></t>
                    </td>
                </tr>
            </t>

            <!-- ── TOTAL ROW ── -->
            <tr style="background:#f0f0f0; font-weight:700; font-size:10pt;">
                <td style="padding:3px 5px; border:1.5px solid #888;" colspan="2">Total</td>
                <td style="padding:3px 5px; border:1.5px solid #888; text-align:right;">
                    <t t-esc="'{:,.2f}'.format(total_debit)"/>
                </td>
                <td style="padding:3px 5px; border:1.5px solid #888; text-align:right;">
                    <t t-esc="'{:,.2f}'.format(total_credit)"/>
                </td>
            </tr>
        </tbody>
    </table>

    <!-- ════════════════════════════════════════════════════════════
         AMOUNT IN WORDS
    ═══════════════════════════════════════════════════════════════ -->
    <div style="margin-top:4px; border:1px solid #ccc; border-radius:3px; overflow:hidden;">
        <div style="padding:3px 8px; background:#fafafa; font-size:8.5pt;">
            <span style="font-weight:700; margin-right:8px;">Amount in Words:</span>
            <t t-esc="o.currency_id.amount_to_text(total_credit)"/>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         SIGNATURE BLOCK — 4 rows, one signatory per line
    ═══════════════════════════════════════════════════════════════ -->
    <t t-set="jev_prepared" t-value="o.sudo().create_uid"/>
    <t t-set="jev_approved" t-value="o.sudo().x_ceo_approved_by_id if hasattr(o, 'x_ceo_approved_by_id') else False"/>
    <div style="margin-top:12px; page-break-inside:avoid;">
        <table style="width:100%; border-collapse:collapse; font-size:9pt;">

            <!-- ROW 1 — Prepared By -->
            <tr>
                <td style="width:22%; font-weight:700; padding:0 10px 4px 0; vertical-align:bottom;">Prepared By</td>
                <td style="vertical-align:bottom; padding:0;">
                    <t t-if="jev_prepared and jev_prepared.x_sign_signature">
                        <img t-att-src="image_data_uri(jev_prepared.x_sign_signature)"
                             style="max-height:42px; max-width:160px; object-fit:contain; display:block;"/>
                    </t>
                    <t t-else=""><div style="height:44px;"></div></t>
                    <div style="border-top:1.5px solid #000; padding-top:3px; font-size:8.5pt; font-weight:600; color:#374151;">
                        <t t-if="jev_prepared"><t t-esc="jev_prepared.name"/></t>
                    </div>
                </td>
            </tr>
            <tr><td colspan="2" style="height:14px;"></td></tr>

            <!-- ROW 2 — Checked By -->
            <tr>
                <td style="font-weight:700; padding:0 10px 4px 0; vertical-align:bottom;">Checked By</td>
                <td style="vertical-align:bottom; padding:0;">
                    <div style="height:44px;"></div>
                    <div style="border-top:1.5px solid #000; padding-top:3px; font-size:8.5pt; color:#6c757d;">
                        Name: ___________________________________
                    </div>
                </td>
            </tr>
            <tr><td colspan="2" style="height:14px;"></td></tr>

            <!-- ROW 3 — Approved By -->
            <tr>
                <td style="font-weight:700; padding:0 10px 4px 0; vertical-align:bottom;">Approved By</td>
                <td style="vertical-align:bottom; padding:0;">
                    <t t-if="jev_approved and jev_approved.x_sign_signature">
                        <img t-att-src="image_data_uri(jev_approved.x_sign_signature)"
                             style="max-height:42px; max-width:160px; object-fit:contain; display:block;"/>
                    </t>
                    <t t-else=""><div style="height:44px;"></div></t>
                    <div style="border-top:1.5px solid #000; padding-top:3px; font-size:8.5pt; font-weight:600; color:#374151;">
                        <t t-if="jev_approved">
                            <t t-esc="jev_approved.name"/>
                        </t>
                        <t t-else="">
                            <span style="color:#6c757d; font-weight:400;">Name: ___________________________________</span>
                        </t>
                    </div>
                </td>
            </tr>
            <tr><td colspan="2" style="height:14px;"></td></tr>

            <!-- ROW 4 — Received By -->
            <tr>
                <td style="font-weight:700; padding:0 10px 4px 0; vertical-align:bottom;">Received By</td>
                <td style="vertical-align:bottom; padding:0;">
                    <div style="height:44px;"></div>
                    <div style="border-top:1.5px solid #000; padding-top:3px; font-size:8.5pt; color:#6c757d;">
                        Name: ___________________________________
                    </div>
                </td>
            </tr>

        </table>
    </div>

</div>
</t>
</t>
</template>
</odoo>
