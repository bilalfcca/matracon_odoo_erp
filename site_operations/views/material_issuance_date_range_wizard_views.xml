<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════
         Material Issuance — Date Range Filter Wizard
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="view_material_issuance_date_range_wizard_form" model="ir.ui.view">
        <field name="name">x.material.issuance.date.range.wizard.form</field>
        <field name="model">x.material.issuance.date.range.wizard</field>
        <field name="arch" type="xml">
            <form string="Filter by Date Range">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="date_field" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_material_issuance_date_range_wizard" model="ir.actions.act_window">
        <field name="name">Filter by Date Range</field>
        <field name="res_model">x.material.issuance.date.range.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_material_issuance_date_range_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
