<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════
         res.partner — smart button for Material Issuances
         Shows on both contact and employee forms.
    ════════════════════════════════════════════════════════════════════════ -->
    <record id="view_partner_form_site_ops" model="ir.ui.view">
        <field name="name">res.partner.form.site.ops</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- ── When opened from Site Procurement (x_site_vendor_id create),
                 make Tags (category_id) required so Site Store MUST add
                 the "Local Supplier" tag before saving. ── -->
            <field name="category_id" position="attributes">
                <attribute name="required">context.get('site_procurement_vendor', False)</attribute>
                <attribute name="help">Tag this contact. When creating from Site Procurement, the "Local Supplier" tag is required.</attribute>
            </field>

            <!-- ── Description field — shown on Liability Sheet lines as "Tag (Description)" ── -->
            <field name="category_id" position="after">
                <field name="x_description"
                       string="Description"
                       placeholder="e.g. Cement Supplier, Labour Contractor"
                       help="Brief description. Appears on Liability Sheet lines as Tag (Description)."/>
            </field>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_material_issuances"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="x_material_issuance_count == 0">
                    <field name="x_material_issuance_count"
                           widget="statinfo"
                           string="Issuances"/>
                </button>
            </xpath>

        </field>
    </record>
</odoo>
