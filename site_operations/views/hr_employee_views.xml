<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_matracon" model="ir.ui.view">
        <field name="name">hr.employee.form.matracon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Last Online — shown in Settings > User group, only when user is linked -->
            <xpath expr="//group[@name='user']" position="inside">
                <field name="x_last_online"
                       readonly="1"
                       string="Last Online"
                       invisible="not user_id"/>
            </xpath>

            <!-- Print Employee Card button in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_print_employee_card"
                        type="object"
                        string="Print Card"
                        class="oe_stat_button"
                        icon="fa-id-card"
                        groups="purchase_demand_raise.group_matracon_admin,site_operations.group_finance_ho,purchase_demand_raise.group_head_office"/>
                <button name="action_view_backcharges"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="x_backcharge_count"/>
                        </span>
                        <span class="o_stat_text">Backcharges</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='personal_information']" position="after">
                <page string="Matracon Payroll" name="matracon_payroll">
                    <group>
                        <field name="x_project_analytic_account_id"/>
                        <field name="x_cnic"/>
                        <field name="x_basic_salary"/>
                        <field name="x_hra"/>
                        <field name="x_site_allowance"/>
                        <field name="x_advance_balance"/>
                        <field name="x_wht_rate"/>
                        <field name="x_eobi_amount"/>
                        <field name="x_backcharge_balance" readonly="1"
                               string="Outstanding Backcharge Balance"/>
                    </group>
                </page>
                <page string="Documents" name="matracon_documents">
                    <field name="x_document_ids">
                        <list editable="bottom">
                            <field name="document_type"/>
                            <field name="name"/>
                            <field name="file" filename="filename" widget="binary"/>
                            <field name="filename" column_invisible="1"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Employee List view — Last Online optional column ── -->
    <record id="view_hr_employee_list_matracon" model="ir.ui.view">
        <field name="name">hr.employee.list.matracon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="arch" type="xml">
            <!-- Add after the "Related User" column so it appears right next to it -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="x_last_online"
                       string="Last Online"
                       readonly="1"
                       optional="show"
                       widget="datetime"/>
            </xpath>
        </field>
    </record>

    <!-- ── Employee Kanban view — Last Online in card footer area ── -->
    <record id="view_hr_employee_kanban_matracon" model="ir.ui.view">
        <field name="name">hr.employee.kanban.matracon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <!-- Declare x_last_online so it is fetched with each kanban record -->
            <xpath expr="//kanban/field[@name='show_hr_icon_display']" position="after">
                <field name="x_last_online"/>
            </xpath>
            <!-- Show "Last Online" label just above the footer inside each card -->
            <xpath expr="//footer" position="before">
                <div t-if="record.x_last_online.raw_value"
                     class="text-muted small mt-1"
                     title="Last time this employee had an active browser tab">
                    <i class="fa fa-clock-o me-1"/>
                    Last online: <field name="x_last_online" readonly="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
