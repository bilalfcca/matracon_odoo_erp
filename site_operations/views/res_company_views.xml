<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company form → "Matracon Accounts": default deduction accounts used
         by vendor payments. Picked by Finance; the module never hardcodes or
         renumbers them. -->
    <record id="view_company_form_matracon_accounts" model="ir.ui.view">
        <field name="name">res.company.form.matracon.accounts</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Matracon Accounts" name="matracon_accounts">
                    <group>
                        <field name="x_wht_payable_account_id"
                               options="{'no_create': True}"/>
                        <field name="x_retention_payable_account_id"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
