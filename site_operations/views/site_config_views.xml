<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_site_config_form_site_ops" model="ir.ui.view">
        <field name="name">x.project.site.config.form.site_ops</field>
        <field name="model">x.project.site.config</field>
        <field name="inherit_id" ref="purchase_demand_raise.view_project_site_config_form"/>
        <field name="arch" type="xml">

            <field name="analytic_account_id" position="after">
                <field name="project_id" readonly="1"/>
            </field>

            <!-- Petty Cash Account — added by site_operations after the field is defined -->
            <field name="warehouse_id" position="after">
                <field name="x_petty_cash_account_id"
                       string="Petty Cash Account (Cash in Hand)"
                       options="{'no_create': True}"
                       help="The GL account for this site's petty cash (e.g. Cash in Hand — RWASA). Once set here, it auto-fills on all petty cash expenses, HO fund releases, and site cash-out entries for this project."/>
            </field>

            <button name="action_view_users" position="after">
                <button name="action_open_project"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-folder-open"
                        invisible="not project_id">
                    <span class="o_stat_text">Odoo Project</span>
                </button>
                <button name="action_view_accountants"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calculator">
                    <field name="x_accountant_count" widget="statinfo" string="Accountants"/>
                </button>
            </button>

            <page name="site_users" position="after">
                <page string="Site Accountants" name="site_accountants">
                    <div class="alert alert-info" role="alert">
                        <strong>How this works:</strong>
                        Adding a user here automatically assigns them to the
                        <strong>Site Accountant</strong> security group and sets their
                        default analytic account and warehouse for this project.
                        Removing a user reverses this automatically.
                    </div>
                    <field name="x_site_accountant_ids" widget="many2many">
                        <list>
                            <field name="name"/>
                            <field name="login"/>
                            <field name="x_default_analytic_account_id" readonly="1" string="Analytic Account"/>
                            <field name="x_default_warehouse_id" readonly="1" string="Warehouse"/>
                            <field name="x_site_config_id" readonly="1" string="Site Config"/>
                        </list>
                    </field>
                </page>

                <page string="Project Details" name="project_details">
                    <group string="Project Timeline">
                        <group>
                            <field name="x_project_start_date" string="Project Start Date"/>
                            <field name="x_project_deadline" string="Original Deadline (Baseline)"/>
                        </group>
                        <group>
                            <field name="x_current_deadline" string="Current Deadline" readonly="1"
                                   decoration-success="x_current_deadline != x_project_deadline"
                                   class="fw-bold"/>
                        </group>
                    </group>

                    <separator string="Extension of Time (EOT) History"/>
                    <field name="x_eot_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="eot_no" string="No." readonly="1" width="48px"/>
                            <field name="eot_date" string="Approval Date"/>
                            <field name="duration_months" string="Duration (Months)"/>
                            <field name="effective_deadline" string="Effective Deadline" readonly="1"
                                   decoration-bf="1"/>
                            <field name="notes" string="Notes / Reference"/>
                        </list>
                    </field>

                    <div class="alert alert-info mt-2" role="alert"
                         invisible="not x_project_deadline">
                        <i class="fa fa-info-circle me-2"/>
                        <strong>How EOT works:</strong>
                        Each row adds months to the previous deadline cumulatively.
                        The <strong>Current Deadline</strong> above reflects the sum of all EOTs.
                    </div>
                </page>
            </page>

        </field>
    </record>
</odoo>
