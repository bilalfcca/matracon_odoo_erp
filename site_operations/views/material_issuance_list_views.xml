<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════════
         Material Issuance — List View, Search View, and Window Action
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- ── List View ────────────────────────────────────────────────────── -->
    <record id="view_material_issuance_list" model="ir.ui.view">
        <field name="name">stock.picking.material.issuance.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Material Issuances"
                  decoration-danger="state == 'cancel'"
                  decoration-muted="state == 'draft'"
                  decoration-warning="state in ('waiting', 'confirmed', 'assigned')">
                <!-- ── Always visible ────────────────────────────────── -->
                <field name="name" string="Reference"/>
                <field name="x_contact_id" string="Contact"/>
                <field name="x_issuance_project_id" string="Project" optional="show"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state in ('waiting', 'confirmed', 'assigned')"/>
                <!-- ── Optional — hidden by default ─────────────────── -->
                <field name="x_transfer_purpose" string="Purpose" optional="hide"/>
                <field name="x_issue_type" string="Issue Type" optional="hide"/>
                <field name="x_inventory_type" string="Inventory Type" optional="hide"/>
                <field name="x_backcharge_applicable" string="Backcharged" optional="hide"/>
                <field name="x_original_issued_qty" string="Issued Qty" optional="hide"/>
                <field name="x_total_returned_qty" string="Returned Qty" optional="hide"/>
                <field name="x_outstanding_qty" string="Outstanding Qty" optional="hide"/>
                <field name="x_site_transfer_state" string="Transfer Status" optional="hide"
                       widget="badge"
                       decoration-warning="x_site_transfer_state == 'pending_approval'"
                       decoration-success="x_site_transfer_state in ('approved', 'done')"
                       decoration-danger="x_site_transfer_state == 'rejected'"/>
                <field name="x_dest_project_id" string="Destination Project" optional="hide"/>
                <field name="location_id" string="From Location" optional="hide"/>
                <field name="location_dest_id" string="To Location" optional="hide"/>
                <field name="origin" string="Source Document" optional="hide"/>
                <field name="scheduled_date" string="Scheduled Date" optional="hide"/>
                <field name="x_original_issuance_id" string="Original Issuance" optional="hide"/>
                <field name="x_gate_pass_outward_no" string="Gate Pass No" optional="hide"/>
                <!-- Hidden fields used for row decorations -->
                <field name="x_is_return_transfer" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="view_material_issuance_search" model="ir.ui.view">
        <field name="name">stock.picking.material.issuance.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Search Issuances">
                <field name="name" string="Reference"/>
                <field name="x_contact_id" string="Issuance Contact"/>
                <field name="x_issuance_project_id" string="Project"/>
                <field name="origin" string="Source Document"/>

                <!-- ── Filters ── -->
                <separator/>
                <filter name="filter_material_issuance"
                        string="Material Issuance"
                        domain="[('x_transfer_purpose', '=', 'material_issuance')]"/>
                <filter name="filter_site_to_site"
                        string="Site-to-Site Transfer"
                        domain="[('x_transfer_purpose', '=', 'site_to_site')]"/>
                <filter name="filter_transfer_pending"
                        string="Pending Approval"
                        domain="[('x_transfer_purpose', '=', 'site_to_site'), ('x_site_transfer_state', '=', 'pending_approval')]"/>
                <filter name="filter_dest_receipt"
                        string="Destination Receipts"
                        domain="[('x_is_dest_receipt', '=', True)]"/>

                <separator/>
                <filter name="filter_issue_type_normal"
                        string="Normal Issuance"
                        domain="[('x_issue_type', '=', 'normal')]"/>
                <filter name="filter_issue_type_sub"
                        string="Subcontractor Issuance"
                        domain="[('x_issue_type', '=', 'subcontractor')]"/>

                <separator/>
                <filter name="filter_inventory_asset"
                        string="Asset"
                        domain="[('x_inventory_type', '=', 'asset')]"/>
                <filter name="filter_inventory_consumable"
                        string="Consumable"
                        domain="[('x_inventory_type', '=', 'consumable')]"/>

                <separator/>
                <filter name="filter_backcharged"
                        string="Backcharged"
                        domain="[('x_backcharge_applicable', '=', True)]"/>
                <filter name="filter_returns"
                        string="Returns"
                        domain="[('x_is_return_transfer', '=', True)]"/>

                <separator/>
                <filter name="filter_done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_in_progress"
                        string="In Progress"
                        domain="[('state', 'in', ['waiting', 'confirmed', 'assigned'])]"/>
                <filter name="filter_cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancel')]"/>

                <!-- ── Group By ── -->
                <separator/>
                <filter name="group_by_project"
                        string="Group by Project"
                        context="{'group_by': 'x_issuance_project_id'}"/>
                <filter name="group_by_contact"
                        string="Group by Contact"
                        context="{'group_by': 'x_contact_id'}"/>
                <filter name="group_by_issue_type"
                        string="Group by Issue Type"
                        context="{'group_by': 'x_issue_type'}"/>
                <filter name="group_by_inventory_type"
                        string="Group by Inventory Type"
                        context="{'group_by': 'x_inventory_type'}"/>
                <filter name="group_by_purpose"
                        string="Group by Transfer Purpose"
                        context="{'group_by': 'x_transfer_purpose'}"/>
                <filter name="group_by_state"
                        string="Group by Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ── Window Action: All Issuances (Material + Site-to-Site) ────────── -->
    <record id="action_material_issuance_all" model="ir.actions.act_window">
        <field name="name">Material Issuances</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_transfer_purpose', 'in', ['material_issuance', 'site_to_site'])]</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_material_issuance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')}),
        ]"/>
        <field name="search_view_id" ref="view_material_issuance_search"/>
    </record>

    <!-- ── Window Action: Material Issuance Only (excludes returns) ─────────── -->
    <record id="action_material_issuance_only" model="ir.actions.act_window">
        <field name="name">Material Issuance</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_transfer_purpose', '=', 'material_issuance'), ('x_is_return_transfer', '=', False)]</field>
        <field name="context">{'default_x_transfer_purpose': 'material_issuance', 'default_x_is_return_transfer': False}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_material_issuance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')}),
        ]"/>
        <field name="search_view_id" ref="view_material_issuance_search"/>
    </record>

    <!-- ── List View: Material Returns ───────────────────────────────────── -->
    <record id="view_material_return_list" model="ir.ui.view">
        <field name="name">stock.picking.material.return.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Material Returns"
                  decoration-danger="state == 'cancel'"
                  decoration-muted="state == 'draft'"
                  decoration-warning="state in ('waiting', 'confirmed', 'assigned')">
                <field name="name" string="Reference"/>
                <field name="x_original_issuance_id" string="Original Issuance"/>
                <field name="x_contact_id" string="Returned By"/>
                <field name="x_issuance_project_id" string="Project" optional="show"/>
                <field name="x_return_type" string="Return Type" optional="show" widget="badge"/>
                <field name="x_inventory_type" string="Type" optional="show" widget="badge"/>
                <field name="state" string="Status" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state in ('waiting', 'confirmed', 'assigned')"/>
                <field name="x_employee_backcharge_id" string="Employee BC" optional="show"/>
                <field name="x_sub_backcharge_id" string="Sub BC" optional="show"/>
                <field name="x_return_backcharge_amount" string="Backcharge Amt" optional="show"/>
                <field name="scheduled_date" string="Date" optional="show"/>
                <field name="x_is_return_transfer" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Search View: Material Returns ─────────────────────────────────── -->
    <record id="view_material_return_search" model="ir.ui.view">
        <field name="name">stock.picking.material.return.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Search Returns">
                <field name="name" string="Reference"/>
                <field name="x_contact_id" string="Returned By"/>
                <field name="x_original_issuance_id" string="Original Issuance"/>
                <field name="x_issuance_project_id" string="Project"/>
                <separator/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_asset" string="Asset" domain="[('x_inventory_type', '=', 'asset')]"/>
                <filter name="filter_consumable" string="Consumable" domain="[('x_inventory_type', '=', 'consumable')]"/>
                <filter name="filter_damaged" string="Damaged" domain="[('x_return_type', '=', 'damaged')]"/>
                <filter name="filter_backcharged" string="With Backcharge"
                        domain="[('x_return_backcharge_applicable', '=', True)]"/>
                <separator/>
                <filter name="group_by_project" string="Group by Project"
                        context="{'group_by': 'x_issuance_project_id'}"/>
                <filter name="group_by_contact" string="Group by Contact"
                        context="{'group_by': 'x_contact_id'}"/>
                <filter name="group_by_type" string="Group by Type"
                        context="{'group_by': 'x_inventory_type'}"/>
            </search>
        </field>
    </record>

    <!-- ── Window Action: Material Returns ───────────────────────────────── -->
    <record id="action_material_return" model="ir.actions.act_window">
        <field name="name">Material Returns</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_transfer_purpose', '=', 'material_issuance'), ('x_is_return_transfer', '=', True)]</field>
        <field name="context">{
            'default_x_is_return_transfer': True,
            'default_x_transfer_purpose': 'material_issuance'
        }</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_material_return_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_material_return_form')}),
        ]"/>
        <field name="search_view_id" ref="view_material_return_search"/>
    </record>

    <!-- ── Window Actions: Site Store Reporting ─────────────────────────── -->

    <!-- Stock Movements: all done moves scoped to user's warehouse via record rule -->
    <record id="action_site_store_stock_movements" model="ir.actions.act_window">
        <field name="name">Stock Movements</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="context">{
            'search_default_groupby_product': 0,
            'group_by': [],
        }</field>
    </record>

    <!-- Current Stock: on-hand quantities at internal locations -->
    <record id="action_site_store_current_stock" model="ir.actions.act_window">
        <field name="name">Current Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="context">{}</field>
    </record>

    <!-- ── Window Action: Site-to-Site Transfers Only ────────────────────── -->
    <record id="action_site_to_site_transfers" model="ir.actions.act_window">
        <field name="name">Site-to-Site Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_transfer_purpose', '=', 'site_to_site')]</field>
        <field name="context">{'default_x_transfer_purpose': 'site_to_site'}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_material_issuance_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_picking_form')}),
        ]"/>
        <field name="search_view_id" ref="view_material_issuance_search"/>
    </record>

</odoo>
