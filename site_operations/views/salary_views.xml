<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_salary_sheet_form" model="ir.ui.view">
        <field name="name">x.salary.sheet.form</field>
        <field name="model">x.salary.sheet</field>
        <field name="arch" type="xml">
            <form string="Salary Sheet" class="matracon-salary-sheet">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,paid"/>
                    <!-- ── Refresh from Attendance ── -->
                    <button name="action_refresh_from_attendance" type="object"
                            string="Refresh from Attendance" class="btn-secondary"
                            invisible="state != 'draft'"
                            groups="site_operations.group_site_accountant"/>
                    <!-- ── Download for physical signing ── -->
                    <button name="action_download_pdf" type="object"
                            string="Download for Signing"
                            class="btn-secondary"
                            invisible="state != 'draft'"
                            groups="site_operations.group_site_accountant,purchase_demand_raise.group_matracon_admin"/>
                    <!-- ── Submit — only shown when signed doc is uploaded ── -->
                    <button name="action_submit" type="object"
                            string="Submit for CEO Approval" class="btn-primary"
                            invisible="state != 'draft' or not signed_sheet"
                            groups="site_operations.group_site_accountant"/>
                    <!-- ── CEO Approval ── -->
                    <button name="action_ceo_approve" type="object"
                            string="Approve" class="btn-success"
                            invisible="state != 'submitted'"
                            groups="purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_matracon_admin"/>
                    <button name="action_create_payment" type="object"
                            string="Create Payment" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="site_operations.group_finance_ho,purchase_demand_raise.group_head_office"/>
                    <button name="action_issue_wht_certificates" type="object"
                            string="Issue WHT Certificates (Sec 149)"
                            class="btn-secondary"
                            invisible="state not in ('approved', 'paid') or total_wht == 0"
                            groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"/>
                    <!-- ── Download PDF for non-draft states ── -->
                    <button name="action_download_pdf" type="object"
                            string="⬇ Download PDF"
                            class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_delete_draft" type="object"
                            string="Delete" class="btn-danger"
                            invisible="state != 'draft'"
                            confirm="This salary sheet will be permanently deleted. Are you sure?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not payment_ids">
                            <field name="payment_ids" widget="statinfo" string="Payments"/>
                        </button>
                        <button type="button" class="oe_stat_button" icon="fa-users">
                            <field name="workforce_count" widget="statinfo" string="Workforce"/>
                        </button>
                        <button type="button" class="oe_stat_button" icon="fa-money">
                            <field name="total_basic" widget="statinfo" string="Gross Basic"/>
                        </button>
                        <button type="button" class="oe_stat_button" icon="fa-minus-circle">
                            <field name="total_deductions" widget="statinfo" string="Deductions"/>
                        </button>
                        <button type="button" class="oe_stat_button" icon="fa-check-circle">
                            <field name="total_net" widget="statinfo" string="Net Payable"/>
                        </button>
                        <button name="action_view_wht_certificates" type="object"
                                class="oe_stat_button" icon="fa-certificate"
                                invisible="wht_certificate_count == 0">
                            <field name="wht_certificate_count" widget="statinfo" string="WHT Certs"/>
                        </button>
                    </div>
                    <field name="wht_certificate_count" invisible="1"/>
                    <group>
                        <field name="project_analytic_account_id" readonly="1"/>
                        <field name="date_from" readonly="1"/>
                        <field name="date_to" readonly="1"/>
                        <field name="attendance_sheet_id" readonly="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>

                    <!-- ── Signed Document upload (required before Submit) ── -->
                    <group string="Signed Salary Sheet (Required before Submit)"
                           invisible="state not in ('draft',) or signed_sheet"
                           name="matracon_signed_upload_pending">
                        <div class="alert alert-warning" role="alert" colspan="2">
                            Download the sheet → get it signed by PM &amp; Site Accountant → upload the signed copy here. The <b>Submit for CEO Approval</b> button appears once uploaded.
                        </div>
                        <field name="signed_sheet"
                               widget="binary"
                               filename="signed_sheet_filename"
                               string="Upload Signed Copy"
                               readonly="state != 'draft'"/>
                        <field name="signed_sheet_filename" invisible="1"/>
                    </group>
                    <group string="Signed Salary Sheet"
                           invisible="not signed_sheet"
                           name="matracon_signed_upload_done">
                        <field name="signed_sheet"
                               widget="binary"
                               filename="signed_sheet_filename"
                               string="Signed Copy"
                               readonly="state != 'draft'"/>
                        <field name="signed_sheet_filename" invisible="1"/>
                    </group>

                    <notebook>
                        <page string="Payroll Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="paid_days" optional="show"
                                           help="Paid days in month (supports fractions, e.g. 10.5 for daily-wage workers)"/>
                                    <field name="detail_basic_full" string="Monthly Basic" optional="show" readonly="1"/>
                                    <field name="basic_salary" string="Basic (Paid Days)" readonly="1"/>
                                    <field name="allowances" readonly="1"/>
                                    <field name="outstanding_advance"
                                           string="Outstanding Advance"
                                           readonly="1"
                                           optional="show"/>
                                    <field name="advance_to_deduct"
                                           string="Advance to Deduct"
                                           optional="show"/>
                                    <field name="outstanding_backcharge"
                                           string="Outstanding Backcharge"
                                           readonly="1"
                                           optional="show"/>
                                    <field name="backcharge_to_deduct"
                                           string="Backcharge to Deduct"
                                           optional="show"/>
                                    <field name="deductions" readonly="1"/>
                                    <field name="net_payable" readonly="1"/>
                                    <button name="action_open_slip" type="object"
                                            string="Slip" icon="fa-file-text-o"
                                            groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,base.group_system"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_salary_sheet_line_form_ho" model="ir.ui.view">
        <field name="name">x.salary.sheet.line.form.ho</field>
        <field name="model">x.salary.sheet.line</field>
        <field name="arch" type="xml">
            <form string="Salary Slip" class="matracon-salary-slip">
                <sheet>
                    <group>
                        <field name="employee_id" readonly="1"/>
                        <field name="paid_days" readonly="1"
                               help="Days worked this month (fractions supported for daily-wage workers)"/>
                    </group>
                    <group string="Earnings">
                        <field name="detail_basic_full" readonly="1" string="Monthly Basic (Full)"/>
                        <field name="basic_salary" readonly="1" string="Basic (Paid Days)"/>
                        <field name="detail_hra" readonly="1"/>
                        <field name="detail_site_allowance" readonly="1"/>
                        <field name="allowances" readonly="1"/>
                    </group>
                    <group string="Deductions">
                        <field name="detail_wht" readonly="1"/>
                        <field name="detail_eobi" readonly="1"/>
                        <field name="outstanding_advance"
                               readonly="1"
                               string="Outstanding Advance (before deduction)"/>
                        <field name="advance_to_deduct"
                               readonly="1"
                               string="Advance Recovered"/>
                        <field name="outstanding_backcharge"
                               readonly="1"
                               string="Outstanding Backcharge (before deduction)"/>
                        <field name="backcharge_to_deduct"
                               readonly="1"
                               string="Backcharge Recovered (Assets)"/>
                        <field name="deductions" readonly="1"/>
                    </group>
                    <group>
                        <field name="net_payable" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_salary_sheet_list" model="ir.ui.view">
        <field name="name">x.salary.sheet.list</field>
        <field name="model">x.salary.sheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_analytic_account_id"/>
                <field name="date_from"/>
                <field name="workforce_count"/>
                <field name="total_net"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="action_salary_sheet" model="ir.actions.act_window">
        <field name="name">Salary Sheets</field>
        <field name="res_model">x.salary.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
