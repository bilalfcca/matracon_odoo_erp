<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_site_ops" model="ir.ui.view">
        <field name="name">account.payment.form.site.ops</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <!-- Payment Type: make readonly so only the relevant option is visible.
                 When the form is opened from Vendor Payments, payment_type is
                 'outbound' (Send) and the readonly radio shows just "Send".
                 When opened from Customer Payments, it shows just "Receive".
                 Without readonly, both Send/Receive radio buttons are always shown
                 which confuses users who should not be able to switch types. -->
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Hide Odoo default payment state bar when using Matracon liability workflow -->
            <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                <attribute name="invisible">payment_type == 'outbound' and (x_liability_sheet_id or x_ceo_direct_payment)</attribute>
            </xpath>

            <!-- Hide standard Confirm button for:
                 1. CEO-only viewers on their own direct payments
                 2. ALL regular vendor payments — Finance HO uses "Set In Process" instead
                    (which internally calls action_post). Showing both is confusing. -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="invisible">(x_ceo_direct_payment and x_viewer_is_ceo_only) or (payment_type == 'outbound' and x_payment_category == 'vendor' and not x_ceo_direct_payment and not x_liability_sheet_id)</attribute>
            </xpath>

            <!-- Hide standard Cancel button for vendor payments that are already
                 submitted or CEO-approved — clutters the header alongside Set In Process -->
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">payment_type == 'outbound' and x_payment_category == 'vendor' and not x_ceo_direct_payment and not x_liability_sheet_id and x_ceo_approval_state in ('submitted', 'approved')</attribute>
            </xpath>

            <!-- Stat buttons -->
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_wht_certificates"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-certificate"
                            invisible="x_wht_certificate_count == 0">
                        <field name="x_wht_certificate_count"
                               widget="statinfo"
                               string="WHT Certs"/>
                    </button>
                    <!-- WHT companion payment button (visible on original payment) -->
                    <button type="object"
                            name="action_open_wht_payment"
                            class="oe_stat_button"
                            icon="fa-university"
                            invisible="not x_wht_payment_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">WHT Payment</span>
                            <span class="o_stat_text">FBR</span>
                        </div>
                    </button>
                    <!-- Back-link on the WHT payment itself -->
                    <button type="object"
                            name="action_open_origin_payment"
                            class="oe_stat_button"
                            icon="fa-arrow-left"
                            invisible="not x_origin_payment_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Origin</span>
                            <span class="o_stat_text">Payment</span>
                        </div>
                    </button>
                    <!-- Tax deduction journal entry -->
                    <button type="object"
                            name="action_open_tax_deduction_move"
                            class="oe_stat_button"
                            icon="fa-scissors"
                            invisible="not x_tax_deduction_move_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Deduction</span>
                            <span class="o_stat_text">Entry</span>
                        </div>
                    </button>
                    <!-- Journal entry smart button -->
                    <button type="object"
                            name="action_open_journal_entry"
                            class="oe_stat_button"
                            icon="fa-book"
                            invisible="not move_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Journal</span>
                            <span class="o_stat_text">Entry</span>
                        </div>
                    </button>
                </div>
                <field name="x_wht_payment_id" invisible="1"/>
                <field name="x_origin_payment_id" invisible="1"/>
                <field name="x_tax_deduction_move_id" invisible="1"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <!-- Role + direct-payment flags (invisible helpers) -->
                <field name="x_ceo_direct_payment" invisible="1"/>
                <field name="x_ceo_submitted" invisible="1"/>
                <field name="x_viewer_is_fo" invisible="1"/>
                <field name="x_viewer_is_ceo_only" invisible="1"/>

                <!-- CEO: approve salary/petty cash/vendor payments.
                     Also accepts 'submitted' state (FO already notified CEO). -->
                <button name="action_ceo_approve_payment"
                        type="object"
                        string="Approve (CEO)"
                        class="btn-success"
                        groups="purchase_demand_raise.group_ceo_approval"
                        invisible="x_ceo_approval_state not in ('pending', 'submitted')"/>

                <!-- Finance HO: FIRST submission — only visible when still in 'pending'
                     (not yet sent to CEO).  After click, state → 'submitted' and this
                     button disappears; the Re-notify button below takes its place. -->
                <button name="action_notify_ceo_for_approval"
                        type="object"
                        string="▶ Submit to CEO"
                        class="btn-warning"
                        groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"
                        invisible="x_ceo_approval_state != 'pending' or payment_type != 'outbound' or x_payment_category != 'vendor'"/>

                <!-- Finance HO: re-notify CEO if they haven't acted yet.
                     Visible only after first submission ('submitted') while still waiting. -->
                <button name="action_notify_ceo_for_approval"
                        type="object"
                        string="↻ Re-notify CEO"
                        class="btn-secondary"
                        groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"
                        invisible="x_ceo_approval_state != 'submitted' or payment_type != 'outbound' or x_payment_category != 'vendor'"/>

                <field name="x_payment_category" invisible="1"/>
                <!-- Show approval badge for all outbound payments that use CEO approval
                     (vendor, salary, petty_cash) — hidden for CEO direct payments which
                     bypass the approval flow, and for inbound receipts. -->
                <field name="x_ceo_approval_state"
                       invisible="payment_type != 'outbound' or x_ceo_direct_payment"
                       readonly="1"
                       widget="badge"
                       decoration-warning="x_ceo_approval_state == 'pending'"
                       decoration-info="x_ceo_approval_state == 'submitted'"
                       decoration-success="x_ceo_approval_state == 'approved'"
                       decoration-muted="x_ceo_approval_state == 'not_required'"/>

                <!-- CEO Direct Payment: statusbar + Submit button -->
                <field name="x_payment_status"
                       widget="statusbar"
                       statusbar_visible="draft,in_process,paid"
                       invisible="payment_type != 'outbound' or (not x_liability_sheet_id and not x_ceo_direct_payment)"/>

                <!-- CEO submits their direct payment to FO -->
                <button name="action_ceo_submit_to_fo"
                        type="object"
                        string="Submit to Finance HO"
                        class="btn-primary"
                        groups="purchase_demand_raise.group_ceo_approval"
                        invisible="not x_ceo_direct_payment or x_viewer_is_fo or state != 'draft' or x_ceo_submitted"/>

                <!-- Print Cheque button -->
                <button name="action_print_cheque" type="object"
                        string="Print Cheque" class="btn-secondary" icon="fa-print"
                        invisible="not x_is_cheque_payment or state == 'draft'"/>

                <!-- FO buttons (hidden from CEO-only viewers on their own direct payments) -->
                <button name="action_set_in_process"
                        type="object"
                        string="Set In Process"
                        class="btn-primary"
                        groups="site_operations.group_finance_ho,purchase_demand_raise.group_head_office"
                        invisible="x_payment_status != 'draft' or payment_type != 'outbound' or (x_payment_category == 'vendor' and not x_ceo_direct_payment and not x_liability_sheet_id and x_ceo_approval_state != 'approved')"/>

                <button name="action_mark_paid"
                        type="object"
                        string="Mark Paid (FO)"
                        class="btn-success"
                        groups="site_operations.group_finance_ho,purchase_demand_raise.group_head_office"
                        invisible="x_payment_status != 'in_process' or payment_type != 'outbound'"/>
            </xpath>

            <xpath expr="//field[@name='amount']" position="before">
                <field name="x_liability_sheet_line_id" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

            <!-- Hide partner_id for petty cash and salary — no individual vendor -->
            <!-- Customer field: restore partner_type guard + add our category guard -->
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][1]" position="attributes">
                <attribute name="invisible">partner_type != 'customer' or x_payment_category in ('petty_cash', 'salary')</attribute>
                <attribute name="required">partner_type == 'customer' and x_payment_category not in ('petty_cash', 'salary')</attribute>
            </xpath>
            <!-- Vendor field: hidden for petty_cash/salary; on WHT payments x_payee_id takes over -->
            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="attributes">
                <attribute name="invisible">partner_type != 'supplier' or x_payment_category in ('petty_cash', 'salary') or x_origin_payment_id</attribute>
                <attribute name="required">partner_type == 'supplier' and x_payment_category not in ('petty_cash', 'salary') and not x_origin_payment_id</attribute>
            </xpath>

            <xpath expr="//group[@name='group1']/field[@name='partner_id'][2]" position="after">
                <!-- WHT companion payment: dedicated Payee field (always editable) -->
                <field name="x_payee_id"
                       invisible="not x_origin_payment_id"
                       options="{'no_quick_create': True}"/>

                <field name="x_liability_sheet_line_id" invisible="1"/>

                <field name="x_gross_approved_amount"
                       readonly="1"
                       invisible="not x_liability_sheet_line_id"/>

                <field name="x_fund_project_id"
                       string="Fund Project (Client Receipt)"
                       invisible="payment_type != 'inbound'"
                       required="payment_type == 'inbound'"/>

                <!-- Vendor Bank Account — removed from UI (kept in model for data integrity) -->
                <field name="x_vendor_bank_account_id" invisible="1"/>

                <field name="x_salary_sheet_id"
                       readonly="1"
                       invisible="not x_salary_sheet_id"
                       string="Salary Sheet"/>

                <field name="x_gross_approved_amount"
                       readonly="1"
                       string="Gross Salary"
                       invisible="x_payment_category != 'salary' or not x_gross_approved_amount"/>

                <field name="x_liability_sheet_id"
                       readonly="1"
                       invisible="payment_type != 'outbound' or not x_liability_sheet_id or x_payment_category == 'petty_cash'"/>

                <field name="x_destination_project_id"
                       string="Destination Project (Payment For)"
                       invisible="payment_type != 'outbound'"
                       required="payment_type == 'outbound' and (x_liability_sheet_id or x_payment_category in ('petty_cash', 'salary'))"/>

                <!-- HO Advance checkbox — removed from UI (legacy; kept in model for existing data) -->
                <field name="x_is_ho_advance" invisible="1"/>

                <!-- Expense Account: optional override for the payable/expense account in the JE -->
                <field name="x_expense_account_id"
                       string="Expense Account"
                       invisible="payment_type != 'outbound' or x_payment_category in ('salary', 'petty_cash')"
                       options="{'no_create': True}"
                       domain="[('active', '=', True)]"
                       help="Optional: override which account is debited in the payment journal entry. Leave blank to use the vendor's default payable account. IPC payment tracking is based on the vendor contact, so any account selection works."/>

                <!-- x_source_project_ids kept in model; entry is via Fund Allocation tab lines only -->
                <field name="x_source_project_ids" widget="many2many_tags" invisible="1"/>

            </xpath>

            <!-- ── Journal: hidden from form — auto-set from first Bank Fund row ──
                 journal_id is required by Odoo for posting but FO no longer
                 touches it directly. It is set via
                 _onchange_bank_allocations_set_journal when the first bank
                 is added to the Bank Fund tab. -->
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Source Banks: hidden from form — entry via Bank Fund tab only -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="x_available_bank_balance"
                       string="Bank Balance"
                       readonly="1"
                       invisible="1"/>
                <field name="x_source_journal_ids"
                       widget="many2many_tags"
                       string="Source Banks"
                       invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='x_available_bank_balance']" position="after">
                <!-- Header cheque — only when NOT using per-bank allocation lines -->
                <field name="x_cheque_number"
                       invisible="payment_type != 'outbound' or not x_is_cheque_payment or (x_ceo_direct_payment and x_viewer_is_ceo_only) or x_bank_allocation_ids"
                       required="payment_type == 'outbound' and x_is_cheque_payment and x_liability_sheet_id and not x_bank_allocation_ids"/>
                <button name="action_assign_cheque_number" type="object"
                        string="Auto Assign Cheque No"
                        class="btn-secondary"
                        invisible="not x_is_cheque_payment or x_cheque_number or (x_ceo_direct_payment and x_viewer_is_ceo_only) or x_bank_allocation_ids"/>
            </xpath>

            <xpath expr="//field[@name='x_ceo_direct_payment']" position="after">
                <field name="x_is_cheque_payment" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <!-- Fund Allocation tab — project pool tracking -->
                <page name="fund_allocation_tab"
                      string="Fund Allocation &amp; Tracking"
                      invisible="payment_type != 'outbound' or (x_ceo_direct_payment and x_viewer_is_ceo_only)">
                    <field name="x_allocation_ids" widget="one2many">
                        <list string="Fund Allocation" editable="bottom">
                            <field name="project_analytic_account_id" string="Source Project"/>
                            <field name="available_balance" string="Available Project Balance" readonly="1"/>
                            <field name="allocation_amount" string="Allocation Amount"/>
                        </list>
                    </field>
                </page>

                <!-- Bank Fund tab — per-bank balance, allocation, and cheque tracking -->
                <page name="bank_fund_tab"
                      string="Bank Fund"
                      invisible="payment_type != 'outbound' or (x_ceo_direct_payment and x_viewer_is_ceo_only)">
                    <!-- Cheque payments: show cheque guidance -->
                    <div class="text-muted small mb-2"
                         invisible="not x_is_cheque_payment">
                        Add source banks below. Each bank can have its own cheque number.
                    </div>
                    <!-- Manual/cash payments: no cheque numbers needed -->
                    <div class="text-muted small mb-2"
                         invisible="x_is_cheque_payment">
                        Add source cash or bank journals below for this payment.
                    </div>
                    <field name="x_is_cheque_payment" invisible="1"/>
                    <field name="x_bank_allocation_ids" widget="one2many">
                        <list string="Bank Fund" editable="bottom">
                            <field name="journal_id" string="Bank / Journal"
                                   domain="[('type', 'in', ('bank', 'cash'))]"
                                   options="{'no_create': True}"/>
                            <field name="available_balance" string="Available Bank Balance" readonly="1"/>
                            <field name="allocation_amount" string="Allocation Amount"/>
                            <!-- Cheque No.: only shown when payment method is a cheque type -->
                            <field name="x_cheque_number" string="Cheque No."
                                   invisible="not parent.x_is_cheque_payment"/>
                            <!-- Auto Assign: hidden when already has a cheque no. OR when not cheque payment -->
                            <button name="action_assign_cheque_number"
                                    type="object"
                                    string="Auto Assign"
                                    title="Auto-assign next cheque number from the active series"
                                    class="btn-secondary btn-sm"
                                    invisible="x_cheque_number or not parent.x_is_cheque_payment"/>
                        </list>
                    </field>
                </page>

                <!-- Tax Compliance tab — all outbound payments -->
                <page name="tax_compliance_tab"
                      string="Tax Compliance"
                      invisible="payment_type != 'outbound'">
                    <field name="x_tax_line_ids" nolabel="1">
                        <list string="Tax Lines" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" string="Description"
                                   optional="show"/>
                            <field name="tax_type" string="Deduction Type"/>
                            <field name="tax_id" string="Tax Record" optional="show"/>
                            <field name="x_fixed_amount" string="Fixed Amt" optional="show"/>
                            <field name="effect" string="Effect"/>
                            <field name="amount" string="Deducted Amount" readonly="1"/>
                        </list>
                    </field>
                    <div class="d-flex justify-content-end gap-5 py-3 pe-3 border-top mt-2">
                        <div class="text-end">
                            <div class="text-muted small fw-bold text-uppercase" style="font-size:0.75em;">Total Deducted</div>
                            <field name="x_total_tax_amount" nolabel="1" readonly="1" class="fw-bold"/>
                        </div>
                        <div class="text-end">
                            <div class="text-muted small fw-bold text-uppercase" style="font-size:0.75em;">Net Payable</div>
                            <field name="x_net_payable" nolabel="1" readonly="1" class="fw-bold text-success fs-5"/>
                        </div>
                    </div>
                    <!-- FBR WHT payment button — vendor payments only, not salary -->
                    <div invisible="state not in ('in_process', 'paid', 'partial') or not x_wht_amount or x_payment_category == 'salary'"
                         class="mt-3">
                        <button name="action_generate_wht_certificate"
                                type="object"
                                string="Generate WHT Certificate"
                                class="btn-warning"
                                groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ── Standard vendor-payment list: replace Odoo's "State" badge ──────────
         Inherits account.view_account_supplier_payment_tree (vendor payments)
         and account.view_account_various_payment_tree (all payments).
         Replaces the generic "Draft/Posted" state badge with:
           • x_ceo_approval_state  — Pending CEO / Awaiting CEO / CEO Approved
           • x_payment_status      — Draft / In Process / Paid  (optional)
         The original state field is made optional so it can be shown if needed. -->
    <record id="view_matracon_supplier_payment_list_inherit" model="ir.ui.view">
        <field name="name">account.payment.matracon.list.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <!-- Replace the standard state badge with our two-level status -->
            <field name="state" position="replace">
                <!-- CEO approval state — main status for vendor payments -->
                <field name="x_ceo_approval_state"
                       widget="badge"
                       string="Approval"
                       decoration-warning="x_ceo_approval_state == 'pending'"
                       decoration-info="x_ceo_approval_state == 'submitted'"
                       decoration-success="x_ceo_approval_state == 'approved'"
                       decoration-muted="x_ceo_approval_state == 'not_required'"/>
                <!-- Processing state — secondary column, hidden by default -->
                <field name="x_payment_status"
                       widget="badge"
                       string="Process Status"
                       optional="hide"
                       decoration-muted="x_payment_status == 'draft'"
                       decoration-warning="x_payment_status == 'in_process'"
                       decoration-success="x_payment_status == 'paid'"/>
            </field>
        </field>
    </record>

    <!-- Apply the same override to the "various payments" list (used on some menus) -->
    <record id="view_matracon_various_payment_list_inherit" model="ir.ui.view">
        <field name="name">account.payment.matracon.various.list.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_various_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="replace">
                <field name="x_ceo_approval_state"
                       widget="badge"
                       string="Approval"
                       decoration-warning="x_ceo_approval_state == 'pending'"
                       decoration-info="x_ceo_approval_state == 'submitted'"
                       decoration-success="x_ceo_approval_state == 'approved'"
                       decoration-muted="x_ceo_approval_state == 'not_required'"/>
                <field name="x_payment_status"
                       widget="badge"
                       string="Process Status"
                       optional="hide"
                       decoration-muted="x_payment_status == 'draft'"
                       decoration-warning="x_payment_status == 'in_process'"
                       decoration-success="x_payment_status == 'paid'"/>
            </field>
        </field>
    </record>

    <record id="view_ho_payment_list" model="ir.ui.view">
        <field name="name">account.payment.ho.list</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Finance HO Payments"
                  decoration-success="state == 'posted'"
                  decoration-warning="x_payment_status == 'in_process'"
                  decoration-muted="state == 'draft'">
                <field name="name" string="Reference"/>
                <field name="date" string="Payment Date"/>
                <field name="partner_id" string="Vendor"/>
                <field name="x_liability_sheet_id" string="Liability Sheet" optional="show"/>
                <field name="x_gross_approved_amount" string="CEO Approved" optional="show"/>
                <field name="x_destination_project_id" string="Destination Project" optional="show"/>
                <field name="amount" string="Net Payable"/>
                <field name="x_total_tax_amount" string="Taxes" optional="show"/>
                <field name="journal_id" string="Source Bank" optional="show"/>
                <field name="x_cheque_number" string="Cheque No." optional="show"/>
                <field name="x_ceo_approval_state"
                       string="Approval"
                       widget="badge"
                       decoration-warning="x_ceo_approval_state == 'pending'"
                       decoration-info="x_ceo_approval_state == 'submitted'"
                       decoration-success="x_ceo_approval_state == 'approved'"
                       decoration-muted="x_ceo_approval_state == 'not_required'"/>
                <field name="x_payment_status" string="Process" widget="badge" optional="show"
                       decoration-muted="x_payment_status == 'draft'"
                       decoration-warning="x_payment_status == 'in_process'"
                       decoration-success="x_payment_status == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_ho_payment_search" model="ir.ui.view">
        <field name="name">account.payment.ho.search</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <search string="Search HO Payments">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="x_liability_sheet_id"/>
                <field name="x_destination_project_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_ceo_approved" string="From Liability Sheet"
                        domain="[('x_liability_sheet_id', '!=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ho_vendor_payments" model="ir.actions.act_window">
        <field name="name">Finance Payments</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'outbound'), ('partner_type', '=', 'supplier')]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_ho_payment_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_account_payment_form_site_ops')}),
        ]"/>
        <field name="search_view_id" ref="view_ho_payment_search"/>
        <field name="context">{'default_payment_type': 'outbound', 'default_partner_type': 'supplier'}</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Fix 1: Accounting → Customers → Payments
         Standard action uses search_default_inbound_filter (user can clear it).
         Override domain to HARD-FILTER inbound only — received payments only.
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="account.action_account_payments" model="ir.actions.act_window">
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         Fix 2: Accounting → Vendors → Payments
         Standard action uses search_default_outbound_filter (user can clear it).
         Override domain to HARD-FILTER outbound only — sent payments only.
         ═══════════════════════════════════════════════════════════════════ -->
    <record id="account.action_account_payments_payable" model="ir.actions.act_window">
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
