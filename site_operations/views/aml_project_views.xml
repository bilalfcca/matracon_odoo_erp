<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal Items (Chart of Accounts → Balance): search + Group By Project -->
    <record id="view_account_move_line_filter_project" model="ir.ui.view">
        <field name="name">account.move.line.search.project</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_project_id" string="Project"/>
            </xpath>
            <filter name="group_by_partner" position="after">
                <filter string="Project" name="group_by_project" domain="[]" context="{'group_by': 'x_project_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_move_line_tree_project" model="ir.ui.view">
        <field name="name">account.move.line.list.project</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="x_project_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Journal Entries: Group By Project (existing header field) -->
    <record id="view_account_move_filter_project" model="ir.ui.view">
        <field name="name">account.move.search.project</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="x_project_analytic_account_id" string="Project"/>
                <group>
                    <filter string="Project" name="group_by_project_mtr" domain="[]"
                            context="{'group_by': 'x_project_analytic_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
