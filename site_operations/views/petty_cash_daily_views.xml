<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Petty Cash → Daily Balances: opening / cash in / cash out / closing per
         project per day, from posted entries in date order. -->
    <record id="view_petty_cash_daily_balance_list" model="ir.ui.view">
        <field name="name">x.petty.cash.daily.balance.list</field>
        <field name="model">x.petty.cash.daily.balance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="project_id, date desc">
                <field name="date"/>
                <field name="project_id"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="opening_balance"/>
                <field name="cash_in" sum="Total In" decoration-success="cash_in"/>
                <field name="cash_out" sum="Total Out" decoration-danger="cash_out"/>
                <field name="closing_balance" decoration-bf="1"/>
                <button name="action_open_entries" type="object" string="Entries" icon="fa-list" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_petty_cash_daily_balance_search" model="ir.ui.view">
        <field name="name">x.petty.cash.daily.balance.search</field>
        <field name="model">x.petty.cash.daily.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="date"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="last_30" string="Last 30 Days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="date_filter" string="Date" date="date"/>
                <group>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_petty_cash_daily_balance" model="ir.actions.act_window">
        <field name="name">Petty Cash Daily Balances</field>
        <field name="res_model">x.petty.cash.daily.balance</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No petty cash movements yet</p>
            <p>Each day's opening equals the previous day's closing; back-dated
               entries update that day and every day after it.</p>
        </field>
    </record>

    <menuitem id="menu_petty_cash_daily_balance"
              name="Daily Balances"
              parent="site_operations.menu_petty_cash_root"
              action="action_petty_cash_daily_balance"
              sequence="25"
              groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin,purchase_demand_raise.group_ceo_approval,base.group_system,site_operations.group_accountant_ho"/>

    <!-- Site accountants: own project only (same as the petty cash fund rule) -->
    <record id="rule_petty_cash_daily_balance_site_accountant" model="ir.rule">
        <field name="name">Petty Cash Daily Balance: Site Accountant own project</field>
        <field name="model_id" ref="model_x_petty_cash_daily_balance"/>
        <field name="domain_force">[('project_id', '=', user.x_default_analytic_account_id.id)]</field>
        <field name="groups" eval="[(4, ref('site_operations.group_site_accountant'))]"/>
    </record>

    <!-- Fund form: manual recalculation (Finance HO / Admin) -->
    <record id="view_petty_cash_fund_form_recalc" model="ir.ui.view">
        <field name="name">x.petty.cash.fund.form.recalc</field>
        <field name="model">x.petty.cash.fund</field>
        <field name="inherit_id" ref="site_operations.view_petty_cash_fund_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_recalculate_balances" type="object" string="Recalculate Balances"
                            icon="fa-refresh"
                            groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin,base.group_system"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
