<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipts: Source Document is picked from confirmed POs still to be
         received (instead of free text); selecting one fills in the lines. -->
    <record id="view_picking_form_po_receipt" model="ir.ui.view">
        <field name="name">stock.picking.form.po.receipt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="before">
                <field name="x_source_po_id"
                       invisible="picking_type_code != 'incoming' or x_transfer_purpose"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_quick_create': True}"
                       placeholder="Select a Purchase Order"/>
            </xpath>
            <!-- Keep each line's PO-line link when lines come from the selected PO. -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="purchase_line_id" column_invisible="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="invisible">x_transfer_purpose in ['material_issuance', 'site_to_site'] or (picking_type_code == 'incoming' and not x_transfer_purpose)</attribute>
            </xpath>
            <!-- Make "Receiving Now" and "Original Demand" visible and editable when x_source_po_id is set, even in draft -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity'][2]" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code != 'incoming' or (not parent.purchase_id and not parent.x_source_po_id)</attribute>
                <attribute name="readonly">parent.state in ('done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty'][2]" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code != 'incoming' or (not parent.purchase_id and not parent.x_source_po_id)</attribute>
            </xpath>
            <!-- Ensure duplicate fallback original columns remain hidden when x_source_po_id is set -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity'][1]" position="attributes">
                <attribute name="column_invisible">parent.state == 'draft' or (parent.picking_type_code == 'incoming' and (bool(parent.purchase_id) or bool(parent.x_source_po_id)))</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty'][1]" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming' and (bool(parent.purchase_id) or bool(parent.x_source_po_id))</attribute>
            </xpath>
            <!-- "Mark Received" buttons: ensure visible when x_source_po_id is set -->
            <xpath expr="//button[@name='button_validate'][hasclass('oe_highlight')][hasclass('o_btn_mark_received')]" position="attributes">
                <attribute name="invisible">picking_type_code != 'incoming' or (not purchase_id and not x_source_po_id) or state in ('draft', 'confirmed', 'done', 'cancel')</attribute>
            </xpath>
            <xpath expr="//button[@name='button_validate'][hasclass('o_btn_validate')][hasclass('o_btn_mark_received')]" position="attributes">
                <attribute name="invisible">picking_type_code != 'incoming' or (not purchase_id and not x_source_po_id) or state in ('waiting', 'assigned', 'done', 'cancel')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
