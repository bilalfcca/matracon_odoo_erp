<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         Employee Backcharge — Form View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_employee_backcharge_form" model="ir.ui.view">
        <field name="name">x.employee.backcharge.form</field>
        <field name="model">x.employee.backcharge</field>
        <field name="arch" type="xml">
            <form string="Employee Backcharge">
                <header>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state in ('cancelled', 'cleared')"
                            groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"/>
                    <button name="action_reopen" type="object"
                            string="Re-open" class="btn-secondary"
                            invisible="state != 'cancelled'"
                            groups="site_operations.group_finance_ho,purchase_demand_raise.group_matracon_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,partial,cleared"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="project_analytic_account_id" string="Site Project" readonly="1"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="backcharge_amount"/>
                            <field name="recovered_amount" readonly="1"/>
                            <field name="remaining_amount" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Details">
                            <field name="description"/>
                            <field name="issue_date"/>
                            <field name="backcharge_date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Reason / additional notes..."/>
                    <notebook>
                        <page string="Deduction History" name="deductions">
                            <field name="deduction_ids" readonly="1">
                                <list>
                                    <field name="deduction_date"/>
                                    <field name="salary_sheet_id" string="Salary Sheet"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Employee Backcharge — List View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_employee_backcharge_list" model="ir.ui.view">
        <field name="name">x.employee.backcharge.list</field>
        <field name="model">x.employee.backcharge</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="project_analytic_account_id" string="Site"/>
                <field name="description"/>
                <field name="backcharge_date"/>
                <field name="backcharge_amount"/>
                <field name="recovered_amount"/>
                <field name="remaining_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'partial'"
                       decoration-success="state == 'cleared'"
                       decoration-danger="state == 'cancelled'"
                       decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Employee Backcharge — Search View
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_employee_backcharge_search" model="ir.ui.view">
        <field name="name">x.employee.backcharge.search</field>
        <field name="model">x.employee.backcharge</field>
        <field name="arch" type="xml">
            <search string="Search Backcharges">
                <field name="employee_id"/>
                <field name="description"/>
                <field name="name"/>
                <filter string="Open" name="filter_open"
                        domain="[('state', '=', 'open')]"/>
                <filter string="Partially Recovered" name="filter_partial"
                        domain="[('state', '=', 'partial')]"/>
                <filter string="Cleared" name="filter_cleared"
                        domain="[('state', '=', 'cleared')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', 'in', ['open', 'partial'])]"/>
                <separator/>
                <filter string="Group by Employee" name="group_employee"
                        context="{'group_by': 'employee_id'}"/>
                <filter string="Group by Site" name="group_site"
                        context="{'group_by': 'project_analytic_account_id'}"/>
                <filter string="Group by Status" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         Employee Backcharge — Window Action
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_employee_backcharge" model="ir.actions.act_window">
        <field name="name">Employee Backcharges</field>
        <field name="res_model">x.employee.backcharge</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
