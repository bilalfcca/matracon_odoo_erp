<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vendor_bill_site_ops_form" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.site.ops.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- "Posted" ribbon — visible on vendor bills that are confirmed but
                 not yet paid/in-payment.  Mirrors what the statusbar shows so
                 that the printed-doc preview and the form header are in sync.
                 The standard "Paid" / "In Payment" ribbons stay untouched.
                 Inserted before the invisible payment_state field so it sits
                 in the same block as all other ribbon widgets. -->
            <xpath expr="//field[@name='payment_state']" position="before">
                <widget name="web_ribbon" title="Posted"
                        bg_color="text-bg-success"
                        invisible="move_type != 'in_invoice' or state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
            </xpath>

            <!-- Print Voucher — shown on posted journal entries only -->
            <xpath expr="//button[@name='button_draft']" position="before">
                <button name="action_print_journal_entry_voucher"
                        type="object"
                        string="Print Voucher"
                        icon="fa-print"
                        invisible="move_type != 'entry' or state != 'posted'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_liability_sheet"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-balance-scale"
                        invisible="move_type != 'in_invoice' or not x_liability_sheet_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Liability</span>
                        <span class="o_stat_text">Sheet</span>
                    </div>
                </button>
                <button name="action_view_purchase_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="move_type != 'in_invoice' or not x_purchase_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Purchase</span>
                        <span class="o_stat_text">Order</span>
                    </div>
                </button>
                <button name="action_view_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="move_type != 'in_invoice' or not x_purchase_order_id">
                    <field name="picking_count" widget="statinfo" string="Receipts"/>
                </button>
            </xpath>

            <!-- Confirm button: Odoo gates action_post on group_account_invoice, but
                 site accountants hold group_account_readonly (needed for Partner Ledger
                 / reporting menus not accessible with group_account_invoice alone).
                 These are mutually exclusive Odoo 19 privilege levels — we cannot
                 grant both.  Expose both action_post buttons (Post and Confirm) to
                 site accountants; the existing invisible conditions already ensure
                 only the Confirm variant is visible on vendor bills (move_type='entry'
                 is never true for bills so the Post variant stays hidden).
                 The action_post() override in account_move.py calls super() via sudo()
                 for site accountants so the internal group check does not raise
                 AccessError. -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="groups">account.group_account_invoice,site_operations.group_site_accountant</attribute>
            </xpath>

            <!-- Inject site_accountant_vendor context so the partner-creation dialog
                 pre-fills the "Vendor" tag and makes it read-only.
                 Preserves all existing Odoo context keys on this field.
                 no_quick_create forces "Create and Edit" so the full partner form
                 opens with the Vendor tag pre-filled from default_get. -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{
                    'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                    'show_address': 1, 'default_is_company': True, 'show_vat': True,
                    'site_accountant_vendor': True
                }</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_purchase_order_id"
                       invisible="move_type != 'in_invoice'"
                       options="{'no_create': True}"
                       placeholder="Link purchase order…"/>
                <field name="x_liability_sheet_id" invisible="1"/>
                <!-- Shown on both Vendor Bills and Customer Invoices.
                     Linking a customer invoice to a project analytic account
                     causes it to be counted in that project's Billed to Client total. -->
                <field name="x_project_analytic_account_id"
                       invisible="move_type not in ('in_invoice', 'out_invoice')"
                       options="{'no_create': True}"
                       placeholder="Select project…"/>
                <field name="x_wht_tax_id"
                       invisible="move_type != 'in_invoice'"
                       options="{'no_create': True}"/>
                <!-- Bill Copy — mandatory for vendor bills; shown prominently here
                     so it is never missed before posting. -->
                <!-- Bill Copy is not marked required in the view so the form
                     can be saved/auto-saved without it.  The server-side
                     action_post() check enforces the attachment at Confirm
                     time with a clear UserError message. -->
                <field name="x_bill_copy"
                       widget="binary"
                       filename="x_bill_copy_filename"
                       string="Bill Copy"
                       invisible="move_type != 'in_invoice'"/>
                <field name="x_bill_copy_filename" invisible="1"/>
            </xpath>

            <!-- Cheque / payment info — placed in the header left-group, below Reference.
                 The entry-specific ref field is the one WITHOUT nolabel="1" (the first ref
                 has nolabel to suppress its label for bills; the entry ref renders normally). -->
            <xpath expr="//field[@name='ref'][not(@nolabel)]" position="after">
                <field name="x_cheque_number"
                       invisible="move_type != 'entry'"
                       readonly="state == 'posted'"
                       string="Cheque No."
                       placeholder="e.g. CHQ-001 / RTGS-2026-001"/>
                <field name="x_account_title"
                       invisible="move_type != 'entry'"
                       readonly="state == 'posted'"
                       string="Account Title"
                       placeholder="Beneficiary name / bank account title"/>
            </xpath>

            <!-- Liability-registered info banner (kept before narration) -->
            <xpath expr="//field[@name='narration']" position="before">
                <div class="alert alert-info mb-2 py-1"
                     role="status"
                     invisible="not x_liability_registered">
                    <i class="fa fa-check-circle me-1"/>
                    Liability sheet updated —
                    <field name="x_liability_amount_registered" readonly="1" class="oe_inline"/>
                    registered.
                </div>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         SITE ACCOUNTANT — simplified vendor bill view
         •  Hides header fields irrelevant to receipt verification
            (Due Date, Payment Terms, Payment Reference).
         •  Hides the product-based "Invoice Lines" tab and the standard
            "Journal Items" tab; instead shows a site-accountant-only
            "Invoice Lines" tab that presents the same accounting entries
            (line_ids) in a clean, read-only list.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_vendor_bill_site_accountant_simplify" model="ir.ui.view">
        <field name="name">account.move.vendor.bill.site.accountant.simplify</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- 1. Payment Reference — not relevant for site receipt verification -->
            <xpath expr="//field[@name='payment_reference']" position="attributes">
                <attribute name="groups">!site_operations.group_site_accountant</attribute>
            </xpath>

            <!-- 2. Due Date label div (shared with Payment Terms label) -->
            <xpath expr="//div[hasclass('o_td_label')][label[@for='invoice_date_due']]" position="attributes">
                <attribute name="groups">!site_operations.group_site_accountant</attribute>
            </xpath>

            <!-- 3. Due Date / Payment Terms value div -->
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="groups">!site_operations.group_site_accountant</attribute>
            </xpath>

            <!-- 4. Standard "Invoice Lines" (product lines) tab — visible to everyone
                 including site accountants. We keep the purpose-built journal-items
                 tab (sa_invoice_lines, injected below) as the first tab so it
                 appears at the front of the tab bar for site accountants.
                 Restrict the account_id picker in that tab to site-allowed CoA
                 accounts when the user is a site accountant. -->
            <xpath expr="//page[@id='invoice_tab']//field[@name='account_id']" position="attributes">
                <attribute name="domain">[('x_ho_only', '=', False), '|', ('x_site_ids', '=', False), ('x_site_ids', 'in', [parent.x_user_analytic_id])] if parent.x_user_analytic_id else []</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>

            <!-- 5. Hide the standard "Journal Items" tab from site accountant so they
                 only see the purpose-built "Invoice Lines" tab injected below. -->
            <xpath expr="//page[@id='aml_tab']" position="attributes">
                <attribute name="groups">!site_operations.group_site_accountant</attribute>
            </xpath>

            <!-- 6. Site-accountant-only "Journal Entries" tab — EDITABLE in draft.
                 Site accountants can view the computed accounting result for
                 verification AND manually add/edit double-entry lines (debit/credit
                 with Chart-of-Accounts selection) as requested by the client.
                 The tab becomes read-only once the bill is posted (state != 'draft'). -->
            <xpath expr="//page[@id='invoice_tab']" position="before">
                <page string="Journal Entries"
                      name="sa_invoice_lines"
                      groups="site_operations.group_site_accountant">
                    <field name="line_ids" readonly="state != 'draft'">
                        <list string="Journal Entries"
                              editable="bottom"
                              decoration-muted="display_type in ('line_section', 'line_note')"
                              default_order="sequence, id">
                            <control>
                                <create string="Add a line"/>
                            </control>
                            <field name="account_id"
                                   required="display_type not in ('line_section', 'line_note')"
                                   domain="[('x_ho_only', '=', False), ('company_ids', 'parent_of', parent.company_id), '|', ('x_site_ids', '=', False), ('x_site_ids', 'in', [parent.x_user_analytic_id])] if parent.x_user_analytic_id else [('company_ids', 'parent_of', parent.company_id)]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="partner_id"
                                   optional="show"
                                   domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"/>
                            <field name="name" optional="show"/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"
                                   optional="show"
                                   readonly="parent.move_type in ('out_invoice', 'entry')"
                                   options="{'account_field': 'account_id'}"/>
                            <field name="debit" sum="Total Debit"
                                   invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/>
                            <field name="credit" sum="Total Credit"
                                   invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/>
                            <field name="display_type" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         CUSTOMER INVOICE — Finance HO form adjustments
         •  Hides Due Date / Payment Terms (not used in our workflow)
         •  Journal Entries tab first, Invoice Lines tab second
         •  Account picker: all CoA (sales + purchase) for HO users;
            site-restricted for site accountants
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_customer_invoice_site_ops_form" model="ir.ui.view">
        <field name="name">account.move.customer.invoice.site.ops.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- 1. Hide Due Date label for customer invoices AND journal entries
                     (journal entries have no meaningful due date in our workflow) -->
            <xpath expr="//div[hasclass('o_td_label')][label[@for='invoice_date_due']]" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'entry')</attribute>
            </xpath>

            <!-- 2. Hide Due Date / Payment Terms value div for customer invoices + journal entries -->
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'entry')</attribute>
            </xpath>

            <!-- 3. Hide standard Journal Items tab for customer invoices —
                     our custom Journal Entries tab (below) replaces it as tab 1 -->
            <xpath expr="//page[@id='aml_tab']" position="attributes">
                <attribute name="invisible">move_type == 'out_invoice'</attribute>
            </xpath>

            <!-- 4. Journal Entries tab — first tab on customer invoices for ALL users
                     (site accountants use the sa_invoice_lines tab from the view above).
                     EDITABLE in draft so users can add/edit double-entry lines manually.
                     Becomes read-only once the invoice is posted (state != 'draft').
                     Shows ALL journal lines including the auto-managed Account Receivable
                     so the running balance is always visible. -->
            <xpath expr="//page[@id='invoice_tab']" position="before">
                <page string="Journal Entries"
                      name="customer_journal_entries"
                      invisible="move_type != 'out_invoice'"
                      groups="!site_operations.group_site_accountant">
                    <field name="line_ids" readonly="state != 'draft'">
                        <list string="Journal Entries"
                              editable="bottom"
                              decoration-muted="display_type in ('line_section', 'line_note')"
                              default_order="sequence, id">
                            <control>
                                <create string="Add a line"/>
                            </control>
                            <field name="account_id"
                                   required="display_type not in ('line_section', 'line_note')"
                                   domain="[('company_ids', 'parent_of', parent.company_id)]"
                                   options="{'no_create': True}"/>
                            <field name="name" optional="show"/>
                            <field name="partner_id" optional="hide"/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"
                                   optional="show"
                                   options="{'account_field': 'account_id'}"/>
                            <field name="debit" sum="Total Debit"
                                   invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/>
                            <field name="credit" sum="Total Credit"
                                   invisible="display_type in ('line_section', 'line_subsection', 'line_note')"/>
                            <field name="display_type" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <!-- PO smart buttons: vendor bills + liability sheets -->
    <record id="view_purchase_order_site_ops_buttons" model="ir.ui.view">
        <field name="name">purchase.order.site.ops.buttons</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vendor_bills"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o"
                        groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin"
                        invisible="x_vendor_bill_count == 0">
                    <field name="x_vendor_bill_count" widget="statinfo" string="Vendor Bills"/>
                </button>
                <button name="action_view_liability_sheets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-balance-scale"
                        groups="site_operations.group_site_accountant,site_operations.group_finance_ho,purchase_demand_raise.group_procurement_ho,purchase_demand_raise.group_ceo_approval,purchase_demand_raise.group_head_office,purchase_demand_raise.group_matracon_admin"
                        invisible="x_liability_sheet_count == 0">
                    <field name="x_liability_sheet_count" widget="statinfo" string="Liability Sheets"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
