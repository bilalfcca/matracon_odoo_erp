<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         0.  Invoice Lines → Account column visible to site accountants
             Standard Odoo gates account_id in invoice lines on
             account.group_account_readonly. Site accountants have only
             group_account_invoice, so the column is hidden for them.
             We extend the groups to include group_site_accountant.

             UAT Point 5 — Head Office CoA unrestricted:
             HO users (group_head_office / group_finance_ho) see the complete
             Chart of Accounts in the account picker — no account_type domain
             filter and no search_default_type_* context pre-filter.
             Site accountants retain their existing site-scoped restrictions.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_invoice_line_account_site_accountant" model="ir.ui.view">
        <field name="name">account.move.form.invoice.line.account.site.accountant</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Expose user analytic + HO flag so domain/context below can reference them -->
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field name="x_user_analytic_id" invisible="1"/>
                <field name="x_user_is_ho" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='account_id'][@widget='many2one_account_account']" position="attributes">
                <attribute name="groups">account.group_account_readonly,site_operations.group_site_accountant</attribute>
                <!-- Domain:
                     • HO users (x_user_is_ho=True):  no account_type restriction — full CoA.
                     • Site accountants (x_user_analytic_id set): exclude receivable/payable/
                       off_balance AND restrict to accounts tagged for their site. -->
                <attribute name="domain">([('company_ids', 'parent_of', company_id)] if parent.x_user_is_ho else [('company_ids', 'parent_of', company_id), ('account_type', 'not in', ('asset_receivable', 'liability_payable', 'off_balance'))]) + (['|', ('x_site_ids', '=', False), ('x_site_ids', 'in', [parent.x_user_analytic_id])] if parent.x_user_analytic_id else [])</attribute>
                <!-- Context:
                     • HO users: all search_default_type_* and preferred_account_type → False,
                       so the picker opens with no type pre-filter.
                     • Non-HO: standard Odoo behaviour (expense pre-filter for bills,
                       income pre-filter for customer invoices). -->
                <attribute name="context">{'partner_id': partner_id, 'move_type': parent.move_type, 'search_default_type_asset_fixed': not parent.x_user_is_ho and 'in_' in parent.move_type, 'search_default_type_expense': not parent.x_user_is_ho and 'in_' in parent.move_type, 'search_default_type_expense_direct_cost': not parent.x_user_is_ho and 'in_' in parent.move_type, 'search_default_account_type': not parent.x_user_is_ho and ('out_' in parent.move_type and 'income'), 'preferred_account_type': not parent.x_user_is_ho and ('out_' in parent.move_type and 'income' or 'in_' in parent.move_type and 'expense')}</attribute>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         1.  Journal Items tab on vendor bill / account.move
             Add site_operations.group_site_accountant alongside the standard
             account.group_account_readonly so site accountants can see the
             GL breakdown of their bills.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_move_form_journal_items_site_accountant" model="ir.ui.view">
        <field name="name">account.move.form.journal.items.site.accountant</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='aml_tab']" position="attributes">
                <attribute name="groups">account.group_account_readonly,site_operations.group_site_accountant</attribute>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         2.  account.account form: x_site_ids field + hide Balance for sites
             - Balance stat button is hidden from site accountants (no balance
               figures should be visible to sites — they are confidential).
             - x_site_ids Many2many is shown to HO/admin so they can control
               which sites can see each account when creating/editing accounts.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_form_site_ops" model="ir.ui.view">
        <field name="name">account.account.form.site.ops</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">

            <!-- Hide the Balance stat button from site accountants -->
            <xpath expr="//button[@name='account.action_move_line_select']" position="attributes">
                <attribute name="groups">account.group_account_readonly</attribute>
            </xpath>

            <!-- Add Visible to Sites field inside the Accounting tab, below the existing groups -->
            <xpath expr="//page[@name='accounting']//group[last()]" position="after">
                <group string="Site Visibility" groups="account.group_account_manager">
                    <field name="x_site_ids"
                           widget="many2many_tags"
                           string="Visible to Sites"
                           options="{'no_create': True}"
                           placeholder="Leave empty = visible to all sites"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         3.  Dedicated Chart of Accounts action for site accountants.
             Uses a dynamic domain so only accounts tagged with the user's
             analytic account (project) are shown.  Bill lines / payments
             can still read any account without an access error because no
             global ir.rule restricts account.account reads.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="action_coa_site_accountant" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">account.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('x_site_ids', '=', False), ('x_site_ids', 'in', [user.x_default_analytic_account_id.id])]</field>
        <field name="context">{'default_x_site_ids': []}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No accounts visible to your site yet.
            </p>
            <p>Accounts with no site restriction are visible to all sites. Ask Head Office to check Configuration → Chart of Accounts.</p>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         4.  Chart of Accounts list: show x_site_ids as optional column
             (HO can see / edit which sites each account is assigned to).
             Column is hidden by default to keep the list clean.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_list_site_ops" model="ir.ui.view">
        <field name="name">account.account.list.site.ops</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_site_ids"
                       widget="many2many_tags"
                       string="Visible to Sites"
                       optional="hide"
                       groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         5.  Journal form: x_site_ids field so HO/admin can assign which
             sites are allowed to select each journal in petty cash expenses.
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_account_journal_form_site_ops" model="ir.ui.view">
        <field name="name">account.journal.form.site.ops</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']" position="before">
                <page string="Site Visibility" groups="account.group_account_manager,site_operations.group_finance_ho">
                    <group>
                        <field name="x_site_ids"
                               widget="many2many_tags"
                               string="Visible to Sites"
                               options="{'no_create': True}"
                               placeholder="Leave empty = visible to all sites"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
