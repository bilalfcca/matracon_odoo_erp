<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Direct Print — List-view Action menu entries
        ============================================
        Each server action below appears in the "Action" dropdown when one or
        more records are selected in the respective list view.  Clicking it
        opens a new browser tab that renders the QWeb report as HTML and
        immediately triggers the browser's print dialog.

        PDF download is already available via the standard "Print" (🖨) toolbar
        button that Odoo renders for every ir.actions.report bound to the model.
    -->

    <!-- ── Bank Guarantee ─────────────────────────────────────────────────── -->
    <record id="server_action_direct_print_bg" model="ir.actions.server">
        <field name="name">Print Bank Guarantee</field>
        <field name="model_id" ref="model_x_bank_guarantee"/>
        <field name="binding_model_id" ref="model_x_bank_guarantee"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
ids = ','.join(str(i) for i in records.ids)
action = {
    'type': 'ir.actions.act_url',
    'url': '/site_operations/print/x.bank.guarantee/' + ids,
    'target': 'new',
}
        </field>
    </record>

