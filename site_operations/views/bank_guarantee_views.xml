<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         Bank Guarantee Facility
    ════════════════════════════════════════════════════════════════════════ -->

    <record id="view_bank_guarantee_facility_tree" model="ir.ui.view">
        <field name="name">x.bank.guarantee.facility.list</field>
        <field name="model">x.bank.guarantee.facility</field>
        <field name="arch" type="xml">
            <list string="Bank Facility Limits">
                <header>
                    <button name="action_open_import_wizard"
                            type="object"
                            string="Import Facilities"
                            icon="fa-upload"
                            display="always"
                            class="btn-secondary"/>
                </header>
                <!-- Always visible: core identifiers -->
                <field name="journal_id" string="Bank / Journal"/>
                <field name="reference_no" string="Reference No" optional="show"/>
                <!-- Limits & utilization -->
                <field name="total_limit" string="Sanctioned Limit" sum="Total Limit" optional="show"/>
                <field name="utilized_amount" string="Utilized" sum="Utilized" optional="show"/>
                <field name="available_limit" string="Available" sum="Available" optional="show"/>
                <field name="guarantee_count" string="BG Count" optional="show"/>
                <!-- Dates -->
                <field name="date_of_issuance" string="Date of Issuance" optional="show"/>
                <field name="expiry_date" string="Expiry" optional="show"/>
                <!-- Charges -->
                <field name="cash_margin_percent" string="Cash Margin %" optional="show"/>
                <field name="commission_percent" string="Commission %" optional="show"/>
                <!-- Hidden by default -->
                <field name="name" string="Facility Name" optional="hide"/>
                <field name="active" string="Active" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_bank_guarantee_facility_form" model="ir.ui.view">
        <field name="name">x.bank.guarantee.facility.form</field>
        <field name="model">x.bank.guarantee.facility</field>
        <field name="arch" type="xml">
            <form string="Bank Facility Limit">
                <header>
                    <button name="action_renew_facility" type="object"
                            string="Renew Facility"
                            class="btn-primary"
                            confirm="This will archive the current sanction letter details into Renewal History and clear the header fields so you can enter the new letter. Continue?"
                            help="Archives the current letter details and clears the header so you can fill in the renewed facility details."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_guarantees" type="object"
                                class="oe_stat_button" icon="fa-university">
                            <field name="guarantee_count" widget="statinfo" string="Guarantees"/>
                        </button>
                    </div>
                    <group string="Current Facility Letter">
                        <group>
                            <field name="journal_id" string="Bank / Journal"/>
                            <field name="reference_no"/>
                            <field name="date_of_issuance"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="cash_margin_percent"/>
                            <field name="commission_percent"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Sanctioned Limit &amp; Utilization">
                        <group>
                            <field name="total_limit"/>
                            <field name="utilized_amount"/>
                        </group>
                        <group>
                            <field name="available_limit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Security Details" name="security">
                            <field name="security_details" nolabel="1"
                                   placeholder="Enter details of collateral, security deposits, or any pledged assets against this facility…"/>
                        </page>
                        <page string="Cash Margin Slabs" name="margin_slabs">
                            <div class="alert alert-info mb-2" role="alert">
                                <i class="fa fa-info-circle"/>
                                Define tiered cash margin rates for this facility.
                                These slabs are <strong>auto-copied</strong> to every Bank Guarantee issued under this facility.
                                If no slabs are added, the <strong>Cash Margin (%)</strong> field above is used as a flat rate.
                                Set <em>Up To Amount</em> = <strong>0</strong> for the last (unlimited) tier.
                            </div>
                            <field name="cash_margin_slab_ids">
                                <list editable="bottom" string="Cash Margin Slabs (Template)">
                                    <field name="from_amount" string="From Amount"/>
                                    <field name="to_amount" string="Up To (0 = unlimited)"/>
                                    <field name="margin_percent" string="Cash Margin %"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Renewal History" name="renewals">
                            <field name="renewal_ids">
                                <list editable="bottom" string="Previous Facility Letters">
                                    <field name="reference_no" string="Reference No"/>
                                    <field name="date_of_issuance" string="Issuance Date"/>
                                    <field name="expiry_date" string="Expiry Date"/>
                                    <field name="total_limit" string="Sanctioned Limit" sum="Total"/>
                                    <field name="cash_margin_percent" string="Cash Margin %"/>
                                    <field name="commission_percent" string="Commission %"/>
                                    <field name="notes" string="Notes"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bank_guarantee_facility" model="ir.actions.act_window">
        <field name="name">Bank Facility Limits</field>
        <field name="res_model">x.bank.guarantee.facility</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         Bank Guarantee Registry
    ════════════════════════════════════════════════════════════════════════ -->

    <record id="view_bank_guarantee_tree" model="ir.ui.view">
        <field name="name">x.bank.guarantee.list</field>
        <field name="model">x.bank.guarantee</field>
        <field name="arch" type="xml">
            <list string="Bank Guarantees Registry"
                  import="0"
                  decoration-danger="is_expiring_soon"
                  decoration-muted="state in ('released', 'expired', 'cancelled')">
                <header>
                    <button name="action_open_import_wizard" type="object"
                            string="Import BGs"
                            icon="fa-upload"
                            display="always"
                            class="btn-secondary"/>
                </header>

                <!-- ── Always visible: core identifiers ── -->
                <field name="sr_no" string="Sr No"/>
                <field name="guarantee_number" string="Guarantee No"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'released'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'expired'"/>

                <!-- ── Default visible (optional="show") — user can hide ── -->
                <field name="name" string="Reference" optional="show"/>
                <field name="journal_id" string="Bank" optional="show"/>
                <field name="nature_id" string="Nature" optional="show"/>
                <field name="project_id" string="Project" optional="show"/>
                <field name="beneficiary_name" string="Beneficiary" optional="show"/>
                <field name="issue_date" string="Issue Date" optional="show"/>
                <field name="expiry_date" string="Expiry Date" optional="show"/>
                <field name="bg_amount" string="BG Amount" sum="BG Amount" optional="show"/>
                <field name="cash_margin_percent" string="Cash Margin %" optional="show"/>
                <field name="margin_amount" string="Cash Margin Amt" sum="Total Cash Margin" optional="show"/>
                <field name="jv_type" string="Bidder" optional="show"/>
                <field name="amendment_count" string="Amendments" optional="show"/>

                <!-- ── Hidden by default (optional="hide") — available in picker ── -->
                <field name="facility_id" string="Bank Facility" optional="hide"/>
                <field name="beneficiary_id" string="Beneficiary (Partner)" optional="hide"/>
                <field name="jv_name" string="JV Name" optional="hide"/>
                <field name="pricing_percent" string="Commission %" optional="hide"/>
                <field name="commission_amount" string="Commission Amt" optional="hide"/>
                <field name="fed_percent" string="FED %" optional="hide"/>
                <field name="fed_amount" string="FED Amount" optional="hide"/>
                <field name="total_limit" string="Facility Limit" sum="Total Limit" optional="hide"/>
                <field name="utilized_amount" string="Utilized" sum="Utilized" optional="hide"/>
                <field name="available_limit" string="Available" sum="Available" optional="hide"/>
                <field name="days_to_expiry" string="Days to Expiry" optional="hide"/>
                <field name="release_date" string="Release Date" optional="hide"/>
                <field name="release_notes" string="Release Notes" optional="hide"/>
                <field name="validated" string="Validated" optional="hide"/>
                <field name="validated_by_id" string="Validated By" optional="hide"/>
                <field name="validated_date" string="Validated On" optional="hide"/>

                <!-- ── Project detail columns (for export) ── -->
                <field name="x_proj_start_date" string="Project Start" optional="hide"/>
                <field name="x_proj_original_deadline" string="Original Deadline" optional="hide"/>
                <field name="x_proj_current_deadline" string="Current Deadline" optional="hide"/>
                <field name="x_proj_contract_value" string="Contract Value" optional="hide"/>
                <field name="x_proj_billed_to_client" string="Billed to Client" optional="hide"/>
                <field name="x_proj_remaining_to_bill" string="Remaining to Bill" optional="hide"/>
                <field name="x_proj_work_completion_pct" string="Work Completion %" optional="hide"/>
                <field name="x_proj_financial_completion_pct" string="Financial Completion %" optional="hide"/>
                <field name="x_proj_analytic_account" string="Analytic Account" optional="hide"/>

                <!-- ── Internal flags (decoration only, never shown as columns) ── -->
                <field name="is_expiring_soon" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_bank_guarantee_form" model="ir.ui.view">
        <field name="name">x.bank.guarantee.form</field>
        <field name="model">x.bank.guarantee</field>
        <field name="arch" type="xml">
            <form string="Bank Guarantee">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Validate / Activate"
                            class="btn-success" invisible="state != 'pending'"/>
                    <button name="action_lock" type="object" string="Lock"
                            class="btn-secondary" invisible="state != 'active'"/>
                    <button name="action_request_release" type="object" string="Request Release"
                            invisible="state not in ('active', 'locked')"/>
                    <button name="action_release" type="object" string="Mark Released"
                            class="btn-primary" invisible="state not in ('active', 'locked', 'expired')"/>
                    <button name="action_amend" type="object" string="Amend"
                            invisible="state not in ('active', 'locked')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            confirm="This will reset the bank guarantee back to Draft so it can be edited or deleted. Continue?"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending,active,locked,released"/>
                    <button name="action_delete_draft" type="object"
                            string="Delete" class="btn-danger"
                            invisible="state != 'draft'"
                            confirm="This bank guarantee will be permanently deleted. Are you sure?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Validated" bg_color="text-bg-success"
                            invisible="not validated"/>
                    <widget name="web_ribbon" title="Expiring Soon" bg_color="text-bg-warning"
                            invisible="not is_expiring_soon"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Guarantee Details">
                            <field name="sr_no" readonly="1"/>
                            <field name="journal_id" string="Bank"/>
                            <field name="facility_id" readonly="1"/>
                            <field name="nature_id"/>
                            <field name="guarantee_number"/>
                            <field name="jv_type" widget="radio" string="Bidder"/>
                            <field name="jv_name" invisible="jv_type != 'jv'" required="jv_type == 'jv'"/>
                            <field name="project_id"/>
                            <field name="beneficiary_id"/>
                            <field name="beneficiary_name"/>
                        </group>
                        <group string="Dates &amp; Amount">
                            <field name="issue_date"/>
                            <field name="expiry_date" decoration-danger="is_expiring_soon"/>
                            <field name="bg_amount"/>
                            <field name="cash_margin_percent" string="Cash Margin (%)"
                                   invisible="cash_margin_slab_ids"
                                   help="Flat rate used when no Cash Margin Slabs are defined. Add slabs in the tab below for tiered rates."/>
                            <field name="margin_amount" string="Cash Margin Amount" readonly="1"/>
                            <field name="pricing_percent" string="Bank Commission/Pricing (%)"/>
                            <field name="commission_amount" string="Commission Amount" readonly="1"/>
                            <field name="fed_percent" string="FED (%)"/>
                            <field name="fed_amount" string="FED Amount" readonly="1"/>
                            <field name="days_to_expiry" invisible="state not in ('active', 'locked', 'pending')"/>
                            <field name="release_date" invisible="state != 'released'"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Bank Facility Utilization">
                        <group>
                            <field name="total_limit"/>
                            <field name="utilized_amount"/>
                        </group>
                        <group>
                            <field name="available_limit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Amendment History" name="amendments">
                            <field name="amendment_ids">
                                <list editable="bottom">
                                    <field name="amendment_no" string="No." readonly="1" width="48px"/>
                                    <field name="amendment_date"/>
                                    <field name="amendment_type"/>
                                    <field name="description"/>
                                    <field name="amount_change" sum="Total Change"/>
                                    <field name="new_expiry_date"/>
                                    <field name="attachment_ids" widget="many2many_binary" string="Docs"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cash Margin Slabs" name="margin_slabs">
                            <div class="alert alert-info mb-2" role="alert">
                                <i class="fa fa-info-circle"/>
                                Add tiered cash margin slabs for this BG.
                                The <strong>Cash Margin Amount</strong> above is computed as the sum of all slab margins.
                                Set <em>Up To Amount</em> = <strong>0</strong> for the last (unlimited) tier.
                                Leave this tab empty to use the flat <strong>Cash Margin (%)</strong> field instead.
                            </div>
                            <field name="cash_margin_slab_ids">
                                <list editable="bottom" string="Cash Margin Slabs">
                                    <field name="from_amount" string="From Amount"/>
                                    <field name="to_amount" string="Up To (0 = unlimited)"/>
                                    <field name="margin_percent" string="Cash Margin %"/>
                                    <field name="applicable_amount" string="Applicable Amount" readonly="1"/>
                                    <field name="slab_amount" string="Margin Amount" readonly="1" sum="Total Cash Margin"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Internal finance notes..."/>
                            <group invisible="not validated">
                                <field name="validated_by_id"/>
                                <field name="validated_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bank_guarantee_search" model="ir.ui.view">
        <field name="name">x.bank.guarantee.search</field>
        <field name="model">x.bank.guarantee</field>
        <field name="arch" type="xml">
            <search string="Bank Guarantees">
                <field name="name"/>
                <field name="guarantee_number"/>
                <field name="journal_id" string="Bank"/>
                <field name="project_id"/>
                <field name="beneficiary_name"/>
                <field name="jv_name"/>
                <filter string="Active" name="filter_active" domain="[('state', '=', 'active')]"/>
                <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Expiring Soon" name="filter_expiring"
                        domain="[('is_expiring_soon', '=', True)]"/>
                <filter string="Released" name="filter_released" domain="[('state', '=', 'released')]"/>
                <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter string="Performance Security" name="filter_performance"
                        domain="[('nature_id.code', '=', 'performance')]"/>
                <filter string="Bid Security" name="filter_bid"
                        domain="[('nature_id.code', '=', 'bid_security')]"/>
                <filter string="Mob Advance Security" name="filter_mob"
                        domain="[('nature_id.code', '=', 'mob_advance')]"/>
                <separator/>
                <filter string="Group by Bank" name="group_bank" context="{'group_by': 'journal_id'}"/>
                <filter string="Group by Project" name="group_project" context="{'group_by': 'project_id'}"/>
                <filter string="Group by Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Group by Nature" name="group_nature" context="{'group_by': 'nature_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_bank_guarantee" model="ir.actions.act_window">
        <field name="name">Bank Guarantees</field>
        <field name="res_model">x.bank.guarantee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_guarantee_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a new bank guarantee</p>
            <p>Track performance bonds, bid bonds, and advance payment guarantees with bank facility limits.</p>
        </field>
    </record>

    <!-- ── BG Expiry Notification Configuration ──────────────────────────── -->
    <record id="view_bg_expiry_config_form" model="ir.ui.view">
        <field name="name">x.bg.expiry.config.form</field>
        <field name="model">x.bg.expiry.config</field>
        <field name="arch" type="xml">
            <form string="BG Expiry Notification Settings" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h2>BG Expiry Notification Settings</h2>
                        <p class="text-muted">
                            Finance HO, CEO and Admin users are <strong>always</strong>
                            notified. Add extra recipients below for external contacts
                            (e.g. CFO, auditors) who are not Odoo users.
                        </p>
                    </div>
                    <group string="Additional Odoo Recipients">
                        <field name="recipient_partner_ids" nolabel="1" colspan="2"
                               widget="many2many_tags"
                               placeholder="Search contacts to add…"/>
                    </group>
                    <group string="Extra Email Addresses (non-Odoo users)">
                        <field name="extra_emails" nolabel="1" colspan="2"
                               placeholder="cfo@example.com&#10;auditor@example.com&#10;(one email per line)"/>
                    </group>
                    <div class="alert alert-info mt-2">
                        <i class="fa fa-info-circle"/> Emails are sent automatically:
                        <ul class="mb-0 mt-1">
                            <li>Daily cron when a BG enters the <strong>10-day expiry window</strong> (once per BG)</li>
                            <li>On the <strong>actual expiry date</strong> when the BG is marked Expired</li>
                            <li>Alert is reset automatically when the expiry date is extended via Amendment</li>
                        </ul>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bg_expiry_config" model="ir.actions.act_window">
        <field name="name">BG Expiry Notification Settings</field>
        <field name="res_model">x.bg.expiry.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- ── Nature of BG configuration ─────────────────────────────────────── -->
    <record id="view_bg_nature_list" model="ir.ui.view">
        <field name="name">x.bg.nature.list</field>
        <field name="model">x.bg.nature</field>
        <field name="arch" type="xml">
            <list string="Nature of BG" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="guarantee_count" string="BGs" readonly="1"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_bg_nature_form" model="ir.ui.view">
        <field name="name">x.bg.nature.form</field>
        <field name="model">x.bg.nature</field>
        <field name="arch" type="xml">
            <form string="Nature of BG">
                <sheet>
                    <group>
                        <field name="name" string="Nature"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bg_nature" model="ir.actions.act_window">
        <field name="name">Nature of BG</field>
        <field name="res_model">x.bg.nature</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Nature of BG type
            </p>
            <p>Define the types that appear in the Nature dropdown on Bank Guarantees.</p>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         BG Amendments — Standalone List (for browse / export)
    ════════════════════════════════════════════════════════════════════ -->

    <record id="view_bank_guarantee_amendment_list" model="ir.ui.view">
        <field name="name">x.bank.guarantee.amendment.list</field>
        <field name="model">x.bank.guarantee.amendment</field>
        <field name="arch" type="xml">
            <list string="BG Amendments" create="0" delete="0">
                <header>
                    <button name="action_open_import_wizard"
                            type="object"
                            string="Import Amendments"
                            icon="fa-upload"
                            display="always"
                            class="btn-secondary"/>
                </header>
                <!-- Always visible: identifiers -->
                <field name="guarantee_id" string="Bank Guarantee"/>
                <field name="amendment_no" string="No." width="48px"/>
                <field name="amendment_date" string="Date"/>
                <field name="amendment_type" string="Type"/>

                <!-- Default visible -->
                <field name="bg_guarantee_number" string="Guarantee No" optional="show"/>
                <field name="bg_journal_id" string="Bank" optional="show"/>
                <field name="bg_project_id" string="Project" optional="show"/>
                <field name="bg_beneficiary_name" string="Beneficiary" optional="show"/>
                <field name="bg_state" string="BG Status" widget="badge"
                       decoration-success="bg_state == 'active'"
                       decoration-info="bg_state == 'released'"
                       decoration-warning="bg_state == 'pending'"
                       decoration-danger="bg_state == 'expired'"
                       optional="show"/>
                <field name="description" string="Description" optional="show"/>
                <field name="amount_change" string="Amount Change" sum="Net Change" optional="show"/>
                <field name="new_expiry_date" string="New Expiry Date" optional="show"/>

                <!-- Hidden by default -->
                <field name="bg_amount" string="BG Amount" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_bank_guarantee_amendment_search" model="ir.ui.view">
        <field name="name">x.bank.guarantee.amendment.search</field>
        <field name="model">x.bank.guarantee.amendment</field>
        <field name="arch" type="xml">
            <search string="BG Amendments">
                <field name="guarantee_id" string="Bank Guarantee"/>
                <field name="bg_guarantee_number" string="Guarantee No"/>
                <field name="bg_journal_id" string="Bank"/>
                <field name="bg_project_id" string="Project"/>
                <field name="description"/>
                <filter string="Extension" name="filter_extension"
                        domain="[('amendment_type', '=', 'extension')]"/>
                <filter string="Increase" name="filter_increase"
                        domain="[('amendment_type', '=', 'increase')]"/>
                <filter string="Decrease" name="filter_decrease"
                        domain="[('amendment_type', '=', 'decrease')]"/>
                <filter string="Release" name="filter_release"
                        domain="[('amendment_type', '=', 'release')]"/>
                <separator/>
                <filter string="Group by BG" name="group_bg"
                        context="{'group_by': 'guarantee_id'}"/>
                <filter string="Group by Bank" name="group_bank"
                        context="{'group_by': 'bg_journal_id'}"/>
                <filter string="Group by Project" name="group_project"
                        context="{'group_by': 'bg_project_id'}"/>
                <filter string="Group by Type" name="group_type"
                        context="{'group_by': 'amendment_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_bank_guarantee_amendment" model="ir.actions.act_window">
        <field name="name">BG Amendments</field>
        <field name="res_model">x.bank.guarantee.amendment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_guarantee_amendment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No amendments recorded yet</p>
            <p>Amendments are added from individual Bank Guarantee records.</p>
        </field>
    </record>

    <record id="view_bank_guarantee_amendment_form" model="ir.ui.view">
        <field name="name">x.bank.guarantee.amendment.form</field>
        <field name="model">x.bank.guarantee.amendment</field>
        <field name="arch" type="xml">
            <form string="Amendment">
                <group>
                    <field name="guarantee_id" readonly="1"/>
                    <field name="amendment_no" readonly="1" string="Amendment No."/>
                    <field name="amendment_date"/>
                    <field name="amendment_type"/>
                    <field name="description"/>
                    <field name="amount_change"/>
                    <field name="new_expiry_date"/>
                </group>
                <group string="Supporting Documents">
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"
                           colspan="2"
                           placeholder="Attach bank letters, extension notices, or other supporting documents..."/>
                </group>
                <footer>
                    <button name="action_apply_extension" type="object" string="Apply Extension"
                            class="btn-primary" invisible="not new_expiry_date"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
