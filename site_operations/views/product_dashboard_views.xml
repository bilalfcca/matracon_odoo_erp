<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inventory Dashboard flags on Product and Category forms.
        x_add_to_dashboard controls what appears on the HO Inventory Dashboard.
        x_show_zero_qty keeps the product visible on the dashboard even when
        its on-hand quantity is zero.
    -->

    <!-- ── product.template: inject both checkboxes below "Quantity On Hand" ── -->
    <record id="view_product_template_dashboard_flag" model="ir.ui.view">
        <field name="name">product.template.inventory.dashboard.flag</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--
                The qty_available row sits inside a div.o_row injected by the stock
                addon (after field[@name='show_qty_update_button']).  We target the
                wrapping div to place our checkboxes immediately after it.
                Both flags are visible for ALL products regardless of quantity.
            -->
            <xpath expr="//div[hasclass('o_row')][.//field[@name='qty_available']]"
                   position="after">
                <field name="x_add_to_dashboard"
                       groups="purchase_demand_raise.group_head_office,
                               purchase_demand_raise.group_procurement_ho,
                               site_operations.group_finance_ho,
                               purchase_demand_raise.group_matracon_admin"/>
                <field name="x_show_zero_qty"
                       invisible="not x_add_to_dashboard"
                       groups="purchase_demand_raise.group_head_office,
                               purchase_demand_raise.group_procurement_ho,
                               site_operations.group_finance_ho,
                               purchase_demand_raise.group_matracon_admin"/>
            </xpath>
        </field>
    </record>

    <!-- ── product.category: add checkbox at top of form ── -->
    <record id="view_product_category_dashboard_flag" model="ir.ui.view">
        <field name="name">product.category.inventory.dashboard.flag</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_add_to_dashboard"
                       groups="purchase_demand_raise.group_head_office,
                               purchase_demand_raise.group_procurement_ho,
                               site_operations.group_finance_ho,
                               purchase_demand_raise.group_matracon_admin"/>
            </xpath>
        </field>
    </record>

</odoo>
