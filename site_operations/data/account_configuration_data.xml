<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Accounts below are linked to existing records by the pre-migrate
        script (see migrations/19.0.2.1.0/pre-migrate.py) BEFORE this file
        loads, so these <record> tags perform a safe UPDATE, never a
        colliding CREATE — avoids duplicate-code crashes on databases
        restored from production (e.g. after a CoA reformat).
    -->

    <record id="account_wht_payable" model="account.account">
        <field name="code">252100</field>
        <field name="name">WHT Payable</field>
        <field name="account_type">liability_current</field>
    </record>

    <record id="account_retention_payable" model="account.account">
        <field name="code">211200</field>
        <field name="name">Retention Payable</field>
        <field name="account_type">liability_payable</field>
    </record>

    <!-- ── Liability Sheet Sequence ─────────────────────────────────────── -->
    <record id="seq_liability_sheet" model="ir.sequence">
        <field name="name">Liability Sheet</field>
        <field name="code">x.liability.sheet</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ── Gate Pass Outward Sequence ───────────────────────────────────── -->
    <record id="seq_gate_pass_outward" model="ir.sequence">
        <field name="name">Gate Pass Outward</field>
        <field name="code">x.gate.pass.outward</field>
        <field name="prefix">GP/OUT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
