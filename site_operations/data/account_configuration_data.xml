<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No pre-created accounts required.
        Journals and accounts for Backcharge and Inter-Project Transfers
        are created on-demand by the _get_or_create_* methods in
        models/stock_picking.py when the first relevant transfer is validated.

        WHT Payable and Retention Payable accounts are ensured safely via
        ensure_deduction_accounts() in hooks.py (post_init_hook), which
        searches by code first before creating — avoids duplicate-code
        crashes on databases restored from production (e.g. after a CoA
        reformat where these accounts already exist under a different ID).
    -->

    <!-- ── Liability Sheet Sequence ─────────────────────────────────────── -->
    <record id="seq_liability_sheet" model="ir.sequence">
        <field name="name">Liability Sheet</field>
        <field name="code">x.liability.sheet</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ── Gate Pass Outward Sequence ───────────────────────────────────── -->
    <record id="seq_gate_pass_outward" model="ir.sequence">
        <field name="name">Gate Pass Outward</field>
        <field name="code">x.gate.pass.outward</field>
        <field name="prefix">GP/OUT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
