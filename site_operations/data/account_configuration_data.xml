<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WHT / Retention Payable are chosen on the Company form (Matracon
         Accounts tab) — not created or renumbered by this module. This hands
         the old site_operations.account_* records over to those fields and
         drops their xmlids so upgrades never touch the accounts again. -->
    <function model="res.company" name="_matracon_adopt_deduction_accounts"/>

    <!-- ── Liability Sheet Sequence ─────────────────────────────────────── -->
    <record id="seq_liability_sheet" model="ir.sequence">
        <field name="name">Liability Sheet</field>
        <field name="code">x.liability.sheet</field>
        <field name="prefix"></field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ── Gate Pass Outward Sequence ───────────────────────────────────── -->
    <record id="seq_gate_pass_outward" model="ir.sequence">
        <field name="name">Gate Pass Outward</field>
        <field name="code">x.gate.pass.outward</field>
        <field name="prefix">GP/OUT/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
