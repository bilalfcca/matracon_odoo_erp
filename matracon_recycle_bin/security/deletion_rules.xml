<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Users see only their own deletion requests; Admins see all. -->
    <record id="rule_deletion_request_own" model="ir.rule">
        <field name="name">Deletion Request: own requests</field>
        <field name="model_id" ref="model_x_deletion_request"/>
        <field name="domain_force">[('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_deletion_request_admin" model="ir.rule">
        <field name="name">Deletion Request: Admins see all</field>
        <field name="model_id" ref="model_x_deletion_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase_demand_raise.group_matracon_admin')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
