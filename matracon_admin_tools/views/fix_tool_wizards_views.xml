<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fix Petty Cash GL Entry -->
    <record id="view_petty_cash_gl_fix_wizard_form" model="ir.ui.view">
        <field name="name">x.petty.cash.gl.fix.wizard.form</field>
        <field name="model">x.petty.cash.gl.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Petty Cash GL Entry">
                <div class="alert alert-info" role="alert">
                    Corrects a released Petty Cash Request whose journal entry debited
                    the wrong GL account instead of the site's Cash-in-Hand account.
                    Creates a correcting journal entry - the original entry is not
                    reversed.
                </div>
                <group>
                    <field name="petty_cash_request_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Run" type="object"
                            class="btn-primary"
                            confirm="This will create a correcting journal entry to move the released amount to the site's Petty Cash (Cash in Hand) account. Proceed?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Shared Site Configuration fix picker (fix_type set via context per Server Action) -->
    <record id="view_site_config_fix_wizard_form" model="ir.ui.view">
        <field name="name">x.site.config.fix.wizard.form</field>
        <field name="model">x.site.config.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Fix Site Configuration Data">
                <field name="fix_type" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    <field name="fix_type_help" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="site_config_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Run" type="object"
                            class="btn-primary"
                            confirm="This will apply the fix described above. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Fix Fleet Service Log GL Link -->
    <record id="view_fleet_gl_fix_wizard_form" model="ir.ui.view">
        <field name="name">x.fleet.gl.fix.wizard.form</field>
        <field name="model">x.fleet.gl.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Unlink GL">
                <div class="alert alert-info" role="alert">
                    Detaches the journal entry link on a fleet service log entry so it
                    can be corrected. The journal entry itself is NOT reversed.
                </div>
                <group>
                    <field name="log_entry_id"/>
                </group>
                <footer>
                    <button name="action_apply" string="Run" type="object"
                            class="btn-primary"
                            confirm="This will detach the GL journal entry link (the JE itself is NOT reversed). Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Site Opening Balance Import — Discovery Report & Valuation Import -->
    <record id="view_site_opening_balance_discovery_wizard_form" model="ir.ui.view">
        <field name="name">x.site.opening.balance.discovery.wizard.form</field>
        <field name="model">x.site.opening.balance.discovery.wizard</field>
        <field name="arch" type="xml">
            <form string="Site Opening Balance — Discovery &amp; Valuation Import">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state == 'imported'">
                    <b>Step 1 (Discovery):</b> Upload the site's inventory sheet (.xlsx / .xls) and click <b>Run Discovery Report</b> to validate product matches, current on-hand quantities, and valuation totals.<br/>
                    <b>Step 2 (Import):</b> Click <b>Import Inventory Valuation</b> to record the opening valuation as of 30 June into stock valuation layers and update product unit costs, without re-importing or altering on-hand quantities.
                </div>
                <div class="alert alert-success" role="alert" invisible="state != 'imported'">
                    Opening inventory valuation has been successfully imported as of 30 June. Physical on-hand quantities in stock.quant were left completely untouched.
                </div>
                <group invisible="result_summary">
                    <group string="Site &amp; Workbook">
                        <field name="site_config_id"/>
                        <field name="summary_file" filename="summary_filename"/>
                        <field name="summary_filename" invisible="1"/>
                        <field name="as_of_date"/>
                        <field name="receipts_since_date"/>
                    </group>
                    <group string="Valuation &amp; Import Options">
                        <field name="target_account_code"/>
                        <field name="value_tolerance"/>
                        <field name="import_mode"/>
                        <field name="update_product_cost"/>
                        <field name="create_gl_entry"/>
                        <field name="offset_account_id" invisible="not create_gl_entry" required="create_gl_entry"/>
                        <field name="stock_journal_id" invisible="not create_gl_entry" required="create_gl_entry"/>
                        <field name="overwrite_existing"/>
                    </group>
                </group>
                <group string="Result" invisible="not result_summary">
                    <field name="result_summary" readonly="1" nolabel="1"
                           widget="text" class="o_field_text"/>
                    <field name="report_file" filename="report_filename" readonly="1"
                           string="Download Detail Report (CSV)"/>
                    <field name="report_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_direct_import_all_projects" string="Direct Import All 3 Sites (MCH, STP, RWASA)"
                            type="object" class="btn-primary"
                            invisible="state == 'imported'"
                            confirm="This will directly import the 30 June opening inventory valuations for all 3 sites (MCH - BAHAWALNAGAR, STP - MARDAN, RWASA) using bundled verified datasets, updating product unit costs and move valuations without altering physical on-hand stock quantities. Proceed?"/>
                    <button name="action_import_valuation" string="Import Valuation (Current File)"
                            type="object" class="btn-secondary"
                            invisible="state == 'imported'"
                            confirm="This will record opening inventory valuation as of 30 June and update product costs for the selected site/file without re-importing or changing on-hand stock quantities. Proceed?"/>
                    <button name="action_run_discovery" string="Run Discovery Report"
                            type="object" class="btn-secondary"
                            invisible="state == 'imported'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Force Fix PO Price & Inventory Valuation Wizard -->
    <record id="view_po_price_fix_wizard_form" model="ir.ui.view">
        <field name="name">x.po.price.fix.wizard.form</field>
        <field name="model">x.po.price.fix.wizard</field>
        <field name="arch" type="xml">
            <form string="Force Fix PO Price &amp; Inventory Valuation">
                <div class="alert alert-warning" role="alert">
                    <b>Force Price &amp; Inventory Valuation Correction:</b><br/>
                    Updates the unit price and total amount on locked/confirmed Purchase Orders in-place without requiring receipt reversal or cancellation. Also synchronizes all linked inventory receipts (stock moves, valuation layers, and GL entries) so inventory reporting reflects the corrected unit cost.
                </div>
                <group>
                    <group string="Purchase Order Details">
                        <field name="purchase_order_id"/>
                        <field name="product_id"/>
                        <field name="current_unit_price"/>
                    </group>
                    <group string="Correction Settings">
                        <field name="new_unit_price"/>
                        <field name="update_inventory"/>
                        <field name="update_journal_entries"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" string="Force Apply Price &amp; Update Inventory"
                            type="object" class="btn-primary"
                            confirm="This will update the unit price and total on the selected Purchase Order and synchronize all linked inventory receipts and valuation. Proceed?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Bank Guarantee Accounting Repair Wizard -->
    <record id="view_bg_accounting_repair_wizard_form" model="ir.ui.view">
        <field name="name">x.bg.accounting.repair.wizard.form</field>
        <field name="model">x.bg.accounting.repair.wizard</field>
        <field name="arch" type="xml">
            <form string="Repair Bank Guarantee Accounting Entries">
                <div class="alert alert-info" role="alert">
                    <strong>Bank Guarantee Accounting Audit &amp; Repair Tool</strong><br/>
                    Audits all active, locked, and released Bank Guarantees to ensure their
                    Cash Margin entries are properly reflected in the Chart of Accounts under
                    the configured Bank and Cash Margin accounts.
                    <ul class="mb-0 mt-1">
                        <li><strong>Active / Locked:</strong> Posts Dr Cash Margin, Cr Bank Operational Account.</li>
                        <li><strong>Released:</strong> Posts Dr Bank Operational Account, Cr Cash Margin.</li>
                        <li><strong>Duplicate Detection:</strong> Detects and links existing entries without creating duplicates.</li>
                    </ul>
                </div>
                <group>
                    <group string="Audit Scan Counts">
                        <field name="total_scanned"/>
                        <field name="total_created"/>
                        <field name="total_repaired"/>
                    </group>
                    <group string="Exceptions &amp; Status">
                        <field name="total_skipped"/>
                        <field name="total_failed"/>
                    </group>
                </group>
                <notebook>
                    <page string="Audit Report &amp; Records Breakdown" name="report">
                        <field name="audit_report_html" widget="html" readonly="1" nolabel="1"/>
                    </page>
                </notebook>
                <footer>
                    <button name="action_preview" string="Re-run Audit (Preview)" type="object"
                            class="btn-secondary"/>
                    <button name="action_apply_repair" string="Execute Repair (Live)" type="object"
                            class="btn-primary"
                            confirm="This will create and post missing Cash Margin journal entries for eligible guarantees. Continue?"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

