        <field name="group_ids" eval="[Command.set([
            ref('purchase_demand_raise.group_matracon_admin'),
            ref('base.group_system'),
            ref('site_operations.group_finance_ho'),
        ])]"/>
        <field name="sequence">26</field>
    </record>

